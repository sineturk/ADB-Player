# ADB Player local developer credentials.
# Copy this file to .env.local and fill only the services you use.
# .env.local is ignored by Git and MUST NOT be committed.

# Telegram / TDLib
# Required for Telegram login in developer builds.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# AltyaziDB API
ALTYAZIDB_API_URL=https://altyazidb.com/api/v1
ALTYAZIDB_API_KEY=

# Optional cloud OAuth credentials.
# Legacy names GOOGLE_SERVER_CLIENT_ID and DROPBOX_APP_KEY are also accepted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=


# ADB Cloud / Neon Managed Better Auth
# Public branch-scoped Auth base URL, e.g. https://ep-...neonauth....aws.neon.tech/neondb/auth
ADB_CLOUD_AUTH_URL=

# ADB Cloud v0.2 authenticated Function API
# Public invocation URL from: neon functions get adbcloudapi
ADB_CLOUD_API_URL=
