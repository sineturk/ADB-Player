              Foreground="{StaticResource BrandBrush}"
              FontSize="20" FontWeight="SemiBold"
              Content="‹"
              ToolTip="{DynamicResource Player.MediaCenter.Toggle}"
              Click="MediaCenterEdgeToggleButton_OnClick"/>

