                                <Border Width="36" Height="36" CornerRadius="10" Background="#173A55" VerticalAlignment="Top"><TextBlock Text="⌂" Foreground="{StaticResource BrandBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="7,1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,3,0,0" Text="{Binding BaseUrl}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel Grid.Column="2"><Button Content="{DynamicResource Action.Open}" Style="{StaticResource ConnectionActionButtonStyle}" Click="WebDavProfileCard_OnClick"/><Button Content="{DynamicResource Action.Remove}" Style="{StaticResource ConnectionActionButtonStyle}" Click="WebDavProfileRemove_OnClick"/></StackPanel>
                              </Grid>
                            </Border>
