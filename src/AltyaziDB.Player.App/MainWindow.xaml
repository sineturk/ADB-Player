                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </Grid>
                        <Button Grid.Column="2" Margin="5,0,0,0" Padding="0" Content="›" FontSize="23" Style="{StaticResource ConnectionActionButtonStyle}" Click="ContinueWatchingNext_OnClick" ToolTip="{DynamicResource Home.ContinueWatching.Next}"/>
                      </Grid>
                    </Grid>
