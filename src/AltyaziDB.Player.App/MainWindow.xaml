                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Connections.List.Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{DynamicResource Connections.Action.New}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewConnectionCommand}"/>
                      </Grid>
                      <ListBox Grid.Row="1" Margin="0,8,0,6" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="2">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding StatusGlyph}" Margin="2,0,8,0" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7D8B81"/><Style.Triggers><DataTrigger Binding="{Binding LastTestSucceeded}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrandBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                              </TextBlock>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource BrandBrush}" FontSize="11.5"/>
                                <TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Grid.Row="2" Margin="2,2,2,7" Text="{Binding SelectedProfileStatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource Connections.Action.Toggle}" Command="{Binding ToggleConnectionCommand}"/>
                        <Button Content="{DynamicResource Action.Remove}" Command="{Binding RemoveConnectionCommand}"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1" Margin="6,0" Padding="12" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Margin="3,9,3,3" Text="{DynamicResource Connections.Field.Name}" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="3,7,3,3" Text="{DynamicResource Connections.Field.Type}" Foreground="{StaticResource MutedTextBrush}"/>
                        <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding SelectedConnectionType, Mode=TwoWay}"/>
                        <Border Margin="0,8,0,2" Padding="10" Background="#142338" BorderBrush="#275277" BorderThickness="1" CornerRadius="8">
                          <StackPanel>
                            <TextBlock Text="{Binding ConnectionGuideTitle}" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding ConnectionGuideText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,5,0,0" Text="{Binding ConnectionCredentialsText}" Foreground="{StaticResource TextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                            <Button Margin="0,7,0,0" HorizontalAlignment="Left" Content="{DynamicResource Connections.Prowlarr.UseLocal}" Command="{Binding UseLocalProwlarrCommand}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ConnectionActionButtonStyle}">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding IsProwlarrSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                          </StackPanel>
                        </Border>
                        <TextBlock Margin="3,7,3,3" Text="{DynamicResource Connections.Field.Url}" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding BaseUrlHintText}"/>
                        <Grid Margin="3,7,3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Connections.Field.ApiKey}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding ApiKeyRequirementText}" Foreground="{StaticResource BrandBrush}" FontSize="11"/></Grid>
                        <PasswordBox appServices:PasswordBoxBinding.IsEnabled="True" appServices:PasswordBoxBinding.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Connections.ApiKey.Hint}"/>
                        <CheckBox Margin="3,6,3,2" Content="{DynamicResource Connections.Field.AllowLocalHttp}" IsChecked="{Binding AllowLocalHttp, Mode=TwoWay}"/>
                        <Expander Margin="0,8,0,0" Header="{DynamicResource Panel.AdvancedSettings}" Foreground="{StaticResource MutedTextBrush}" IsExpanded="False">
                          <Border Padding="9" Background="#101C2C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTypeSupportsSearch}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel>
                              <TextBlock Text="{DynamicResource Connections.Categories.Title}" FontWeight="SemiBold"/>
                              <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Connections.Filter.Movie}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBox Text="{Binding MovieCategories, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Connections.Filter.Series}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBox Text="{Binding SeriesCategories, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Connections.Filter.Anime}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBox Text="{Binding AnimeCategories, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Connections.Filter.Other}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/><TextBox Text="{Binding OtherCategories, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                              <TextBlock Margin="3,5,3,2" Text="{DynamicResource Connections.Field.ResultLimit}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                              <TextBox Text="{Binding ResultLimit, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                          </Border>
                        </Expander>

                        <Border Margin="0,9,0,0" Padding="9" Background="#211B0E" BorderBrush="#6B5325" BorderThickness="1" CornerRadius="8">
                          <StackPanel>
                            <TextBlock Text="{DynamicResource Connections.Legal.Text}" Foreground="#D6B46A" FontSize="11.5" TextWrapping="Wrap"/>
                            <CheckBox Margin="2,7,2,1" Content="{DynamicResource Connections.Legal.Accept}" IsChecked="{Binding LegalNoticeAccepted, Mode=TwoWay}"/>
                            <CheckBox Margin="2,2,2,1" Content="{DynamicResource Connections.Legal.OwnService}" IsChecked="{Binding UserOwnsServiceConfirmed, Mode=TwoWay}"/>
                          </StackPanel>
                        </Border>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                          <Button Content="{DynamicResource Connections.Action.Test}" Command="{Binding TestConnectionCommand}"/>
                          <Button Content="{DynamicResource Connections.Action.Save}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveConnectionCommand}"/>
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>

                  <Border Grid.Column="2" Margin="6,0,4,0" Padding="11" Background="#101C2C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource Connections.Release.Title}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,3,0,0" Text="{DynamicResource Connections.Release.Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ContentFilters}" SelectedItem="{Binding SelectedContentFilter, Mode=TwoWay}"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Connections.SearchHint}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Action.Search}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}"/>
                        <Button Grid.Column="3" Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshReleasesCommand}"/>
                      </Grid>
                      <Grid Grid.Row="2">
                        <TextBlock Text="{DynamicResource Connections.Release.Inactive}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSearchConnections}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}">
                          <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSearchConnections}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="1,2" Padding="9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ContentType}" Foreground="{StaticResource BrandBrush}" FontSize="11.5"/></Grid><TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding DetailLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBlock Grid.Row="2" Margin="0,2,0,0" Text="{Binding ConnectionName}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                      <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ReleaseSummaryText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource Connections.Action.OpenRelease}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PlayReleaseCommand}"/></Grid>
                    </Grid>
                  </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="7,8,7,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding WarningsText}" Foreground="#D6A85F" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                  <ProgressBar Grid.Column="1" Width="130" Height="5" IsIndeterminate="True"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
                </Grid>
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Addons}" DataContext="{Binding Addons}">
              <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="6,3,6,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{DynamicResource Addons.Title}" FontSize="24" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,0" Text="{DynamicResource Addons.ManagementSubtitle}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel>
                  <Button Grid.Column="1" Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                  <Border Margin="4,0,7,0" Padding="14" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Addons.Addon.Title}" FontSize="17" FontWeight="SemiBold"/>
                      <TextBlock Margin="0,4,0,10" Text="{DynamicResource Addons.Addon.Help}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Margin="3,0,3,3" Text="{DynamicResource Addons.Field.Address}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/>
                      <TextBox Text="{Binding AddonUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Addons.Addon.UrlHint}"/>
                      <CheckBox Margin="3,7,3,0" Content="{DynamicResource Addons.Field.AllowLocalHttp}" IsChecked="{Binding AllowLocalHttp, Mode=TwoWay}"/>
                      <Border Margin="0,10,0,0" Padding="10" Background="#191F2D" BorderBrush="#5C5427" BorderThickness="1" CornerRadius="8">
                        <StackPanel><TextBlock Text="{DynamicResource Addons.Legal.ShortText}" Foreground="#D6B46A" FontSize="11.5" TextWrapping="Wrap"/><CheckBox Margin="3,7,3,0" Content="{DynamicResource Addons.Legal.Accept}" IsChecked="{Binding LegalNoticeAccepted, Mode=TwoWay}"/><CheckBox Margin="3,3,3,0" Content="{DynamicResource Addons.Legal.OwnAddon}" IsChecked="{Binding UserOwnsAddonConfirmed, Mode=TwoWay}"/></StackPanel>
                      </Border>
                      <Button Margin="0,12,0,0" MinWidth="150" HorizontalAlignment="Right" Content="{DynamicResource Addons.Action.Install}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddAddonCommand}"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Margin="7,0,4,0" Padding="14" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Addons.Installed.Title}" FontSize="17" FontWeight="SemiBold"/>
                      <ListBox Grid.Row="1" Margin="0,9,0,8" ItemsSource="{Binding Addons}" SelectedItem="{Binding SelectedAddon, Mode=TwoWay}">
                        <ListBox.ItemTemplate><DataTemplate><Border Margin="1,2" Padding="10" Background="#0F1E30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Margin="0,3,0,0" Text="{Binding SafeManifestUrl}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="●" Margin="10,0,2,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7D8B81"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrandBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                      </ListBox>
                      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedAddonStateText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Addons.Action.Toggle}" Command="{Binding ToggleAddonCommand}"/><Button Content="{DynamicResource Action.Remove}" Command="{Binding RemoveAddonCommand}"/></StackPanel></Grid>
                    </Grid>
                  </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="7,9,7,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><ProgressBar Grid.Column="1" Width="130" Height="5" IsIndeterminate="True"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></Grid>
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Torrent}" DataContext="{Binding Torrent}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                  <TextBlock Margin="3" Text="{Binding AvailabilityText}" FontSize="11.5" Foreground="{StaticResource BrandBrush}" TextWrapping="Wrap"/>
                  <TextBox Margin="3" Text="{Binding MagnetUri, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.Magnet}"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="{DynamicResource Action.PrepareMagnet}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PrepareMagnetCommand}"/><Button Content="{DynamicResource Action.OpenTorrentFile}" Command="{Binding PrepareTorrentFileCommand}"/><Button Content="{DynamicResource Action.OpenCache}" Command="{Binding OpenCacheCommand}"/></StackPanel>
                  <CheckBox Content="{DynamicResource Panel.TorrentLegal}" IsChecked="{Binding LegalNoticeAccepted, Mode=TwoWay}"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="3,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SessionTitle, Converter={StaticResource LocalizedTextConverter}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" Foreground="{StaticResource BrandBrush}"/></Grid>
                <ProgressBar Grid.Row="2" Margin="3" Height="6" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
                <ListBox Grid.Row="3" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Height="4" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/><TextBlock Grid.Column="1" Margin="7,0,0,0" Text="{Binding SizeLabel}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <Grid Grid.Row="4" Margin="2,5,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="{DynamicResource Action.PlaySelected}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartSelectedCommand}"/><Button Content="{DynamicResource Action.Pause}" Command="{Binding PauseCommand}"/><Button Content="{DynamicResource Action.Resume}" Command="{Binding ResumeCommand}"/><Button Content="{DynamicResource Action.Close}" Command="{Binding RemoveCommand}"/></StackPanel></Grid>
              </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Update}" DataContext="{Binding Updates}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                  <Border Padding="10" Background="#172B43" CornerRadius="8"><TextBlock Text="{Binding CurrentVersionText}" FontSize="15" FontWeight="SemiBold"/></Border>
                  <TextBlock Margin="3,12,3,4" Text="{DynamicResource Panel.UpdateChannel}" Foreground="{StaticResource MutedTextBrush}"/>
                  <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" IsEnabled="{Binding CanChangeUpdateChannel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Converter={StaticResource UpdateChannelTextConverter}}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox Content="{DynamicResource Panel.CheckOnStartup}" IsChecked="{Binding CheckOnStartup, Mode=TwoWay}" IsEnabled="{Binding CanChangeUpdateSettings}"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0"><Button Content="{DynamicResource Action.CheckUpdate}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CheckCommand}"/><Button Content="{Binding UpdateActionText}" Command="{Binding DownloadAndInstallCommand}" IsEnabled="{Binding IsUpdateAvailable}"/></StackPanel>
                  <ProgressBar Height="7" Margin="3,8" Minimum="0" Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}">
                    <ProgressBar.Style>
                      <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="IsIndeterminate" Value="False"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsBusy}" Value="True"/>
                              <Condition Binding="{Binding IsDownloading}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsIndeterminate" Value="True"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                  <TextBlock Margin="3" Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" TextWrapping="Wrap" Foreground="{StaticResource BrandBrush}"/>
                  <Expander Header="{DynamicResource Panel.ReleaseNotes}" Margin="3,8,3,0" Foreground="{StaticResource MutedTextBrush}"><TextBlock Padding="8" Text="{Binding ReleaseNotesDisplayText}" TextWrapping="Wrap"/></Expander>
                  <Separator Margin="3,12"/>
                  <TextBlock Margin="3,0,3,5" Text="{DynamicResource Panel.Diagnostics}" FontWeight="SemiBold"/>
                  <Button HorizontalAlignment="Center" Content="{DynamicResource Action.CreateDiagnostics}" Command="{Binding CreateDiagnosticsCommand}"/>
                  <TextBlock Margin="4,8" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Text="{DynamicResource Panel.UpdateSecurityNote}"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Margin="12,7,12,10" Background="{StaticResource PlayerSciFiDeckBrush}" BorderBrush="#23465A" BorderThickness="1" CornerRadius="16">
      <Grid Margin="16,9,16,9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,3">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PlayerTimePillStyle}" Cursor="Hand" MouseLeftButtonDown="TimePill_OnMouseLeftButtonDown" ToolTip="{DynamicResource Player.Time.Precision.Help}"><TextBlock MinWidth="92" Text="{Binding PositionText}" TextAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/></Border>
          <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource PlayerSeekSliderStyle}" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown" PreviewMouseMove="SeekSlider_OnPreviewMouseMove" PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp" LostMouseCapture="SeekSlider_OnLostMouseCapture" PreviewMouseWheel="SeekSlider_OnMouseWheel" MouseLeave="SeekSlider_OnMouseLeave" ToolTip="{DynamicResource Player.Seek.Help}"/>
          <Border Grid.Column="2" Style="{StaticResource PlayerTimePillStyle}" Cursor="Hand" MouseLeftButtonDown="TimePill_OnMouseLeftButtonDown" ToolTip="{DynamicResource Player.Time.Precision.Help}"><TextBlock MinWidth="92" Text="{Binding DurationText}" TextAlignment="Center" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/></Border>
        </Grid>

        <Popup x:Name="SeekPreviewPopup" PlacementTarget="{Binding ElementName=SeekSlider}" Placement="Relative" AllowsTransparency="False" StaysOpen="True" IsHitTestVisible="False">
          <Border Width="240" Height="140" Padding="3" Background="#F00A111D" BorderBrush="#3C728C" BorderThickness="1" CornerRadius="12">
            <Grid ClipToBounds="True">
              <playback:MpvVideoHost x:Name="PreviewVideoHost" Focusable="False"/>
              <Border VerticalAlignment="Bottom" Background="#D0000000" Padding="6,3"><TextBlock x:Name="SeekPreviewTimeText" Text="0:00" HorizontalAlignment="Center" Foreground="White" FontWeight="SemiBold"/></Border>
            </Grid>
          </Border>
        </Popup>

        <Grid Grid.Row="1" Margin="0,2,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource PlayerCommandDeckStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Control.Speed}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="6,0,7,0"/>
              <ComboBox Width="88" Style="{StaticResource PlayerCompactComboStyle}" Margin="0"
                        ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}" ToolTip="{DynamicResource Player.Speed.Quick.Help}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:0.##}×}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource PlayerTransportDeckStyle}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="⏮" Style="{StaticResource PlayerTransportButtonStyle}" Command="{Binding PreviousCommand}" ToolTip="{DynamicResource Tooltip.Previous}"/>
              <Button Content="{Binding SeekBackwardLabel}" Style="{StaticResource PlayerTransportButtonStyle}" Command="{Binding SeekBackwardCommand}" ToolTip="{DynamicResource Player.Seek.Backward}"/>
              <Button Width="58" Height="58" MinWidth="58" Content="{Binding PlayPauseText}" Style="{StaticResource PlayerPrimaryTransportButtonStyle}" Command="{Binding PlayPauseCommand}" ToolTip="{DynamicResource Tooltip.PlayPause}"/>
              <Button Content="{Binding SeekForwardLabel}" Style="{StaticResource PlayerTransportButtonStyle}" Command="{Binding SeekForwardCommand}" ToolTip="{DynamicResource Player.Seek.Forward}"/>
              <Button Content="⏭" Style="{StaticResource PlayerTransportButtonStyle}" Command="{Binding NextCommand}" ToolTip="{DynamicResource Tooltip.Next}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource PlayerCommandDeckStyle}" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Margin="5,0,7,0" Text="🔊" FontSize="14" VerticalAlignment="Center"/>
              <Slider Width="128" Margin="0,0,5,0" Style="{StaticResource PlayerVolumeSliderStyle}" Minimum="0" Maximum="{Binding VolumeBoostLimit}" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="{DynamicResource Tooltip.Volume}"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,4,0,2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource PlayerCommandDeckStyle}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton x:Name="SubtitleSearchToggle" Style="{StaticResource PlayerUtilityToggleStyle}" Content="{DynamicResource Player.SubtitleSearch}"/>
            <Button Style="{StaticResource PlayerUtilityButtonStyle}" Content="{DynamicResource Action.AttachSubtitle}" Command="{Binding AttachSubtitleCommand}"/>
            <Button x:Name="ExternalAudioButton" Style="{StaticResource PlayerUtilityButtonStyle}" Content="{DynamicResource Action.AttachAudio}" Click="ExternalAudioButton_OnClick">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{DynamicResource Player.AudioSource.Local}" Tag="Local" Click="ExternalAudioSourceMenuItem_OnClick"/>
                  <MenuItem Header="{DynamicResource Player.AudioSource.Remote}" Tag="Remote" Click="ExternalAudioSourceMenuItem_OnClick"/>
                  <MenuItem Header="{DynamicResource Player.AudioSource.Telegram}" Tag="Telegram" Click="ExternalAudioSourceMenuItem_OnClick"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button Margin="7,0,3,0"
                    Command="{Binding ResyncAudioCommand}"
                    ToolTip="{DynamicResource Player.AudioSync.Manual}"
                    AutomationProperties.Name="{DynamicResource Player.AudioSync.Manual}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PlayerUtilityButtonStyle}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Background" Value="#102638"/>
                  <Setter Property="BorderBrush" Value="#2B6078"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasExternalAudio}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsAudioSyncBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsAudioSyncActionComplete}" Value="True">
                      <Setter Property="Background" Value="#0B151F"/>
                      <Setter Property="BorderBrush" Value="#233A4B"/>
                      <Setter Property="Opacity" Value="0.82"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAudioSyncActionRetry}" Value="True">
                      <Setter Property="Background" Value="#211A10"/>
                      <Setter Property="BorderBrush" Value="#6A5530"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="A↔" Foreground="{StaticResource PlayerSciFiAccentBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding AudioSyncActionText}"/>
              </StackPanel>
            </Button>
            <Button Margin="3,0"
                    Command="{Binding ResyncSubtitleCommand}"
                    ToolTip="{DynamicResource Player.SubtitleSync.Manual}"
                    AutomationProperties.Name="{DynamicResource Player.SubtitleSync.Manual}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PlayerUtilityButtonStyle}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Setter Property="FontSize" Value="11"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter Property="Background" Value="#102638"/>
                  <Setter Property="BorderBrush" Value="#2B6078"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSubtitleSyncVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsSubtitleSyncBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsSubtitleSyncActionComplete}" Value="True">
                      <Setter Property="Background" Value="#0B151F"/>
                      <Setter Property="BorderBrush" Value="#233A4B"/>
                      <Setter Property="Opacity" Value="0.82"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSubtitleSyncActionRetry}" Value="True">
                      <Setter Property="Background" Value="#211A10"/>
                      <Setter Property="BorderBrush" Value="#6A5530"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="CC↔" Foreground="{StaticResource PlayerSciFiAccentBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding SubtitleSyncActionText}"/>
              </StackPanel>
            </Button>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1" Margin="10,0">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusMessage, Converter={StaticResource UserFacingTextConverter}}" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasExternalAudio}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsSubtitleSyncVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <Border Padding="10,5" Background="#101D27" BorderBrush="#2A4D61" BorderThickness="1" CornerRadius="10" ToolTip="{Binding AudioSyncStatus}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasExternalAudio}" Value="True"/>
                        <Condition Binding="{Binding IsSubtitleSyncVisible}" Value="False"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" Margin="0,0,8,0" Background="#163247" CornerRadius="12">
                    <TextBlock Text="{Binding AudioSyncGlyphText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}" FontWeight="Bold" FontSize="11.5"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AudioSyncProgressSummaryText}" Foreground="{StaticResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AudioSyncStageText}" Foreground="{StaticResource MutedTextBrush}" FontSize="8.5" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Margin="10,0,7,0" VerticalAlignment="Center" Text="{Binding AudioSyncEtaText}" Foreground="{StaticResource BrandBrush}" FontSize="8.5" FontWeight="SemiBold"/>
                  <ToggleButton Grid.Column="3" x:Name="AudioSyncDetailsToggle" Style="{StaticResource PlayerSyncDetailsToggleStyle}" Content="{DynamicResource Player.AudioSync.Details}"/>
                </Grid>
                <ProgressBar Grid.Row="1" Height="4" Margin="32,5,0,0" Minimum="0" Maximum="100" Value="{Binding AudioSyncProgress, Mode=OneWay}">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAudioSyncBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
              </Grid>
            </Border>

            <Border Padding="10,5" Background="#0E1A23" BorderBrush="#294859" BorderThickness="1" CornerRadius="10" ToolTip="{Binding SubtitleSyncStatus}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSubtitleSyncVisible}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" Margin="0,0,8,0" Background="#142C3B" CornerRadius="12">
                    <TextBlock Text="{Binding SubtitleSyncGlyphText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}" FontWeight="Bold" FontSize="11.5"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SubtitleSyncProgressSummaryText}" Foreground="{StaticResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubtitleSyncStageText}" Foreground="{StaticResource MutedTextBrush}" FontSize="8.5" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding SubtitleSyncProgress, StringFormat={}{0}%}" Foreground="{StaticResource BrandBrush}" FontSize="8.5" FontWeight="SemiBold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsSubtitleSyncBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <ProgressBar Grid.Row="1" Height="4" Margin="32,5,0,0" Minimum="0" Maximum="100" Value="{Binding SubtitleSyncProgress, Mode=OneWay}">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsSubtitleSyncBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Column="2" Style="{StaticResource PlayerCommandDeckStyle}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox Width="148" Style="{StaticResource PlayerCompactComboStyle}" ToolTip="{DynamicResource Tooltip.AudioTrack}" ItemsSource="{Binding AudioTracks}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}"/>
            <ComboBox Width="164" Style="{StaticResource PlayerCompactComboStyle}" ToolTip="{DynamicResource Tooltip.SubtitleTrack}" ItemsSource="{Binding SubtitleTracks}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}"/>
            <ToggleButton x:Name="SubtitleSettingsToggle" Style="{StaticResource PlayerUtilityToggleStyle}" Content="CC²" ToolTip="{DynamicResource Player.SubtitlePower.Title}"/>
            <ToggleButton x:Name="PlaybackSettingsToggle"
                          Style="{StaticResource PlayerCompactIconToggleStyle}"
                          Content="⚙"
                          ToolTip="{DynamicResource Player.Controls.Settings}"
                          AutomationProperties.Name="{DynamicResource Player.Controls.Settings}"/>
            <Button Style="{StaticResource PlayerUtilityButtonStyle}" Content="⛶" Click="FullscreenButton_OnClick" ToolTip="{DynamicResource Action.Fullscreen}"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- v1.0.1: native HwndHost video cannot be covered reliably by an in-tree WPF overlay.
             Popup owns a separate HWND, so the fullscreen transport stays visible above libmpv. -->
        <Popup x:Name="FullscreenControlsPopup"
               PlacementTarget="{Binding ElementName=VideoBorder}"
               Placement="Relative"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade"
               Focusable="False"
               IsOpen="False">
          <Border x:Name="FullscreenControlPanel"
                  Height="112"
                  Padding="16,10"
                  Background="#F20A1119"
                  BorderBrush="#345F77"
                  BorderThickness="1"
                  CornerRadius="16"
                  MouseMove="FullscreenControls_OnMouseMove">
            <Border.Effect>
              <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionText}" Foreground="#DDEAF0" VerticalAlignment="Center" TextAlignment="Left" FontWeight="SemiBold"/>
                <Slider x:Name="FullscreenSeekSlider"
                        Grid.Column="1"
                        Margin="8,0"
                        Height="22"
                        Style="{StaticResource PlayerSeekSliderStyle}"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        PreviewMouseLeftButtonDown="FullscreenSeekSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseMove="FullscreenSeekSlider_OnPreviewMouseMove"
                        PreviewMouseLeftButtonUp="FullscreenSeekSlider_OnPreviewMouseLeftButtonUp"/>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#DDEAF0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"/>
              </Grid>

              <Grid Grid.Row="1" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="🔊" Margin="0,0,7,0" VerticalAlignment="Center" FontSize="14"/>
                  <Slider Width="132"
                          Style="{StaticResource PlayerVolumeSliderStyle}"
                          Minimum="0"
                          Maximum="{Binding VolumeBoostLimit}"
                          Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="{Binding SeekBackwardLabel}" Style="{StaticResource PlayerTransportButtonStyle}" Command="{Binding SeekBackwardCommand}" ToolTip="{DynamicResource Player.Seek.Backward}"/>
                  <Button Width="52" Height="52" MinWidth="52" Content="{Binding PlayPauseText}" Style="{StaticResource PlayerPrimaryTransportButtonStyle}" Command="{Binding PlayPauseCommand}" ToolTip="{DynamicResource Tooltip.PlayPause}"/>
                  <Button Content="{Binding SeekForwardLabel}" Style="{StaticResource PlayerTransportButtonStyle}" Command="{Binding SeekForwardCommand}" ToolTip="{DynamicResource Player.Seek.Forward}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Style="{StaticResource PlayerUtilityButtonStyle}"
                          Content="CC"
                          Command="{Binding AttachSubtitleCommand}"
                          ToolTip="{DynamicResource Action.AttachSubtitle}"/>
                  <Button Style="{StaticResource PlayerUtilityButtonStyle}"
                          Content="⛶"
                          Click="FullscreenButton_OnClick"
                          ToolTip="{DynamicResource Action.Fullscreen}"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Popup>

        <Popup PlacementTarget="{Binding ElementName=SubtitleSettingsToggle}" Placement="Top" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=SubtitleSettingsToggle, Mode=TwoWay}">
          <Border Width="500" Margin="0,0,0,9" Padding="14" Background="{StaticResource PanelRaisedBrush}" BorderBrush="#29465D" BorderThickness="1" CornerRadius="14">
            <StackPanel>
              <TextBlock Text="{DynamicResource Player.SubtitlePower.Title}" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Margin="0,3,0,12" Text="{DynamicResource Player.SubtitlePower.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
              <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Player.SubtitlePower.Primary}" Foreground="{StaticResource MutedTextBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SubtitleTracks}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}"/>
                <Button Grid.Column="2" Margin="7,0,0,0" Content="{DynamicResource Action.AttachSubtitle}" Command="{Binding AttachSubtitleCommand}"/>
              </Grid>
              <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Player.SubtitlePower.Secondary}" Foreground="{StaticResource MutedTextBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SecondarySubtitleTracks}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSecondarySubtitleTrack, Mode=TwoWay}"/>
                <Button Grid.Column="2" Margin="7,0,0,0" Content="{DynamicResource Player.SubtitlePower.AddSecondary}" Command="{Binding AttachSecondarySubtitleCommand}"/>
              </Grid>
              <Separator Margin="0,0,0,9"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.PrimarySettings}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                  <CheckBox Margin="0,0,0,7" Content="{DynamicResource Player.SubtitlePower.PreserveAss}" IsChecked="{Binding PreservePrimaryAssStyle, Mode=TwoWay}"/>
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.Delay}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,7"><Button MinWidth="34" Content="−" Command="{Binding PrimarySubtitleDelayDecreaseCommand}"/><Border Margin="5,0" Padding="9,5" Background="#101A23" CornerRadius="7"><TextBlock MinWidth="74" Text="{Binding PrimarySubtitleDelayText}" TextAlignment="Center"/></Border><Button MinWidth="34" Content="+" Command="{Binding PrimarySubtitleDelayIncreaseCommand}"/><Button Margin="5,0,0,0" Content="0" Command="{Binding PrimarySubtitleDelayResetCommand}"/></StackPanel>
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.Scale}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><Slider Minimum="0.5" Maximum="2" TickFrequency="0.05" Value="{Binding PrimarySubtitleScale, Mode=TwoWay}"/>
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.Position}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><Slider Minimum="0" Maximum="150" TickFrequency="1" Value="{Binding PrimarySubtitlePosition, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.SecondarySettings}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                  <CheckBox Margin="0,0,0,7" Content="{DynamicResource Player.SubtitlePower.PreserveAss}" IsChecked="{Binding PreserveSecondaryAssStyle, Mode=TwoWay}"/>
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.Delay}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,7"><Button MinWidth="34" Content="−" Command="{Binding SecondarySubtitleDelayDecreaseCommand}"/><Border Margin="5,0" Padding="9,5" Background="#101A23" CornerRadius="7"><TextBlock MinWidth="74" Text="{Binding SecondarySubtitleDelayText}" TextAlignment="Center"/></Border><Button MinWidth="34" Content="+" Command="{Binding SecondarySubtitleDelayIncreaseCommand}"/><Button Margin="5,0,0,0" Content="0" Command="{Binding SecondarySubtitleDelayResetCommand}"/></StackPanel>
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.Scale}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><Slider Minimum="0.5" Maximum="2" TickFrequency="0.05" Value="{Binding SecondarySubtitleScale, Mode=TwoWay}"/>
                  <TextBlock Text="{DynamicResource Player.SubtitlePower.Position}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><Slider Minimum="0" Maximum="150" TickFrequency="1" Value="{Binding SecondarySubtitlePosition, Mode=TwoWay}"/>
                </StackPanel>
              </Grid>
              <TextBlock Margin="0,10,0,0" Text="{DynamicResource Player.SubtitlePower.SecondarySyncNote}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Popup>

        <Popup PlacementTarget="{Binding ElementName=PlaybackSettingsToggle}" Placement="Top" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=PlaybackSettingsToggle, Mode=TwoWay}">
          <Border Width="590" MaxHeight="700" Margin="0,0,0,9" Background="{StaticResource PanelRaisedBrush}" BorderBrush="#294B60" BorderThickness="1" CornerRadius="15">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border Padding="16,14,16,12" BorderBrush="#213A4C" BorderThickness="0,0,0,1">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Player.Controls.Settings}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,3,0,0" Text="{DynamicResource Player.Controls.Settings.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" Margin="16,10,9,7" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PlayerSettingsScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,5,0">
                  <Border Style="{StaticResource PlayerSettingsCardStyle}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource PlayerSettingsSectionTitleStyle}" Text="{DynamicResource Player.Controls.QuickSettings}"/>
                      <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.VideoProfile.Label}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding VideoProfileOptions}" SelectedItem="{Binding SelectedVideoProfile, Mode=TwoWay}" DisplayMemberPath="DisplayName" ToolTip="{DynamicResource Player.VideoProfile.Help}"/>
                      </Grid>
                      <TextBlock Margin="118,0,0,7"
                                 MaxHeight="30"
                                 Text="{Binding VideoProfileSummary}"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 FontSize="10.5"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"/>
                      <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.VideoEnhancement.Label}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding VideoEnhancementOptions}" SelectedItem="{Binding SelectedVideoEnhancement, Mode=TwoWay}" DisplayMemberPath="DisplayName" ToolTip="{DynamicResource Player.VideoEnhancement.Help}"/>
                      </Grid>
                      <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Control.Speed}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SelectedSpeed, Mode=TwoWay}"/>
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Controls.Chapters}"/>
                        <ComboBox Grid.Column="1" ToolTip="{DynamicResource Tooltip.Chapters}" ItemsSource="{Binding Chapters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedChapter, Mode=TwoWay}"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Expander Style="{StaticResource PlayerSettingsExpanderStyle}" Header="{DynamicResource Player.VideoAdvanced.Title}">
                    <StackPanel>
                      <TextBlock Margin="0,0,0,8" Text="{DynamicResource Player.VideoAdvanced.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Video.Brightness}"/><Slider Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="5" Value="{Binding VideoBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="{Binding VideoBrightness, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Video.Contrast}"/><Slider Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="5" Value="{Binding VideoContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="{Binding VideoContrast, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Video.Saturation}"/><Slider Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="5" Value="{Binding VideoSaturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="{Binding VideoSaturation, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                      <Grid Margin="0,2,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Video.Gamma}"/><Slider Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="5" Value="{Binding VideoGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="{Binding VideoGamma, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center"/></Grid>
                      <Button HorizontalAlignment="Right" Content="{DynamicResource Player.Video.Reset}" Command="{Binding ResetVideoEqualizerCommand}"/>
                      <Separator Margin="0,9"/>
                      <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Hdr.Output}"/><ComboBox Grid.Column="1" ItemsSource="{Binding HdrOutputOptions}" SelectedItem="{Binding SelectedHdrOutputMode, Mode=TwoWay}" DisplayMemberPath="DisplayName"/></Grid>
                      <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Hdr.ToneMapping}"/><ComboBox Grid.Column="1" ItemsSource="{Binding ToneMappingOptions}" SelectedItem="{Binding SelectedToneMappingMode, Mode=TwoWay}" DisplayMemberPath="DisplayName"/></Grid>
                      <TextBlock Margin="105,2,0,0" Text="{DynamicResource Player.Hdr.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Expander>

                  <Expander Style="{StaticResource PlayerSettingsExpanderStyle}" Header="{DynamicResource Player.AudioOutput.Title}">
                    <StackPanel>
                      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.AudioOutput.Device}"/><ComboBox Grid.Column="1" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}" DisplayMemberPath="DisplayName"/><Button Grid.Column="2" Margin="6,0,0,0" Content="↻" Command="{Binding RefreshAudioDevicesCommand}" ToolTip="{DynamicResource Player.AudioOutput.Refresh}"/></Grid>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.AudioOutput.Delay}"/><Button Grid.Column="1" MinWidth="34" Content="−" Command="{Binding AudioDeviceDelayDecreaseCommand}"/><Border Grid.Column="2" Margin="5,0" Padding="10,6" Background="#142338" CornerRadius="8"><TextBlock MinWidth="64" Text="{Binding AudioDeviceDelayText}" TextAlignment="Center" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold"/></Border><Button Grid.Column="3" MinWidth="34" Content="+" Command="{Binding AudioDeviceDelayIncreaseCommand}"/><Button Grid.Column="5" Content="{DynamicResource Player.AudioOutput.Reset}" Command="{Binding AudioDeviceDelayResetCommand}"/></Grid>
                      <TextBlock Margin="105,5,0,0" Text="{DynamicResource Player.AudioOutput.DelayHelp}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Expander>

                  <Border Style="{StaticResource PlayerSettingsCardStyle}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource PlayerSettingsSectionTitleStyle}" Text="{DynamicResource Player.Controls.Navigation}"/>
                      <TextBlock Margin="0,0,0,7" Text="{DynamicResource Player.PlaybackPower.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5"/>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="74"/><ColumnDefinition Width="74"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.Seek.Steps}"/>
                        <TextBox Grid.Column="1" Margin="2" Text="{Binding SeekShortSeconds, UpdateSourceTrigger=LostFocus}" ToolTip="{DynamicResource Player.Seek.Short}"/>
                        <TextBox Grid.Column="2" Margin="2" Text="{Binding SeekMediumSeconds, UpdateSourceTrigger=LostFocus}" ToolTip="{DynamicResource Player.Seek.Medium}"/>
                        <TextBox Grid.Column="3" Margin="2" Text="{Binding SeekLongSeconds, UpdateSourceTrigger=LostFocus}" ToolTip="{DynamicResource Player.Seek.Long}"/>
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.GoToTime.Title}"/>
                        <TextBox Grid.Column="1" Margin="2,0,6,0" Text="{Binding GoToTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Player.GoToTime.Help}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Action.Go}" Command="{Binding GoToTimeCommand}"/>
                      </Grid>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.FrameStep.Title}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                          <Button MinWidth="82" Content="{DynamicResource Player.FrameStep.Previous}" Command="{Binding FrameBackwardCommand}"/>
                          <Button MinWidth="82" Content="{DynamicResource Player.FrameStep.Next}" Command="{Binding FrameForwardCommand}"/>
                        </StackPanel>
                      </Grid>
                      <CheckBox Content="{DynamicResource Player.Playlist.AutoFolder}" IsChecked="{Binding AutoAddFolderVideos, Mode=TwoWay}"/>
                    </StackPanel>
                  </Border>

                  <Expander Style="{StaticResource PlayerSettingsExpanderStyle}" Header="{DynamicResource Player.ContactSheet.Title}">
                    <StackPanel>
                      <TextBlock Margin="0,0,0,7" Text="{DynamicResource Player.ContactSheet.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PlayerSettingsFieldLabelStyle}" Text="{DynamicResource Player.ContactSheet.Size}"/><ComboBox Grid.Column="1" ItemsSource="{Binding ContactSheetSizeOptions}" SelectedItem="{Binding SelectedContactSheetSize, Mode=TwoWay}" DisplayMemberPath="DisplayName"/><Button Grid.Column="2" Margin="7,0,0,0" Content="{DynamicResource Player.ContactSheet.Create}" Command="{Binding ContactSheetCommand}"/></Grid>
                    </StackPanel>
                  </Expander>

                  <Expander Style="{StaticResource PlayerSettingsExpanderStyle}" Header="{DynamicResource Player.Shortcuts.Title}">
                    <StackPanel>
                      <TextBlock Margin="0,0,0,7" Text="{DynamicResource Player.Shortcuts.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.PlayPause}"/><TextBox Grid.Column="1" Text="{Binding ShortcutPlayPause, UpdateSourceTrigger=LostFocus}"/></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.Seek}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="90" Text="{Binding ShortcutSeekBackward, UpdateSourceTrigger=LostFocus}"/><TextBox Width="90" Text="{Binding ShortcutSeekForward, UpdateSourceTrigger=LostFocus}"/></StackPanel></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.SeekMedium}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="90" Text="{Binding ShortcutSeekBackwardMedium, UpdateSourceTrigger=LostFocus}"/><TextBox Width="90" Text="{Binding ShortcutSeekForwardMedium, UpdateSourceTrigger=LostFocus}"/></StackPanel></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.SeekLong}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="90" Text="{Binding ShortcutSeekBackwardLong, UpdateSourceTrigger=LostFocus}"/><TextBox Width="90" Text="{Binding ShortcutSeekForwardLong, UpdateSourceTrigger=LostFocus}"/></StackPanel></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.Frame}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox Width="90" Text="{Binding ShortcutFrameBackward, UpdateSourceTrigger=LostFocus}"/><TextBox Width="90" Text="{Binding ShortcutFrameForward, UpdateSourceTrigger=LostFocus}"/></StackPanel></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.Screenshot}"/><TextBox Grid.Column="1" Text="{Binding ShortcutScreenshot, UpdateSourceTrigger=LostFocus}"/></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.Fullscreen}"/><TextBox Grid.Column="1" Text="{Binding ShortcutFullscreen, UpdateSourceTrigger=LostFocus}"/></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.Mini}"/><TextBox Grid.Column="1" Text="{Binding ShortcutMiniPlayer, UpdateSourceTrigger=LostFocus}"/></Grid>
                      <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.Shortcuts.Playlist}"/><TextBox Grid.Column="1" Text="{Binding ShortcutPlaylist, UpdateSourceTrigger=LostFocus}"/></Grid>
                      <Button Margin="0,8,0,0" HorizontalAlignment="Right" Content="{DynamicResource Player.Shortcuts.Reset}" Command="{Binding ResetShortcutsCommand}"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>

              <Border Grid.Row="2" Padding="16,10" Background="#0A121B" BorderBrush="#213A4C" BorderThickness="0,1,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <CheckBox VerticalAlignment="Center" Content="{DynamicResource Control.KeepOnTop}" IsChecked="{Binding KeepWindowOnTop, Mode=TwoWay}"/>
                  <Button Grid.Column="1" Content="{DynamicResource Player.Controls.Screenshot}" Command="{Binding ScreenshotCommand}" ToolTip="{DynamicResource Tooltip.Screenshot}"/>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Popup>

        <Popup PlacementTarget="{Binding ElementName=AudioSyncDetailsToggle}" Placement="Top" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=AudioSyncDetailsToggle, Mode=TwoWay}">
          <Border Width="440" Margin="0,0,0,9" Padding="14" Background="{StaticResource PanelRaisedBrush}" BorderBrush="#2C5775" BorderThickness="1" CornerRadius="14">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Player.AudioSync.Details.Title}" FontSize="16" FontWeight="SemiBold"/><Border Grid.Column="1" Padding="7,3" Background="#142338" CornerRadius="7"><TextBlock Text="{Binding AudioSyncEngineText}" Foreground="{StaticResource BrandBrush}" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
              <TextBlock Margin="0,7,0,10" Text="{Binding AudioSyncDiagnosticsText, Converter={StaticResource UserFacingTextConverter}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" MinWidth="34" Content="−" Command="{Binding AudioDelayDecreaseCommand}" ToolTip="{DynamicResource Player.AudioSync.DelayBack}"/>
                <Border Grid.Column="1" Margin="5,0" Padding="10,6" Background="#142338" CornerRadius="8"><TextBlock MinWidth="64" Text="{Binding AudioSyncOffsetText}" TextAlignment="Center" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold"/></Border>
                <Button Grid.Column="2" MinWidth="34" Content="+" Command="{Binding AudioDelayIncreaseCommand}" ToolTip="{DynamicResource Player.AudioSync.DelayForward}"/>
                <Button Grid.Column="4" Content="{DynamicResource Player.AudioSync.Resync}" Command="{Binding ResyncAudioCommand}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Popup>

        <Popup DataContext="{Binding Subtitles}" PlacementTarget="{Binding ElementName=SubtitleSearchToggle}" Placement="Top" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=SubtitleSearchToggle, Mode=TwoWay}">
          <Border Width="640" Height="460" Margin="0,0,0,9" Padding="16" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="{DynamicResource Player.SubtitleSearch}" FontSize="21" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,12" Text="{DynamicResource Player.SubtitleSearch.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="82"/><ColumnDefinition Width="82"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,7,0"><TextBlock Margin="3,0,3,4" Text="{DynamicResource Player.Subtitle.Field.Title}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Player.Subtitle.Example.Title}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,7,0"><TextBlock Margin="3,0,3,4" Text="{DynamicResource Player.Subtitle.Field.Year}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Player.Subtitle.Example.Year}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,7,0"><TextBlock Margin="3,0,3,4" Text="{DynamicResource Player.Subtitle.Field.Season}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding Season, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Player.Subtitle.Example.Season}"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,7,0"><TextBlock Margin="3,0,3,4" Text="{DynamicResource Player.Subtitle.Field.Episode}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding Episode, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Player.Subtitle.Example.Episode}"/></StackPanel>
                <Button Grid.Column="4" MinWidth="105" VerticalAlignment="Bottom" Content="{DynamicResource Action.SearchSubtitle}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}"/>
              </Grid>
              <ListBox x:Name="SubtitleResultsList" Grid.Row="2" Margin="0,10,0,7" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" MouseDoubleClick="SubtitleResultsList_OnMouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MetaLabel, Converter={StaticResource LocalizedTextConverter}}" FontSize="11.5" Foreground="{StaticResource BrandBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Translator}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
              <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource Action.DownloadAttach}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DownloadAndAttachCommand}"/></Grid>
            </Grid>
          </Border>
        </Popup>
      </Grid>
    </Border>
  </Grid>
</Window>