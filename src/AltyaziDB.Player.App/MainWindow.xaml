                            <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/><ColumnDefinition Width="215"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
