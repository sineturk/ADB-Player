                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Margin="3,0,3,3" Text="{DynamicResource Home.Field.ServerUrl}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="https://sunucu/remote.php/dav/files/kullanici/"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Margin="3,0,3,3" Text="{DynamicResource Home.Field.Username}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.Username}"/></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Margin="3,0,3,3" Text="{DynamicResource Home.Field.Password}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><PasswordBox appServices:PasswordBoxBinding.IsEnabled="True" appServices:PasswordBoxBinding.BoundPassword="{Binding WebDavPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.Password}"/></StackPanel>
