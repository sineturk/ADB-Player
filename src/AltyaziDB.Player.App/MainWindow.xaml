<Window x:Class="AltyaziDB.Player.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:playback="clr-namespace:AltyaziDB.Player.Playback.Controls;assembly=ADB.Player.Playback"
        xmlns:appServices="clr-namespace:AltyaziDB.Player.App.Services"
        xmlns:r23="clr-namespace:AltyaziDB.Player.App.Views.Shell"
        Title="ADB Player"
        Icon="Assets/app.ico"
        Width="1500"
        Height="860"
        MinWidth="1180"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding KeepWindowOnTop}"
        AllowDrop="True"
        Drop="Window_OnDrop"
        DragOver="Window_OnDragOver"
        PreviewKeyDown="Window_OnKeyDown"
        PreviewMouseMove="Window_OnPreviewMouseMove"
        SizeChanged="Window_OnSizeChanged"
        Background="#05080D"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- R2.4 Rev6: player-only calm sci-fi visual layer.
         Kept local to MainWindow so Media Center pages remain unchanged. -->
    <LinearGradientBrush x:Key="PlayerSciFiHeaderBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#080F18" Offset="0"/>
      <GradientStop Color="#0A1520" Offset="0.55"/>
      <GradientStop Color="#071019" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayerSciFiDeckBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F20A131D" Offset="0"/>
      <GradientStop Color="#F2070D14" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayerSciFiPrimaryBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2BC7F0" Offset="0"/>
      <GradientStop Color="#168FCB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PlayerSciFiStrokeBrush" Color="#21384B"/>
    <SolidColorBrush x:Key="PlayerSciFiStrokeHotBrush" Color="#3A7998"/>
    <SolidColorBrush x:Key="PlayerSciFiSurfaceBrush" Color="#0B151F"/>
    <SolidColorBrush x:Key="PlayerSciFiSurfaceHoverBrush" Color="#122332"/>
    <SolidColorBrush x:Key="PlayerSciFiAccentBrush" Color="#36C8F0"/>
    <SolidColorBrush x:Key="PlayerSciFiMutedAccentBrush" Color="#6AA8BF"/>

    <Style x:Key="PlayerHeaderDeckStyle" TargetType="Border">
      <Setter Property="Background" Value="#B80A131D"/>
      <Setter Property="BorderBrush" Value="#203A4E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="4"/>
    </Style>

    <Style x:Key="PlayerHeaderButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#101E2A"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#2A5067"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#152A39"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerHeaderPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerHeaderButtonStyle}">
      <Setter Property="Background" Value="#18364A"/>
      <Setter Property="BorderBrush" Value="#2F7391"/>
      <Setter Property="Foreground" Value="#E9FAFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="PlayerTransportButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="3,1"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#DDEAF0"/>
      <Setter Property="Background" Value="#0D1822"/>
      <Setter Property="BorderBrush" Value="#294153"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TransportBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="21">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TransportBorder" Property="Background" Value="#142431"/>
                <Setter TargetName="TransportBorder" Property="BorderBrush" Value="#3B708B"/>
                <Setter Property="Foreground" Value="#F5FCFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TransportBorder" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                </Setter>
                <Setter TargetName="TransportBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerPrimaryTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerTransportButtonStyle}">
      <Setter Property="Width" Value="58"/>
      <Setter Property="Height" Value="58"/>
      <Setter Property="MinWidth" Value="58"/>
      <Setter Property="Background" Value="{StaticResource PlayerSciFiPrimaryBrush}"/>
      <Setter Property="Foreground" Value="#04121B"/>
      <Setter Property="BorderBrush" Value="#79DFF8"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="OuterRing"
                      Background="#0C1720"
                      BorderBrush="#2D5E76"
                      BorderThickness="1"
                      CornerRadius="31"
                      Margin="-4"/>
              <Border x:Name="PrimaryTransportBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="29">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="OuterRing" Property="BorderBrush" Value="#4C92AE"/>
                <Setter TargetName="PrimaryTransportBorder" Property="BorderBrush" Value="#A7F2FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PrimaryTransportBorder" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
                </Setter>
                <Setter TargetName="PrimaryTransportBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerSeekSliderStyle" TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="10,0"/>
      <Setter Property="IsMoveToPointEnabled" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3" Background="{StaticResource PlayerSciFiAccentBrush}" CornerRadius="2"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3" Background="#263746" CornerRadius="2"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="SeekThumb" Width="12" Height="12">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#D9F6FC"
                                 Stroke="{StaticResource PlayerSciFiAccentBrush}"
                                 StrokeThickness="1.5"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SeekThumb" Property="Width" Value="14"/>
                <Setter TargetName="SeekThumb" Property="Height" Value="14"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="SeekThumb" Property="Width" Value="14"/>
                <Setter TargetName="SeekThumb" Property="Height" Value="14"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerVolumeSliderStyle" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3" Background="{StaticResource PlayerSciFiAccentBrush}" CornerRadius="2"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="3" Background="#263746" CornerRadius="2"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="12" Height="12">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#D9F6FC" Stroke="#4B8198" StrokeThickness="1"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerTimePillStyle" TargetType="Border">
      <Setter Property="Background" Value="#0B151F"/>
      <Setter Property="BorderBrush" Value="#253C4E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style x:Key="PlayerUtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerHeaderButtonStyle}">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="#0B151F"/>
      <Setter Property="BorderBrush" Value="#233A4B"/>
    </Style>
    <Style x:Key="PlayerUtilityToggleStyle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#0B151F"/>
      <Setter Property="BorderBrush" Value="#233A4B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#12222E"/><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3A6178"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="#123044"/><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource PlayerSciFiAccentBrush}"/><Setter Property="Foreground" Value="#DFF9FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PlayerCompactIconToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource PlayerUtilityToggleStyle}">
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PlayerSyncDetailsToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource PlayerUtilityToggleStyle}">
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#142D43"/>
      <Setter Property="BorderBrush" Value="#2D597E"/>
      <Setter Property="ToolTip" Value="{DynamicResource Player.AudioSync.Details.Title}"/>
    </Style>
    <Style x:Key="PlayerCompactComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="3,0"/>
    </Style>

    <Style x:Key="PlayerCommandDeckStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PlayerSciFiDeckBrush}"/>
      <Setter Property="BorderBrush" Value="#20384A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="4,3"/>
    </Style>
    <Style x:Key="PlayerTransportDeckStyle" TargetType="Border" BasedOn="{StaticResource PlayerCommandDeckStyle}">
      <Setter Property="CornerRadius" Value="30"/>
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="Background" Value="#F00A141E"/>
      <Setter Property="BorderBrush" Value="#2A5268"/>
    </Style>

    <Style x:Key="PlayerSettingsCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#0A141E"/>
      <Setter Property="BorderBrush" Value="#223B4D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="PlayerSettingsSectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
    <Style x:Key="PlayerSettingsFieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerSettingsExpanderStyle" TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="#0A141E" BorderBrush="#223B4D" BorderThickness="1" CornerRadius="11">
              <StackPanel>
                <Grid>
                  <ToggleButton x:Name="HeaderButton"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Content="{TemplateBinding Header}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12,10"
                                Cursor="Hand">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                          <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSurface" Property="Background" Value="#101E2A"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <TextBlock x:Name="Chevron"
                             Text="⌄"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,13,0"
                             Foreground="{StaticResource PlayerSciFiMutedAccentBrush}"
                             FontSize="15"
                             IsHitTestVisible="False"/>
                </Grid>
                <ContentPresenter x:Name="ExpandSite"
                                  Visibility="Collapsed"
                                  Margin="12,0,12,12"
                                  ContentSource="Content"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Chevron" Property="Text" Value="⌃"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerSettingsScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="42" Margin="2,1">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="#31566B" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="#4A7890"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="#5D93AA"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="HeaderRow" Height="76" />
      <RowDefinition Height="*" />
      <RowDefinition x:Name="ControlsRow" Height="Auto" />
    </Grid.RowDefinitions>

    <!-- New shell is a sibling overlay, never a parent of native MpvVideoHost. -->
    <r23:MediaCenterShell x:Name="ModernMediaCenter" Grid.Row="0" Grid.RowSpan="3"
                          Panel.ZIndex="100" Visibility="Collapsed"/>

    <Border x:Name="LegacyHeaderBorder" Grid.Row="0" Background="{StaticResource PlayerSciFiHeaderBrush}" BorderBrush="#21475D" BorderThickness="0,0,0,1">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Player-mode chrome uses the same approved brand asset and attached-toolbar language as the Media Center. -->
        <Grid Width="214" Height="54" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Image Source="Assets/logo.png" Width="196" Height="48" Stretch="Uniform"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 ToolTip="ADB Player" AutomationProperties.Name="ADB Player"/>
          <Border Width="96" Height="1" Background="#356E89" Opacity=".55"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,4"/>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource PlayerHeaderDeckStyle}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox Width="104" MinHeight="36"
                      Margin="0,0,4,0"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      ToolTip="{DynamicResource App.Language}" />
            <Button x:Name="MediaCenterHeaderButton" Style="{StaticResource PlayerHeaderButtonStyle}"
                    Content="{DynamicResource App.MediaCenter}" Command="{Binding ShowMediaCenterCommand}" />
            <Button x:Name="ReturnToModernMediaCenterButton" Style="{StaticResource PlayerHeaderButtonStyle}"
                    Content="{DynamicResource R23.ReturnToModern}"
                    Visibility="Collapsed" Click="ReturnToModern_Click"/>
            <Button Content="{DynamicResource Action.OpenFile}" Style="{StaticResource PlayerHeaderButtonStyle}"
                    Command="{Binding OpenFileCommand}" ToolTip="{DynamicResource Tooltip.OpenFile}" />
            <Button Content="{DynamicResource Action.OpenUrl}" Style="{StaticResource PlayerHeaderPrimaryButtonStyle}"
                    Command="{Binding OpenUrlCommand}" ToolTip="{DynamicResource Tooltip.OpenUrl}" />
            <StackPanel x:Name="PlayerHeaderActions" Orientation="Horizontal">
              <Button Style="{StaticResource PlayerHeaderButtonStyle}" Content="{DynamicResource Action.Playlist}" Click="PlaylistButton_OnClick" ToolTip="{DynamicResource Tooltip.Playlist}" />
              <Button Style="{StaticResource PlayerHeaderButtonStyle}" Content="{DynamicResource Action.Mini}" Click="MiniPlayerButton_OnClick" ToolTip="{DynamicResource Tooltip.Mini}" />
              <Button Style="{StaticResource PlayerHeaderButtonStyle}" Content="{DynamicResource Action.Screen}" Click="NextMonitorButton_OnClick" ToolTip="{DynamicResource Tooltip.Screen}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="PlayerContentGrid" Grid.Row="1" Margin="16,14,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="MediaCenterToggleColumn" Width="30" />
        <ColumnDefinition x:Name="SidebarColumn" Width="438" />
      </Grid.ColumnDefinitions>

      <Border x:Name="VideoBorder"
              Grid.Column="0"
              Margin="0"
              Background="Black"
              BorderBrush="#24475C"
              BorderThickness="1"
              CornerRadius="14"
              MouseLeftButtonDown="VideoBorder_OnMouseLeftButtonDown"
              MouseWheel="VideoBorder_OnMouseWheel">
        <Grid ClipToBounds="True">
          <playback:MpvVideoHost x:Name="VideoHost" Focusable="False" />

          <Border x:Name="MediaCenterDashboard"
                  Background="#0B1624"
                  Padding="18"
                  Panel.ZIndex="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="1280" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Start.Title}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,4,0,12" Text="{DynamicResource Start.Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" />

                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource StartSectionStyle}">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Start.ConnectedCloud}" FontSize="15" FontWeight="SemiBold" />
                      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Sources.CloudProviders}" SelectedItem="{Binding Sources.SelectedCloudProvider, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label, Converter={StaticResource LocalizedTextConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBox Grid.Column="1" Text="{Binding Sources.CloudAccountName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.CloudAccountName}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Action.ConnectAccount}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Sources.ConnectCloudCommand}" IsEnabled="{Binding Sources.RcloneAvailable}"/>
                      </Grid>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
