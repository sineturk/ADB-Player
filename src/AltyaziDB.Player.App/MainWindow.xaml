                          <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{DynamicResource Home.AddShare}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" Text="{DynamicResource Home.AddShare.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                          </StackPanel>
                          <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Margin="3,0,3,3" Text="{DynamicResource Home.Field.OptionalName}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding PublicLinkName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.LinkName}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Margin="3,0,3,3" Text="{DynamicResource Home.Field.ShareUrl}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding PublicLinkUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.PublicLink}"/></StackPanel>
                          </Grid>
                          <Button Grid.Column="2" MinWidth="130" VerticalAlignment="Bottom" Content="{DynamicResource Action.Connect}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenPublicLinkCommand}"/>
                        </Grid>
                      </Border>

                      <Border Style="{StaticResource StartSectionStyle}">
                        <StackPanel>
                          <TextBlock Text="{DynamicResource Home.AddNetwork}" FontSize="16" FontWeight="SemiBold"/>
                          <TextBlock Margin="0,4,0,8" Text="{DynamicResource Home.AddNetwork.Help}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
