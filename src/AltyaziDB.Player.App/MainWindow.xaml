                          <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Margin="3,0,3,3" Text="{DynamicResource Home.Field.Service}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><ComboBox ItemsSource="{Binding CloudProviders}" SelectedItem="{Binding SelectedCloudProvider, Mode=TwoWay}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Margin="3,0,3,3" Text="{DynamicResource Home.Field.DisplayName}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/><TextBox Text="{Binding CloudAccountName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.CloudAccountName}"/></StackPanel>
