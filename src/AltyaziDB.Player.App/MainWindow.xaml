                          <DataTemplate>
                            <Border Style="{StaticResource ConnectionCardStyle}">
                              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="#173A55" VerticalAlignment="Top"><TextBlock Text="↗" Foreground="{StaticResource BrandBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="7,1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,3,0,0" Text="{Binding Provider}" Foreground="{StaticResource BrandBrush}" FontSize="11.5"/><TextBlock Margin="0,2,0,0" Text="{Binding Detail, Converter={StaticResource LocalizedTextConverter}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,2,0,0" Text="{Binding Url}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel Grid.Column="2"><Button Content="{DynamicResource Action.Open}" Style="{StaticResource ConnectionActionButtonStyle}" Click="SavedLinkCard_OnClick"/><Button Content="{DynamicResource Action.Remove}" Style="{StaticResource ConnectionActionButtonStyle}" Click="SavedLinkRemove_OnClick"/></StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource HomeSectionStyle}">
                    <StackPanel>
                      <TextBlock Margin="4,0,4,7" Text="{DynamicResource Home.NetworkLocations}" FontSize="16" FontWeight="SemiBold"/>
