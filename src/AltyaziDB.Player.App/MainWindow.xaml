                                <StackPanel Grid.Column="2"><Button Content="{DynamicResource Action.Open}" Style="{StaticResource ConnectionActionButtonStyle}" Click="CloudAccountCard_OnClick"/><Button Content="{DynamicResource Action.Disconnect}" Style="{StaticResource ConnectionActionButtonStyle}" Click="CloudAccountRemove_OnClick"/></StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource HomeSectionStyle}">
