                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Style="{StaticResource StartSectionStyle}">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Button Content="{DynamicResource Action.Back}" Command="{Binding Sources.BackCommand}" IsEnabled="{Binding Sources.CanGoBack}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Sources.BrowserTitle, Converter={StaticResource LocalizedTextConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                      <Button Grid.Column="2" Content="{DynamicResource Action.Refresh}" Command="{Binding Sources.RefreshCommand}"/>
                    </Grid>
                    <ListBox x:Name="DashboardRemoteSourcesList" Grid.Row="1" ItemsSource="{Binding Sources.Items}" SelectedItem="{Binding Sources.SelectedItem, Mode=TwoWay}" MouseDoubleClick="RemoteSourcesList_OnMouseDoubleClick">
                      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding KindLabel, Converter={StaticResource LocalizedTextConverter}}" FontSize="11.5" Foreground="{StaticResource BrandBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SizeLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="{DynamicResource Action.OpenVideo}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Sources.OpenSelectedCommand}"/><Button Content="{DynamicResource Action.AttachSubtitle}" Command="{Binding Sources.AttachSelectedSubtitleCommand}"/><Button Content="{DynamicResource Action.AttachAudio}" Command="{Binding Sources.AttachSelectedAudioCommand}"/></StackPanel>
                    <TextBlock Grid.Row="3" Margin="4" Text="{Binding Sources.StatusText, Converter={StaticResource UserFacingTextConverter}}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>

        </Grid>
      </Border>

