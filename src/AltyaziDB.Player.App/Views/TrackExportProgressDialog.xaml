<Window x:Class="AltyaziDB.Player.App.Views.TrackExportProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="465" MinWidth="400" SizeToContent="Height" MaxHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent">
  <Border Background="{StaticResource WindowBrush}" BorderBrush="#285B73"
          BorderThickness="1" CornerRadius="16" Padding="23">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="6"
                        Opacity="0.38" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="{DynamicResource Player.TrackExport.Title}"
                 Foreground="{StaticResource MutedTextBrush}"
                 FontSize="12" Margin="0,0,0,6"/>
      <TextBlock x:Name="StateText" FontSize="17" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
      <ProgressBar x:Name="ExportProgress" Margin="0,22,0,7"
                   Minimum="0" Maximum="100" Height="9"
                   Background="#152A3B" Foreground="{StaticResource BrandBrush}"
                   IsIndeterminate="True"/>
      <TextBlock x:Name="PercentText" Text="…"
                 FontSize="12" HorizontalAlignment="Right"
                 Foreground="{StaticResource MutedTextBrush}"/>
      <Button x:Name="CancelButton" Margin="0,13,0,0" MinWidth="110"
              Content="{DynamicResource Player.TrackExport.ProgressCancel}"
              HorizontalAlignment="Right" Click="CancelButton_OnClick"/>
    </StackPanel>
  </Border>
</Window>
