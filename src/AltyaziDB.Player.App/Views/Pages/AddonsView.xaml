<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.AddonsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource R23AppBrush}" Foreground="{StaticResource R23TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"><Grid Margin="20,18,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Tab.Addons}" Style="{StaticResource R23PageHeading}"/><TextBlock Text="{DynamicResource R23.Page.Addons.Help}" Style="{StaticResource R23SecondaryText}" Margin="0,4,0,0"/></StackPanel></Grid><Grid Grid.Row="1" DataContext="{Binding Addons}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource R24WorkspacePanel}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{DynamicResource Addons.Addon.Title}" Style="{StaticResource R23SectionHeading}"/><TextBlock Text="{DynamicResource Addons.Addon.Help}" Style="{StaticResource R23SecondaryText}" Margin="0,7,0,18"/><TextBlock Text="{DynamicResource Addons.Field.Address}" Style="{StaticResource R23SecondaryText}"/><TextBox Text="{Binding AddonUrl, UpdateSourceTrigger=PropertyChanged}" MinHeight="43" Margin="0,6,0,12" ToolTip="{DynamicResource Addons.Addon.UrlHint}"/>
<CheckBox Content="{DynamicResource Addons.Field.AllowLocalHttp}" IsChecked="{Binding AllowLocalHttp, Mode=TwoWay}" Margin="0,8"/>
<Border Style="{StaticResource R24InsetPanel}" Margin="0,20,0,15"><StackPanel><TextBlock Text="{DynamicResource Addons.Legal.ShortText}" Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap"/><CheckBox Margin="0,9,0,0" Content="{DynamicResource Addons.Legal.Accept}" IsChecked="{Binding LegalNoticeAccepted, Mode=TwoWay}"/><CheckBox Margin="0,7,0,0" Content="{DynamicResource Addons.Legal.OwnAddon}" IsChecked="{Binding UserOwnsAddonConfirmed, Mode=TwoWay}"/></StackPanel></Border>
<Button HorizontalAlignment="Right" MinWidth="178" Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Addons.Action.Install}" Command="{Binding AddAddonCommand}"/></StackPanel></ScrollViewer></Border>
<Border Grid.Column="2" Style="{StaticResource R24WorkspacePanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Addons.Installed.Title}" Style="{StaticResource R23SectionHeading}"/><Button Grid.Column="1" Style="{StaticResource R23ToolbarButton}" Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}"/></Grid>
<ListBox Grid.Row="1" Margin="0,12,0,10" ItemsSource="{Binding Addons}" SelectedItem="{Binding SelectedAddon, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,8"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{StaticResource R23RaisedBrush}" Width="32" Height="32" CornerRadius="9"><TextBlock Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource R23CyanBrush}"/></Border><StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding SafeManifestUrl}" Style="{StaticResource R23SecondaryText}" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="●" FontSize="14" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8C9BAA"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Foreground" Value="{StaticResource R23CyanBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Row="2"><TextBlock Text="{Binding SelectedAddonStateText}" Style="{StaticResource R23SecondaryText}" Margin="0,0,0,9"/><WrapPanel HorizontalAlignment="Right"><Button Style="{StaticResource R23Button}" Content="{DynamicResource Addons.Action.Toggle}" Command="{Binding ToggleAddonCommand}" Margin="0,0,9,0"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Remove}" Command="{Binding RemoveAddonCommand}"/></WrapPanel><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Style="{StaticResource R23SecondaryText}" Margin="0,12,0,0"/></StackPanel></Grid></Border></Grid></Grid></Grid></UserControl>