<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="14">
  <Grid Margin="20,18,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,17">
      <TextBlock Text="{DynamicResource Tab.Playlist}" Style="{StaticResource R23PageHeading}"/>
      <TextBlock Text="{DynamicResource R23.Page.Playlist.Help}"
                 Style="{StaticResource R23SecondaryText}" Margin="0,5,0,0"/>
    </StackPanel>

    <Border Grid.Row="1"
            Style="{StaticResource R24WorkspacePanel}"
            MaxWidth="1170"
            HorizontalAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource R23.Playlist.Queue}"
                     Style="{StaticResource R23SectionHeading}"/>
          <CheckBox Grid.Column="1"
                    Content="{DynamicResource Panel.AutoPlayNext}"
                    IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource R24InsetPanel}" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource Cloud.Playlist.Title}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding CloudPlaylistStatus, Converter={StaticResource UserFacingTextConverter}}"
                         Style="{StaticResource R23SecondaryText}"
                         TextWrapping="Wrap"
                         Margin="0,3,0,0"/>
              <TextBlock Text="{Binding CloudPlaylistCountText}"
                         Foreground="{StaticResource R23CyanBrush}"
                         FontSize="12"
                         Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
              <Button Style="{StaticResource R23ToolbarButton}"
                      Content="{DynamicResource Cloud.Playlist.Load}"
                      Command="{Binding LoadCloudPlaylistCommand}"
                      Margin="0,0,6,0"/>
              <Button Style="{StaticResource R23ToolbarButton}"
                      Content="{DynamicResource Cloud.Playlist.SyncNow}"
                      Command="{Binding SyncPlaylistToCloudCommand}"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <ListBox x:Name="QueueList"
                   ItemsSource="{Binding Playlist}"
                   SelectedItem="{Binding SelectedPlaylistItem, Mode=TwoWay}"
                   MouseDoubleClick="Queue_OnDoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="9"
                          Background="{StaticResource R23RaisedBrush}"
                          VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource R23CyanBrush}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Text="&#xE768;"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding KindLabel, Converter={StaticResource LocalizedTextConverter}}"
                               FontSize="12"
                               Foreground="{StaticResource R23MutedBrush}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Text="{DynamicResource Action.Play}"
                             Foreground="{StaticResource R23CyanBrush}"
                             VerticalAlignment="Center"
                             Margin="16,0,4,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      MaxWidth="390">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Playlist.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Style="{StaticResource R24EmptyIcon}" HorizontalAlignment="Center">
              <TextBlock Text="&#xE93C;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="23"
                         Foreground="{StaticResource R23CyanBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{DynamicResource R24.Playlist.EmptyTitle}"
                       Style="{StaticResource R23SectionHeading}"
                       Margin="0,14,0,6"
                       TextAlignment="Center"/>
            <TextBlock Text="{DynamicResource R24.Playlist.EmptyHelp}"
                       Style="{StaticResource R23SecondaryText}"
                       TextAlignment="Center"
                       MaxWidth="350"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Playlist.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button Style="{StaticResource R23PrimaryButton}"
                  Content="{DynamicResource Action.Play}"
                  Command="{Binding PlaySelectedCommand}"
                  Margin="0,0,8,8"/>
          <Button Style="{StaticResource R23Button}"
                  Content="{DynamicResource Action.Remove}"
                  Command="{Binding RemoveSelectedCommand}"
                  Margin="0,0,8,8"/>
          <Button Style="{StaticResource R23Button}"
                  Content="{DynamicResource Action.Clear}"
                  Command="{Binding ClearPlaylistCommand}"
                  Margin="0,0,8,8"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
