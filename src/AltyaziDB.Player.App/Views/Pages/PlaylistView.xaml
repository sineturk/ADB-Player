<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="14" SizeChanged="Queue_OnSizeChanged"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="20,16,22,20">
    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border x:Name="QueueWorkspace" Grid.Row="0"
            Style="{StaticResource R5PlaylistWorkspace}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- P4.4: queue controls live beside the title, not in an empty hero. -->
        <Grid x:Name="QueueHeaderLayout" Grid.Row="0" Margin="1,0,1,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="QueueHeaderSecondRow" Height="0"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="QueueHeaderActionsColumn" Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource R23.Playlist.Queue}"
                       Style="{StaticResource R23SectionHeading}" FontSize="21"/>
            <TextBlock Text="{DynamicResource R5.Playlist.QueueHelp}"
                       Style="{StaticResource R23SecondaryText}" Margin="0,4,12,0"/>
          </StackPanel>
          <StackPanel x:Name="QueueHeaderRight" Grid.Column="1" Grid.Row="0"
                      Orientation="Horizontal" VerticalAlignment="Center"
                      HorizontalAlignment="Right">
            <Border Style="{StaticResource R24StatusPill}"
                    Margin="0,0,10,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Playlist.Count}"
                           Foreground="{StaticResource R23CyanBrush}"
                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource R5.Playlist.Items}"
                           Style="{StaticResource R23SecondaryText}"/>
              </StackPanel>
            </Border>
            <Border Background="#C10C1D2C" BorderBrush="#42637A"
                    BorderThickness="1" CornerRadius="10"
                    Padding="11,8" VerticalAlignment="Center">
              <CheckBox Content="{DynamicResource Panel.AutoPlayNext}"
                        IsChecked="{Binding AutoPlayNext, Mode=TwoWay}"
                        AutomationProperties.Name="{DynamicResource Panel.AutoPlayNext}"/>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Cloud status is displayed faithfully, not a fabricated sync-success badge. -->
        <Border Grid.Row="1" Style="{StaticResource R5PlaylistCloud}"
                Margin="0,0,0,13">
          <Grid x:Name="QueueCloudLayout">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="QueueCloudActionsRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition x:Name="QueueCloudActionsColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                           FontSize="16" Foreground="{StaticResource R23CyanBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Cloud.Playlist.Title}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{Binding CloudPlaylistStatus, Converter={StaticResource UserFacingTextConverter}}"
                         Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap"
                         Margin="0,6,0,0"/>
              <TextBlock Text="{Binding CloudPlaylistCountText}"
                         Foreground="{StaticResource R23CyanBrush}"
                         FontSize="11.5" Margin="0,5,0,0"/>
            </StackPanel>
            <WrapPanel x:Name="QueueCloudActions" Grid.Row="0" Grid.Column="1"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="10,0,0,0">
              <Button Style="{StaticResource R23ToolbarButton}"
                      Content="{DynamicResource Cloud.Playlist.Load}"
                      Command="{Binding LoadCloudPlaylistCommand}"
                      MinHeight="37" Padding="12,7" Margin="0,0,7,0"/>
              <Button Style="{StaticResource R23ToolbarButton}"
                      Content="{DynamicResource Cloud.Playlist.SyncNow}"
                      Command="{Binding SyncPlaylistToCloudCommand}"
                      MinHeight="37" Padding="12,7"/>
            </WrapPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource R24InsetPanel}"
                Background="#B6102030" Padding="10,7" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                         Foreground="{StaticResource R23CyanBrush}"
                         Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource R5.Playlist.ListHeading}"
                         FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{DynamicResource R5.Playlist.PlayHint}"
                       Style="{StaticResource R23SecondaryText}"
                       FontSize="11.5" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Grid x:Name="QueueListRegion" Grid.Row="3" MinHeight="140">
          <ListBox x:Name="QueueList" ItemsSource="{Binding Playlist}"
                   SelectedItem="{Binding SelectedPlaylistItem, Mode=TwoWay}"
                   MouseDoubleClick="Queue_OnDoubleClick"
                   KeyDown="Queue_OnKeyDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="{DynamicResource R5.Playlist.QueueAccessLabel}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,2,9"/>
                <Setter Property="ToolTip" Value="{Binding Title}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="QueueRowBorder"
                              Background="#142638" BorderBrush="#304D64"
                              BorderThickness="1" CornerRadius="11"
                              Padding="11,9" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="QueueRowBorder" Property="Background" Value="#1A354A"/>
                          <Setter TargetName="QueueRowBorder" Property="BorderBrush" Value="#5F8DA7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="QueueRowBorder" Property="Background" Value="#1A4059"/>
                          <Setter TargetName="QueueRowBorder" Property="BorderBrush"
                                  Value="{StaticResource R23CyanBrush}"/>
                          <Setter TargetName="QueueRowBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="QueueRowBorder" Property="BorderBrush" Value="#E5F7FF"/>
                          <Setter TargetName="QueueRowBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="66">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="49"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="39" Height="39"
                          Background="#102E43" BorderBrush="#426984"
                          BorderThickness="1" CornerRadius="10"
                          VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource R23CyanBrush}" FontSize="18"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,14,0">
                    <TextBlock Text="{Binding Title}" FontSize="13.5"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource R23TextBrush}"
                               ToolTip="{Binding Title}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                      <Border Background="#152D40" BorderBrush="#39546D"
                              BorderThickness="1" CornerRadius="6"
                              Padding="7,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontFamily="Segoe MDL2 Assets"
                                     FontSize="11" Margin="0,0,5,0"
                                     Foreground="{StaticResource R23CyanBrush}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE753;"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                    <Setter Property="Text" Value="&#xE8B7;"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding KindLabel, Converter={StaticResource LocalizedTextConverter}}"
                                     Foreground="{StaticResource R23CyanBrush}" FontSize="11"/>
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding DisplaySource}" FontSize="10.5"
                                 Foreground="{StaticResource R23MutedBrush}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 ToolTip="{Binding DisplaySource}"/>
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource R23ToolbarButton}"
                          Content="{DynamicResource Action.Play}"
                          Click="QueueItemPlay_Click"
                          MinHeight="36" Padding="12,6"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Action.Play}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      MaxWidth="390" IsHitTestVisible="False">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Playlist.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Style="{StaticResource R24EmptyIcon}" HorizontalAlignment="Center">
              <TextBlock Text="&#xE93C;" FontFamily="Segoe MDL2 Assets"
                         FontSize="25" Foreground="{StaticResource R23CyanBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{DynamicResource R24.Playlist.EmptyTitle}"
                       Style="{StaticResource R23SectionHeading}"
                       TextAlignment="Center" Margin="0,13,0,6"/>
            <TextBlock Text="{DynamicResource R24.Playlist.EmptyHelp}"
                       Style="{StaticResource R23SecondaryText}"
                       MaxWidth="360" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="4" x:Name="QueueFooter"
                Margin="0,10,0,0">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource R5PlaylistActions}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Playlist.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid x:Name="QueueFooterLayout">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="QueueFooterSecondRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition x:Name="QueueFooterActionsColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0"
                        VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource R5.Playlist.Selected}"
                         Style="{StaticResource R23SecondaryText}" FontSize="11"/>
              <TextBlock Text="{Binding SelectedPlaylistItem.Title, TargetNullValue=''}"
                         FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{StaticResource R23TextBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding SelectedPlaylistItem.Title}"/>
            </StackPanel>
            <WrapPanel x:Name="QueueFooterButtons" Grid.Row="0" Grid.Column="1"
                       VerticalAlignment="Center" HorizontalAlignment="Right">
              <Button Content="{DynamicResource Action.Play}"
                      Command="{Binding PlaySelectedCommand}"
                      Padding="14,7" MinHeight="39" Margin="0,0,8,0">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource R23PrimaryButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedPlaylistItem}" Value="{x:Null}">
                        <Setter Property="IsEnabled" Value="False"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="{DynamicResource Action.Remove}"
                      Command="{Binding RemoveSelectedCommand}"
                      Padding="12,7" MinHeight="39" Margin="0,0,8,0">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource R23Button}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedPlaylistItem}" Value="{x:Null}">
                        <Setter Property="IsEnabled" Value="False"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Style="{StaticResource R23Button}"
                      Content="{DynamicResource Action.Clear}"
                      Command="{Binding ClearPlaylistCommand}"
                      Padding="12,7" MinHeight="39"/>
            </WrapPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
