<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI">
  <Grid Margin="20,18,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="{DynamicResource Tab.Update}" Style="{StaticResource R23PageHeading}"/>
      <TextBlock Text="{DynamicResource R23.Page.Update.Help}"
                 Style="{StaticResource R23SecondaryText}"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1" DataContext="{Binding Updates}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.92*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="1.08*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource R24WorkspacePanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,6,0">
            <TextBlock Text="{DynamicResource R23.Update.Version}"
                       Style="{StaticResource R23SectionHeading}"/>

            <Border Margin="0,10,0,18"
                    Padding="16,14"
                    Background="{StaticResource R23RaisedBrush}"
                    BorderBrush="{StaticResource R23StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding CurrentVersionText}"
                             FontSize="34"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource R23TextBrush}"/>
                  <TextBlock Text="{Binding DeploymentModeText}"
                             Style="{StaticResource R23SecondaryText}"
                             Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Style="{StaticResource R24StatusPill}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                  <TextBlock Text="{Binding SelectedChannel, Converter={StaticResource UpdateChannelTextConverter}}"
                             FontSize="11"
                             Foreground="{StaticResource R23CyanBrush}"/>
                </Border>
              </Grid>
            </Border>

            <TextBlock Text="{DynamicResource Panel.UpdateChannel}"
                       Style="{StaticResource R23SecondaryText}"/>
            <ComboBox ItemsSource="{Binding Channels}"
                      SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                      IsEnabled="{Binding CanChangeUpdateSettings}"
                      MinHeight="43"
                      Margin="0,5,0,12">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource UpdateChannelTextConverter}}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox Content="{DynamicResource Panel.CheckOnStartup}"
                      IsChecked="{Binding CheckOnStartup, Mode=TwoWay}"
                      IsEnabled="{Binding CanChangeUpdateSettings}"
                      Margin="0,0,0,18"/>

            <WrapPanel>
              <Button Style="{StaticResource R23PrimaryButton}"
                      Content="{DynamicResource Action.CheckUpdate}"
                      Command="{Binding CheckCommand}"
                      Margin="0,0,8,8"/>
              <Button Content="{DynamicResource Action.DownloadInstall}"
                      Command="{Binding DownloadAndInstallCommand}"
                      Margin="0,0,8,8">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource R23Button}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </WrapPanel>

            <Grid Margin="0,8,0,10">
              <ProgressBar Height="5"
                           Maximum="100"
                           Value="{Binding DownloadProgress, Mode=OneWay}">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="IsIndeterminate" Value="False"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsBusy}" Value="True"/>
                          <Condition Binding="{Binding IsDownloading}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="IsIndeterminate" Value="True"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
            </Grid>

            <Border Style="{StaticResource R24InsetPanel}"
                    Padding="12,10"
                    Margin="0,0,0,16">
              <TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}"
                         Style="{StaticResource R23SecondaryText}"
                         TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="{DynamicResource Panel.UpdateSecurityNote}"
                       Style="{StaticResource R23SecondaryText}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource R24WorkspacePanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="{DynamicResource Panel.ReleaseNotes}"
                       Style="{StaticResource R23SectionHeading}"/>
            <TextBlock Text="{DynamicResource Update.State.ReadyHelp}"
                       Style="{StaticResource R23SecondaryText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>

          <Border Grid.Row="1"
                  Style="{StaticResource R24InsetPanel}"
                  Margin="0,12,0,14"
                  Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <TextBlock Text="{Binding ReleaseNotesDisplayText}"
                         Style="{StaticResource R23SecondaryText}"
                         TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource Panel.Diagnostics}"
                       Style="{StaticResource R23SectionHeading}"
                       Margin="0,0,0,9"/>
            <WrapPanel>
              <Button Style="{StaticResource R23Button}"
                      Content="{DynamicResource Action.CreateDiagnostics}"
                      Command="{Binding CreateDiagnosticsCommand}"
                      Margin="0,0,8,0"/>
              <Button Style="{StaticResource R23ToolbarButton}"
                      Content="{DynamicResource Action.UpdateFolder}"
                      Command="{Binding OpenUpdateFolderCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
