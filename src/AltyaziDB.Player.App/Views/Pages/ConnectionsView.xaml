<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="14">
  <Grid Margin="18,17,20,19">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,15">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{DynamicResource Tab.Connections}" Style="{StaticResource R23PageHeading}"/>
        <TextBlock Text="{DynamicResource Connections.Subtitle}" Style="{StaticResource R23SecondaryText}" Margin="0,4,0,0"/>
      </StackPanel>
      <Button Grid.Column="1"
              Style="{StaticResource R23ToolbarButton}"
              Content="{DynamicResource Action.Refresh}"
              Command="{Binding Connections.RefreshProfilesCommand}"
              VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="1" DataContext="{Binding Connections}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Master rail: saved integrations. -->
      <Border Grid.Column="0" Style="{StaticResource R24WorkspacePanel}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Connections.List.Title}"
                       Style="{StaticResource R23SectionHeading}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Style="{StaticResource R23ToolbarButton}"
                    Content="{DynamicResource Connections.Action.New}"
                    Command="{Binding NewConnectionCommand}"
                    Padding="9,5" MinHeight="30"/>
          </Grid>

          <Grid Grid.Row="1" Margin="0,12,0,10">
            <ListBox ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource R23CyanBrush}"
                               FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding LastMessage}" Style="{StaticResource R23SecondaryText}"
                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="180">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasProfiles}" Value="False">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Border Style="{StaticResource R24EmptyIcon}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{StaticResource R23CyanBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{DynamicResource R25.Connections.EmptyProfiles.Title}"
                         FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                         Margin="0,12,0,5"/>
              <TextBlock Text="{DynamicResource R25.Connections.EmptyProfiles.Help}"
                         Style="{StaticResource R23SecondaryText}" TextAlignment="Center"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding SelectedProfileStatusText, Converter={StaticResource UserFacingTextConverter}}"
                       Style="{StaticResource R23SecondaryText}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Border Style="{StaticResource R24CommandDeck}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource R23ToolbarButton}"
                        Content="{DynamicResource Connections.Action.Toggle}"
                        Command="{Binding ToggleConnectionCommand}"/>
                <Button Grid.Column="1" Style="{StaticResource R23ToolbarButton}"
                        Content="{DynamicResource Action.Remove}"
                        Command="{Binding RemoveConnectionCommand}"
                        Margin="4,0,0,0"/>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Editor: one clean vertical form with section separators instead of nested cards. -->
      <Border Grid.Column="2" Style="{StaticResource R24WorkspacePanel}" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding FormTitle}"
                         Style="{StaticResource R23SectionHeading}"
                         VerticalAlignment="Center"/>
              <Border Grid.Column="1" Style="{StaticResource R24StatusPill}"
                      VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource R23CyanBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{DynamicResource R25.Connections.Mode.New}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                          <Setter Property="Text" Value="{DynamicResource R25.Connections.Mode.Edit}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </Grid>

            <TextBlock Text="{DynamicResource R24.Connections.Section.Basic}"
                       FontWeight="SemiBold" Foreground="{StaticResource R23CyanBrush}"
                       FontSize="12" Margin="0,0,0,9"/>

            <TextBlock Text="{DynamicResource Connections.Field.Name}" Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="41" Margin="0,4,0,10"/>

            <TextBlock Text="{DynamicResource Connections.Field.Type}" Style="{StaticResource R23SecondaryText}"/>
            <ComboBox ItemsSource="{Binding ConnectionTypes}"
                      SelectedItem="{Binding SelectedConnectionType, Mode=TwoWay}"
                      MinHeight="41" Margin="0,4,0,2"/>

            <Border Style="{StaticResource R24SectionRule}"/>

            <TextBlock Text="{DynamicResource R24.Connections.Section.Server}"
                       FontWeight="SemiBold" Foreground="{StaticResource R23CyanBrush}"
                       FontSize="12" Margin="0,0,0,9"/>

            <TextBlock Text="{Binding ConnectionGuideTitle}"
                       FontWeight="SemiBold" Foreground="{StaticResource R23TextBrush}"/>
            <TextBlock Text="{Binding ConnectionGuideText}"
                       Style="{StaticResource R23SecondaryText}" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding ConnectionCredentialsText}"
                       Foreground="{StaticResource R23MutedBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>

            <Button Content="{DynamicResource Connections.Prowlarr.UseLocal}"
                    Command="{Binding UseLocalProwlarrCommand}"
                    HorizontalAlignment="Left" Margin="0,9,0,11">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource R23ToolbarButton}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProwlarrSelected}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <TextBlock Text="{DynamicResource Connections.Field.Url}" Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding BaseUrlHintText}" Margin="0,4,0,10"/>

            <TextBlock Text="{Binding ApiKeyRequirementText}" Style="{StaticResource R23SecondaryText}"/>
            <PasswordBox PasswordChanged="ApiKey_OnChanged"
                         MinHeight="42" Margin="0,4,0,9"
                         AutomationProperties.Name="Service API key"/>

            <CheckBox Content="{DynamicResource Connections.Field.AllowLocalHttp}"
                      IsChecked="{Binding AllowLocalHttp, Mode=TwoWay}"
                      Margin="0,2,0,2"/>

            <Border Style="{StaticResource R24SectionRule}"/>

            <TextBlock Text="{DynamicResource R24.Connections.Section.Categories}"
                       FontWeight="SemiBold" Foreground="{StaticResource R23CyanBrush}"
                       FontSize="12" Margin="0,0,0,9"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="{DynamicResource Connections.Field.MovieCategories}" Style="{StaticResource R23SecondaryText}"/>
                <TextBox Text="{Binding MovieCategories, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="{DynamicResource Connections.Field.SeriesCategories}" Style="{StaticResource R23SecondaryText}"/>
                <TextBox Text="{Binding SeriesCategories, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="{DynamicResource Connections.Field.AnimeCategories}" Style="{StaticResource R23SecondaryText}"/>
                <TextBox Text="{Binding AnimeCategories, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="{DynamicResource Connections.Field.OtherCategories}" Style="{StaticResource R23SecondaryText}"/>
                <TextBox Text="{Binding OtherCategories, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Connections.Field.ResultLimit}" Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding ResultLimit, UpdateSourceTrigger=LostFocus}" Margin="0,3,0,2"/>

            <Border Style="{StaticResource R24SectionRule}"/>

            <TextBlock Text="{DynamicResource R24.Connections.Section.Validation}"
                       FontWeight="SemiBold" Foreground="{StaticResource R23CyanBrush}"
                       FontSize="12" Margin="0,0,0,8"/>

            <CheckBox Content="{DynamicResource Connections.Legal.Accept}"
                      IsChecked="{Binding LegalNoticeAccepted, Mode=TwoWay}" Margin="0,4"/>
            <CheckBox Content="{DynamicResource Connections.Legal.OwnService}"
                      IsChecked="{Binding UserOwnsServiceConfirmed, Mode=TwoWay}" Margin="0,4,0,10"/>

            <Border Style="{StaticResource R24CommandDeck}" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource R23ToolbarButton}"
                        Content="{DynamicResource Connections.Action.Test}"
                        Command="{Binding TestConnectionCommand}" Margin="0,0,4,0"/>
                <Button Style="{StaticResource R23ToolbarPrimaryButton}"
                        Content="{DynamicResource Connections.Action.Save}"
                        Command="{Binding SaveConnectionCommand}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Search workspace: visually separate from connection editing. -->
      <Border Grid.Column="4" Style="{StaticResource R24WorkspacePanel}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="{DynamicResource Connections.Releases.Title}"
                     Style="{StaticResource R23SectionHeading}"/>

          <Border Grid.Row="1" Style="{StaticResource R23Toolbar}" Margin="0,12,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding ContentFilters}"
                        SelectedItem="{Binding SelectedContentFilter, Mode=TwoWay}"
                        MinHeight="38"/>
              <TextBox Grid.Column="1"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Margin="6,0"
                       ToolTip="{DynamicResource Connections.Search.Hint}"
                       MinHeight="38"/>
              <Button Grid.Column="2"
                      Style="{StaticResource R23ToolbarPrimaryButton}"
                      Content="{DynamicResource Connections.Action.Search}"
                      Command="{Binding SearchCommand}"
                      IsEnabled="{Binding HasSearchConnections}"/>
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Releases}"
                     SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource R23SecondaryText}"
                               FontSize="11" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasReleases}" Value="False">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Border Style="{StaticResource R24EmptyIcon}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{StaticResource R23CyanBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{DynamicResource R25.Connections.EmptyReleases.Title}"
                         FontWeight="SemiBold" FontSize="15"
                         TextAlignment="Center" Margin="0,12,0,5"/>
              <TextBlock Text="{DynamicResource R25.Connections.EmptyReleases.Help}"
                         Style="{StaticResource R23SecondaryText}" TextAlignment="Center"
                         TextWrapping="Wrap"/>
              <TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}"
                         Style="{StaticResource R23SecondaryText}" TextAlignment="Center"
                         TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding ReleaseSummaryText}"
                         Style="{StaticResource R23SecondaryText}" Margin="0,0,0,4"/>
              <TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}"
                         Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource R23PrimaryButton}"
                    Content="{DynamicResource Connections.Action.PlayRelease}"
                    Command="{Binding PlayReleaseCommand}"
                    IsEnabled="{Binding HasReleases}"
                    Margin="12,0,0,0" VerticalAlignment="Bottom"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="{Binding Connections.WarningsText, Converter={StaticResource UserFacingTextConverter}}"
               Style="{StaticResource R23SecondaryText}"
               Margin="0,10,0,0" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
