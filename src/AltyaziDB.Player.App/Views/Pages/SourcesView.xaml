<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.SourcesView" x:Name="SourcesRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AltyaziDB.Player.App.Views.Pages" Background="{StaticResource R23AppBrush}" Foreground="{StaticResource R23TextBrush}" Loaded="SourcesView_OnLoaded" DataContextChanged="SourcesView_OnDataContextChanged" Unloaded="SourcesView_OnUnloaded" SizeChanged="SourcesView_OnSizeChanged" UseLayoutRounding="True" SnapsToDevicePixels="True">
<UserControl.Resources><local:SavedCloudAccountIdentityConverter x:Key="R5SourceAccountLabel"/><local:HomeSafeSourceNameConverter x:Key="R5SafeLinkName"/></UserControl.Resources>
<Grid Margin="24,22,25,21">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource R23.Sources.Title}" Style="{StaticResource R23PageHeading}" FontSize="26"/>
      <TextBlock Text="{DynamicResource R23.Sources.Help}" Style="{StaticResource R23SecondaryText}" Margin="0,5,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Style="{StaticResource R23ToolbarButton}"
            Content="{DynamicResource R23.Sources.Return}"
            Click="ReturnHome_Click" VerticalAlignment="Top"/>
  </Grid>
<Grid Grid.Row="1" DataContext="{Binding Sources}">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsBrowserVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>

<StackPanel>
  <!-- R5/P4.9: Android-style short source cards; connection forms open separately. -->
  <StackPanel Margin="0,0,0,22">
    <Grid Margin="4,0,6,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource R5.Sources.CloudGroup}"
                 Style="{StaticResource R23SectionHeading}" FontSize="19"
                 VerticalAlignment="Center"/>
      <Button Grid.Column="1" Style="{StaticResource R23ToolbarButton}"
              Content="{DynamicResource R5165.GuideButton}"
              ToolTip="{DynamicResource R5165.GuideButton}"
              Click="SourcesOpenCloudGuide_Click"/>
    </Grid>
      <UniformGrid x:Name="SourcesProviderCards" Columns="5">

          <Button Style="{StaticResource R5ProviderCard}" Tag="GoogleDrive" Click="CloudProviderCard_Click"
                  AutomationProperties.Name="Google Drive">
            <StackPanel>
              <Grid>
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                           Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock Text="Google Drive" FontWeight="SemiBold" FontSize="14"
                         Margin="0,12,0,4" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{DynamicResource R5.Sources.GoogleHelp}" FontSize="11"
                         Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource R5ProviderCard}" Tag="Dropbox" Click="CloudProviderCard_Click"
                  AutomationProperties.Name="Dropbox">
            <StackPanel>
              <Grid>
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                           Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock Text="Dropbox" FontWeight="SemiBold" FontSize="14"
                         Margin="0,12,0,4" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{DynamicResource R5.Sources.DropboxHelp}" FontSize="11"
                         Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource R5ProviderCard}" Tag="OneDrive" Click="CloudProviderCard_Click"
                  AutomationProperties.Name="OneDrive">
            <StackPanel>
              <Grid>
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                           Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock Text="OneDrive" FontWeight="SemiBold" FontSize="14"
                         Margin="0,12,0,4" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{DynamicResource R5.Sources.OneDriveHelp}" FontSize="11"
                         Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource R5ProviderCard}" Tag="PCloudEurope" Click="CloudProviderCard_Click"
                  AutomationProperties.Name="{DynamicResource R5.Sources.PCloudEuropeTitle}">
            <StackPanel>
              <Grid>
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                           Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock Text="{DynamicResource R5.Sources.PCloudEuropeTitle}" FontWeight="SemiBold" FontSize="14"
                         Margin="0,12,0,4" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{DynamicResource R5.Sources.PCloudHelp}" FontSize="11"
                         Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource R5ProviderCard}" Tag="PCloud" Click="CloudProviderCard_Click"
                  AutomationProperties.Name="{DynamicResource R5.Sources.PCloudUsTitle}">
            <StackPanel>
              <Grid>
                <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                           Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock Text="{DynamicResource R5.Sources.PCloudUsTitle}" FontWeight="SemiBold" FontSize="14"
                         Margin="0,12,0,4" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{DynamicResource R5.Sources.PCloudHelp}" FontSize="11"
                         Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>

      </UniformGrid>
    <TextBlock Text="{DynamicResource R5.Sources.OtherGroup}" Style="{StaticResource R23SectionHeading}"
               FontSize="19" Margin="4,20,0,10"/>
    <UniformGrid x:Name="SourcesOtherCards" Columns="3">
          <Button Style="{StaticResource R5ProviderCard}" Tag="WebDAV" Click="WebDavProviderCard_Click"
                  AutomationProperties.Name="WebDAV">
            <StackPanel>
              <Grid>
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                           Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock Text="WebDAV" FontWeight="SemiBold" FontSize="14"
                         Margin="0,12,0,4" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{DynamicResource R5.Sources.WebDavHelp}" FontSize="11"
                         Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>

      <Button Style="{StaticResource R5ProviderCard}" Tag="Telegram" Click="TelegramProviderCard_Click"
              AutomationProperties.Name="Telegram">
        <StackPanel>
          <Grid>
            <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                       Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock Text="Telegram" FontWeight="SemiBold" FontSize="14" Margin="12,11,0,3"/>
          <TextBlock Text="{DynamicResource R5.Sources.TelegramHelp}" FontSize="11"
                     Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap" Margin="12,0,0,0"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource R5ProviderCard}" Tag="SharedLink" Click="SharedLinkProviderCard_Click"
              AutomationProperties.Name="{DynamicResource R5.Sources.SharedLink}">
        <StackPanel>
          <Grid>
            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                       Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Left"/>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock Text="{DynamicResource R5.Sources.SharedLink}" FontWeight="SemiBold"
                     FontSize="14" Margin="12,11,0,3"/>
          <TextBlock Text="{DynamicResource R5.Sources.SharedLinkHelp}" FontSize="11"
                     Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap" Margin="12,0,0,0"/>
        </StackPanel>
      </Button>
    </UniformGrid>
  </StackPanel>
<StackPanel x:Name="SourcesManagerLayout">
<StackPanel x:Name="SourcesSavedSection">
    <Border Style="{StaticResource R5GlassWorkspacePanel}" Background="#0B1929" Padding="17" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="{DynamicResource R5.Sources.SavedSourcesTitle}"
                   Style="{StaticResource R23SectionHeading}" Margin="0,0,0,4"/>
        <TextBlock Text="{DynamicResource R5.Sources.SavedSourcesHelp}"
                   Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap"
                   Margin="0,0,0,12"/>
        <Expander Header="{DynamicResource R5.Sources.SearchLabel}"
                  IsExpanded="False" Margin="0,0,0,12" Foreground="{StaticResource R23TextBrush}">
          <DockPanel Margin="3,8,3,5" LastChildFill="True">
            <Button DockPanel.Dock="Right" Margin="7,0,0,0"
                    Style="{StaticResource R23ToolbarButton}"
                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                    Click="SourcesClearSearch_Click"
                    ToolTip="{DynamicResource R5.Sources.ClearSearch}"
                    AutomationProperties.Name="{DynamicResource R5.Sources.ClearSearch}"/>
            <TextBox x:Name="SourcesSearchBox" MinHeight="37"
                     TextChanged="SourcesSearchBox_OnTextChanged"
                     ToolTip="{DynamicResource R5.Sources.SearchHint}"
                     AutomationProperties.Name="{DynamicResource R5.Sources.SearchHint}"/>
          </DockPanel>
        </Expander>
        <TabControl x:Name="SourcesSavedTabs" Style="{StaticResource R5SourcesTabControl}"
                    Foreground="{StaticResource R23TextBrush}">
          <TabItem Header="{DynamicResource R5.Sources.AccountsTab}">
            <StackPanel Margin="0,12,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="390"
                            HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredCloudAccounts, ElementName=SourcesRoot}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="10" Background="#182B3E"
                              BorderBrush="#31506A" BorderThickness="1" Margin="0,0,4,7"
                              Padding="10,9">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="27"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                     Foreground="{StaticResource R23CyanBrush}"
                                     VerticalAlignment="Center" FontSize="19"/>
                          <StackPanel Grid.Column="1" Margin="3,0,5,0">
                            <TextBlock Text="{Binding Converter={StaticResource R5SourceAccountLabel}}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ProviderLabel}" FontSize="11"
                                       Foreground="{StaticResource R23MutedBrush}"/>
                          </StackPanel>
                          <Button Grid.Column="2" Style="{StaticResource R23ToolbarButton}"
                                  Click="CloudOpen_Click" Content="{DynamicResource Action.Open}"
                                  Margin="4,0" MinWidth="43"/>
                          <Button Grid.Column="3" Style="{StaticResource R23ToolbarButton}"
                                  Click="CloudDisconnect_Click" Content="&#xE74D;"
                                  FontFamily="Segoe MDL2 Assets"
                                  ToolTip="{DynamicResource Action.Disconnect}"
                                  AutomationProperties.Name="{DynamicResource Action.Disconnect}"
                                  MinWidth="33"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="{DynamicResource R5.Sources.NoSearchResults}"
                         Foreground="{StaticResource R23MutedBrush}" Margin="2,12,0,6">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding FilteredCloudAccounts.Count, ElementName=SourcesRoot}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </TabItem>
          <TabItem Header="{DynamicResource R5.Sources.LinksTab}">
            <StackPanel Margin="0,12,0,0">
              <ScrollViewer MaxHeight="410" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding FilteredSavedLinks, ElementName=SourcesRoot}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#182B3E" BorderBrush="#31506A" BorderThickness="1"
                                CornerRadius="9" Padding="9,8" Margin="0,0,4,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource R23CyanBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name, Converter={StaticResource R5SafeLinkName}}"
                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <Button Grid.Column="2" Style="{StaticResource R23ToolbarButton}"
                                    Click="LinkOpen_Click" Content="{DynamicResource Action.Open}" Margin="3,0"/>
                            <Button Grid.Column="3" Style="{StaticResource R23ToolbarButton}"
                                    Click="LinkRemove_Click" Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    ToolTip="{DynamicResource Action.Remove}"
                                    AutomationProperties.Name="{DynamicResource Action.Remove}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding FilteredWebDavProfiles, ElementName=SourcesRoot}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#182B3E" BorderBrush="#31506A" BorderThickness="1"
                                CornerRadius="9" Padding="9,8" Margin="0,0,4,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource R23CyanBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name, Converter={StaticResource R5SafeLinkName}}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="2,0,4,0"/>
                            <Button Grid.Column="2" Style="{StaticResource R23ToolbarButton}"
                                    Click="WebDavOpen_Click" Content="{DynamicResource Action.Open}" Margin="3,0"/>
                            <Button Grid.Column="3" Style="{StaticResource R23ToolbarButton}"
                                    Click="WebDavRemove_Click" Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    ToolTip="{DynamicResource Action.Remove}"
                                    AutomationProperties.Name="{DynamicResource Action.Remove}"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <TextBlock Text="{DynamicResource R5.Sources.NoConnectionResults}"
                         Foreground="{StaticResource R23MutedBrush}" Margin="2,12,0,6">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding FilteredSavedLinks.Count, ElementName=SourcesRoot}" Value="0"/>
                          <Condition Binding="{Binding FilteredWebDavProfiles.Count, ElementName=SourcesRoot}" Value="0"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </Border>
  </StackPanel>

  
</StackPanel>
</StackPanel></ScrollViewer>
<Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBrowserVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource R23Button}" Content="{DynamicResource Home.Connections}" Command="{Binding ShowConnectionsHomeCommand}" Margin="0,0,9,0"/><Button Grid.Column="1" Style="{StaticResource R23Button}" Content="{DynamicResource Action.Back}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"/><TextBlock Grid.Column="2" Text="{Binding BrowserTitle, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource R23SectionHeading}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="3" Style="{StaticResource R23ToolbarButton}" Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}"/></Grid>
<Border Grid.Row="1" Style="{StaticResource R5GlassWorkspacePanel}"><ListBox x:Name="SourceBrowserItems" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" MouseDoubleClick="Browser_OnDoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,9"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource R23CyanBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding KindLabel, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource R23SecondaryText}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Style="{StaticResource R23SecondaryText}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Style="{StaticResource R23PrimaryButton}" Content="{Binding BrowserActionText, Converter={StaticResource LocalizedTextConverter}}" Command="{Binding OpenSelectedCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.AttachSubtitle}" Command="{Binding AttachSelectedSubtitleCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.AttachAudio}" Command="{Binding AttachSelectedAudioCommand}"/></StackPanel></Grid></Grid>
  <Grid x:Name="SourcesProviderOverlay" Grid.RowSpan="2" Panel.ZIndex="30"
        Background="#ED02080F" Visibility="Collapsed"
        DataContext="{Binding Sources}" PreviewKeyDown="SourcesProviderOverlay_OnPreviewKeyDown">
    <Border Width="495" MaxWidth="560" MaxHeight="530" HorizontalAlignment="Center" VerticalAlignment="Center"
            Style="{StaticResource R5GlassWorkspacePanel}" Margin="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10,4,10,6">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                    HorizontalAlignment="Right" Style="{StaticResource R23ToolbarButton}"
                    Click="SourcesProviderCancel_Click"
                    ToolTip="{DynamicResource R5.Sources.CancelLogin}"/>
            <TextBlock x:Name="SourcesProviderTitle" FontSize="23" FontWeight="SemiBold"
                       Text="{DynamicResource R5.Sources.ProviderTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="SourcesProviderDescription"
                     Text="{DynamicResource R5.Sources.SecureBrowserHelp}"
                     Style="{StaticResource R23SecondaryText}"
                     Margin="0,7,0,13" TextWrapping="Wrap"/>
          <StackPanel x:Name="SourcesOAuthProviderFields">
            <TextBlock x:Name="SourcesOAuthCredentialStatus"
                       Text="{DynamicResource R5164.BYOC.Checking}"
                       Foreground="{StaticResource R23CyanBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Expander x:Name="SourcesOAuthExpander"
                      Header="{DynamicResource R5165.Credentials}"
                      Foreground="{StaticResource R23TextBrush}" Margin="0,0,0,14">
              <StackPanel Margin="3,7,3,2">
                <TextBlock Text="{DynamicResource R5.Sources.OAuthClientId}"
                           Style="{StaticResource R23SecondaryText}"/>
                <TextBox x:Name="SourcesOAuthClientId" MinHeight="40" Margin="0,5,0,10"
                         AutomationProperties.Name="{DynamicResource R5.Sources.OAuthClientId}"/>
                <TextBlock Text="{DynamicResource R5.Sources.OAuthClientSecret}"
                           Style="{StaticResource R23SecondaryText}"/>
                <PasswordBox x:Name="SourcesOAuthClientSecret" MinHeight="40" Margin="0,5,0,0"
                             AutomationProperties.Name="{DynamicResource R5.Sources.OAuthClientSecret}"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="{DynamicResource R5.Sources.AccountLabel}"
                       Style="{StaticResource R23SecondaryText}"/>
            <TextBox x:Name="SourcesProviderAccountName"
                     Text="{Binding CloudAccountName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{DynamicResource R5.Sources.AccountLabel}"
                     MinHeight="40" Margin="0,5,0,6"/>
            <Button Content="{DynamicResource R5.Sources.ConnectProvider}"
                    Style="{StaticResource R23PrimaryButton}" Margin="0,12,0,0"
                    MinHeight="42" Click="SourcesProviderConfirm_Click"/>
            <!-- R5/P3.4: a state-bearing localhost URL is never printed in UI. -->
            <StackPanel Margin="0,12,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CanOpenOAuthBrowser}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Border Style="{StaticResource R24InsetPanel}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource R5.Sources.BrowserFallbackTitle}"
                             FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding OAuthBrowserStatusText, Converter={StaticResource UserFacingTextConverter}}" Margin="0,6,0,0"
                             Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="{DynamicResource R5.Sources.OpenInBrowser}"
                            Style="{StaticResource R23ToolbarButton}"
                            Click="SourcesOpenOAuthBrowser_Click" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource R5.Sources.CopyAuthLink}"
                            Style="{StaticResource R23ToolbarButton}"
                            Click="SourcesCopyOAuthLink_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="SourcesWebDavProviderFields" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource R5.Sources.WebDavName}" Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding WebDavName, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" Margin="0,5,0,9"/>
            <TextBlock Text="{DynamicResource R5.Sources.WebDavUrl}" Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" Margin="0,5,0,9"/>
            <TextBlock Text="{DynamicResource R5.Sources.WebDavUsername}" Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" Margin="0,5,0,9"/>
            <TextBlock Text="{DynamicResource R5.Sources.WebDavPassword}" Style="{StaticResource R23SecondaryText}"/>
            <PasswordBox x:Name="SourcesWebDavCardPassword" MinHeight="40" Margin="0,5,0,9"
                         PasswordChanged="WebDavCardPassword_OnChanged"
                         AutomationProperties.Name="{DynamicResource R5.Sources.WebDavPassword}"/>
            <TextBlock Text="{DynamicResource R5.Sources.WebDavSecurity}"
                       Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
            <Button Content="{DynamicResource R5.Sources.ConnectProvider}" Style="{StaticResource R23PrimaryButton}"
                    Click="SourcesWebDavConfirm_Click" Margin="0,15,0,0" MinHeight="42"
                    IsEnabled="True"/>
          </StackPanel>
          <StackPanel x:Name="SourcesLinkProviderFields" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource R5.Sources.LinkUrlLabel}"
                       Style="{StaticResource R23SecondaryText}"/>
            <TextBox x:Name="SourcesLinkUrlBox" Text="{Binding PublicLinkUrl, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="42" Margin="0,5,0,12"
                     ToolTip="{DynamicResource Tooltip.PublicLink}"/>
            <TextBlock Text="{DynamicResource R5.Sources.LinkNameLabel}"
                       Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding PublicLinkName, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="42" Margin="0,5,0,15"
                     ToolTip="{DynamicResource R23.Sources.NameHint}"/>
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="{DynamicResource Action.Open}" Style="{StaticResource R23ToolbarButton}"
                      Command="{Binding OpenPublicLinkCommand}" Margin="0,0,9,0" MinHeight="41"/>
              <Button Content="{DynamicResource R23.Sources.Save}" Style="{StaticResource R23PrimaryButton}"
                      Command="{Binding SavePublicLinkCommand}" MinHeight="41"/>
            </WrapPanel>
          </StackPanel>
          <TextBlock Text="{Binding CloudConnectErrorText, Converter={StaticResource UserFacingTextConverter}}"
                     Foreground="#FFB88A" Margin="0,11,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasCloudConnectError}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}"
                     Margin="0,7,0,0" Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsBusy}" Value="True"/>
                      <Condition Binding="{Binding HasCloudConnectError}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
  <!-- R5/P4.16.5: optional guide is separate from the fast connect sheet.
       No provider secret, OAuth URL or stored token is ever displayed here. -->
  <Grid x:Name="SourcesCloudGuideOverlay" Grid.RowSpan="2" Panel.ZIndex="45"
        Visibility="Collapsed" Background="#E6030A13"
        PreviewKeyDown="SourcesCloudGuideOverlay_OnPreviewKeyDown">
    <Border Width="650" MaxWidth="690" MaxHeight="580"
            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"
            Style="{StaticResource R5GlassWorkspacePanel}">
      <Grid Margin="15,11,15,13">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
          <Button DockPanel.Dock="Right" Style="{StaticResource R23ToolbarButton}"
                  Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                  ToolTip="{DynamicResource Action.Close}"
                  Click="SourcesCloseCloudGuide_Click"/>
          <TextBlock Text="{DynamicResource R5165.GuideTitle}"
                     FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,11">
          <Button Style="{StaticResource R23ToolbarButton}" Content="Google Drive" Tag="GoogleDrive"
                  Margin="0,0,6,0" Click="SourcesGuideProvider_Click"/>
          <Button Style="{StaticResource R23ToolbarButton}" Content="Dropbox" Tag="Dropbox"
                  Margin="0,0,6,0" Click="SourcesGuideProvider_Click"/>
          <Button Style="{StaticResource R23ToolbarButton}" Content="OneDrive" Tag="OneDrive"
                  Margin="0,0,6,0" Click="SourcesGuideProvider_Click"/>
          <Button Style="{StaticResource R23ToolbarButton}" Content="pCloud" Tag="PCloud"
                  Click="SourcesGuideProvider_Click"/>
        </UniformGrid>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="2,3,10,6">
            <TextBlock x:Name="SourcesGuideProviderTitle" FontSize="17"
                       FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBlock x:Name="SourcesGuideIntro" TextWrapping="Wrap"
                       Foreground="{StaticResource R23MutedBrush}" Margin="0,0,0,14"/>
            <TextBlock x:Name="SourcesGuideStep1" TextWrapping="Wrap" Margin="0,0,0,11"/>
            <TextBlock x:Name="SourcesGuideStep2" TextWrapping="Wrap" Margin="0,0,0,11"/>
            <TextBlock x:Name="SourcesGuideStep3" TextWrapping="Wrap" Margin="0,0,0,13"/>
            <Border Style="{StaticResource R24InsetPanel}" Margin="0,0,0,4">
              <TextBlock x:Name="SourcesGuideNote" TextWrapping="Wrap"
                         Foreground="{StaticResource R23MutedBrush}"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,14,0,0">
          <Button DockPanel.Dock="Left" Style="{StaticResource R23PrimaryButton}"
                  Content="{DynamicResource R5165.GuideOfficial}"
                  Click="SourcesGuideOpenOfficial_Click" MinHeight="39"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource R23ToolbarButton}"
                  Content="{DynamicResource Action.Close}"
                  Click="SourcesCloseCloudGuide_Click" MinHeight="39"/>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Grid></UserControl>