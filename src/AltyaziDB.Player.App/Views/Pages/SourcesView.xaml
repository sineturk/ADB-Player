<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.SourcesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource R23AppBrush}" Foreground="{StaticResource R23TextBrush}">
<Grid Margin="20,18,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource R23.Sources.Title}" Style="{StaticResource R23PageHeading}"/><TextBlock Text="{DynamicResource R23.Sources.Help}" Style="{StaticResource R23SecondaryText}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource R23Button}" Content="{DynamicResource R23.Sources.Return}" Click="ReturnHome_Click" VerticalAlignment="Center"/></Grid>
<Grid Grid.Row="1" DataContext="{Binding Sources}">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsBrowserVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0">
<Border Style="{StaticResource R24WorkspacePanel}" Margin="0,0,0,13"><StackPanel><TextBlock Text="{DynamicResource Home.CloudAccounts}" Style="{StaticResource R23SectionHeading}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding CloudAccounts}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProviderLabel}" Style="{StaticResource R23SecondaryText}"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource Action.Open}" Style="{StaticResource R23ToolbarButton}" Click="CloudOpen_Click" Margin="7,0"/><Button Grid.Column="2" Content="{DynamicResource Action.Disconnect}" Style="{StaticResource R23ToolbarButton}" Click="CloudDisconnect_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding CloudAvailabilityText}" Style="{StaticResource R23SecondaryText}" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource R24WorkspacePanel}"><StackPanel><TextBlock Text="{DynamicResource Home.SharedLinks}" Style="{StaticResource R23SectionHeading}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding SavedPublicLinks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource Action.Open}" Style="{StaticResource R23Button}" Click="LinkOpen_Click" Margin="6,0"/><Button Grid.Column="2" Content="{DynamicResource Action.Remove}" Style="{StaticResource R23ToolbarButton}" Click="LinkRemove_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding WebDavProfiles}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource Action.Open}" Style="{StaticResource R23Button}" Click="WebDavOpen_Click" Margin="6,0"/><Button Grid.Column="2" Content="{DynamicResource Action.Remove}" Style="{StaticResource R23Button}" Click="WebDavRemove_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
</StackPanel>
<StackPanel Grid.Column="2">
<Border Style="{StaticResource R24WorkspacePanel}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{DynamicResource Home.AddConnection}" Style="{StaticResource R23SectionHeading}" Margin="0,0,0,13"/><ComboBox ItemsSource="{Binding CloudProviders}" SelectedItem="{Binding SelectedCloudProvider, Mode=TwoWay}" Margin="0,0,0,8"/><TextBox Text="{Binding CloudAccountName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource R23.Sources.NameHint}" Margin="0,0,0,9"/><Button HorizontalAlignment="Right" Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.ConnectAccount}" Command="{Binding ConnectCloudCommand}" IsEnabled="{Binding RcloneAvailable}"/></StackPanel></Border>
<Border Style="{StaticResource R24WorkspacePanel}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{DynamicResource R23.Sources.SaveLink}" Style="{StaticResource R23SectionHeading}" Margin="0,0,0,13"/><TextBox Text="{Binding PublicLinkName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource R23.Sources.NameHint}" Margin="0,0,0,8"/><TextBox Text="{Binding PublicLinkUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.PublicLink}" Margin="0,0,0,9"/><WrapPanel HorizontalAlignment="Right"><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Open}" Command="{Binding OpenPublicLinkCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource R23.Sources.Save}" Command="{Binding SavePublicLinkCommand}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource R24WorkspacePanel}"><StackPanel><TextBlock Text="{DynamicResource R23.Sources.WebDav}" Style="{StaticResource R23SectionHeading}" Margin="0,0,0,12"/><TextBox Text="{Binding WebDavName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource R23.Sources.NameHint}" Margin="0,0,0,7"/><TextBox Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="WebDAV URL" Margin="0,0,0,7"/><TextBox Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource R23.Sources.UserHint}" Margin="0,0,0,7"/><PasswordBox PasswordChanged="WebDavPassword_OnChanged" MinHeight="40" AutomationProperties.Name="WebDAV password"/><Button Style="{StaticResource R23PrimaryButton}" HorizontalAlignment="Right" Content="{DynamicResource Home.Action.ConnectSave}" Command="{Binding ConnectWebDavCommand}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></Grid></ScrollViewer>
<Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBrowserVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource R23Button}" Content="{DynamicResource Home.Connections}" Command="{Binding ShowConnectionsHomeCommand}" Margin="0,0,9,0"/><Button Grid.Column="1" Style="{StaticResource R23Button}" Content="{DynamicResource Action.Back}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"/><TextBlock Grid.Column="2" Text="{Binding BrowserTitle, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource R23SectionHeading}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="3" Style="{StaticResource R23ToolbarButton}" Content="{DynamicResource Action.Refresh}" Command="{Binding RefreshCommand}"/></Grid>
<Border Grid.Row="1" Style="{StaticResource R24WorkspacePanel}"><ListBox x:Name="SourceBrowserItems" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" MouseDoubleClick="Browser_OnDoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,9"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource R23CyanBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding KindLabel, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource R23SecondaryText}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Style="{StaticResource R23SecondaryText}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Style="{StaticResource R23PrimaryButton}" Content="{Binding BrowserActionText, Converter={StaticResource LocalizedTextConverter}}" Command="{Binding OpenSelectedCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.AttachSubtitle}" Command="{Binding AttachSelectedSubtitleCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.AttachAudio}" Command="{Binding AttachSelectedAudioCommand}"/></StackPanel></Grid></Grid></Grid></UserControl>