<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.DiscoverView"
             x:Name="DiscoverRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AltyaziDB.Player.App.Views.Pages"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             Loaded="Discover_OnLoaded"
             Unloaded="Discover_OnUnloaded"
             DataContextChanged="Discover_OnDataContextChanged"
             SizeChanged="Discover_OnSizeChanged"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <local:DiscoverMediaKindConverter x:Key="R5DiscoverMediaKind"/>
    <local:DiscoverLocalizedGenreConverter x:Key="R5DiscoverGenreLocalizer"/>
  </UserControl.Resources>
  <Grid x:Name="DiscoverScene">
  <ScrollViewer x:Name="DiscoverPageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Margin="18,18,20,26" MaxWidth="1500" HorizontalAlignment="Stretch">
      <!-- P4.4: display an actual item from the loaded addon catalog.
           Do not imply a ranking when the connected addon does not provide one. -->
      <Border x:Name="DiscoverSpotlight" Height="228" Margin="0,0,0,2"
              ClipToBounds="True">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource R5GlassHeroPanel}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding FeaturedItem, ElementName=DiscoverRoot}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid DataContext="{Binding FeaturedItem, ElementName=DiscoverRoot}">
          <Image Source="{Binding BackgroundUrl}" Stretch="UniformToFill"
                 Height="228" VerticalAlignment="Top"
                 Opacity=".69" IsHitTestVisible="False"/>
          <Border IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#FF07121F" Offset="0"/>
                <GradientStop Color="#C4081625" Offset=".43"/>
                <GradientStop Color="#450A1B2D" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Height="2" VerticalAlignment="Top" Panel.ZIndex="3"
                  Background="{StaticResource R23CyanBrush}" Opacity=".75"
                  IsHitTestVisible="False"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="DiscoverFeaturedCopy"
                        Margin="32,18,22,18" VerticalAlignment="Center"
                        MaxWidth="710" HorizontalAlignment="Left">
              <TextBlock Text="{DynamicResource R5.Discover.FeaturedLabel}"
                         Foreground="{StaticResource R23CyanBrush}"
                         FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Title}" Margin="0,5,0,6"
                         FontFamily="Segoe UI Variable Display, Segoe UI"
                         FontWeight="SemiBold" FontSize="32" MaxHeight="74"
                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                <TextBlock Text="{Binding YearLabel}"
                           Foreground="#B4D6EA" FontSize="12" Margin="0,0,13,0"/>
                <TextBlock
                           Foreground="#B4D6EA" FontSize="12"
                           MaxWidth="430" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource R5DiscoverGenreLocalizer}">
                            <Binding Path="GenreLabel"/>
                            <Binding ElementName="DiscoverRoot" Path="LanguageRevision"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
              </StackPanel>
              <TextBlock x:Name="DiscoverFeaturedDescription"
                         Text="{Binding FeaturedOverview, ElementName=DiscoverRoot}" Foreground="#C8DDED"
                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                         FontSize="14" MaxHeight="60" MaxWidth="650"
                         Margin="0,0,0,11"/>
              <WrapPanel Orientation="Horizontal">
                <Button Content="{DynamicResource R5.Discover.DetailsAction}"
                        Style="{StaticResource R23PrimaryButton}"
                        Click="DiscoverFeaturedDetails_Click"
                        MinHeight="35" Padding="16,6" Margin="0,0,10,4"/>
                <Button x:Name="DiscoverReadMoreButton"
                        Content="{DynamicResource R5.Discover.ReadMore}"
                        Click="DiscoverToggleOverview_Click"
                        Style="{StaticResource R23ToolbarButton}"
                        MinHeight="35" Padding="12,6"
                        VerticalAlignment="Center" Margin="0,0,0,4"
                        Visibility="Collapsed"
                        AutomationProperties.Name="{DynamicResource R5.Discover.ReadMore}"/>
              </WrapPanel>
            </StackPanel>
            <Border x:Name="DiscoverFeaturedPoster" Grid.Column="1"
                    Margin="0,18,26,18" Width="132" Height="190"
                    VerticalAlignment="Top"
                    CornerRadius="9" BorderBrush="#5584A0"
                    BorderThickness="1" Background="#102336" ClipToBounds="True">
              <Grid>
                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                           Foreground="#426C83" FontSize="40"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"
                       IsHitTestVisible="False"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Original catalog search/filter/refresh bindings preserved. -->
      <Border Style="{StaticResource R5DiscoverToolbar}" Margin="0,15,0,20"
              Background="#091624" BorderBrush="#1D364B" BorderThickness="1">
        <Grid x:Name="DiscoverSearchLayout">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="DiscoverSearchSecondRow" Height="0"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="DiscoverSearchHost" Grid.Row="0" Grid.Column="0" Margin="0,0,9,0">
            <TextBox x:Name="CatalogSearchBox" MinHeight="44" Padding="41,8,40,8"
                     Text="{Binding Addons.SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Discover.SearchHint}"
                     AutomationProperties.Name="{DynamicResource R5.Discover.SearchLabel}"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"/>
            <TextBlock Text="{DynamicResource R23.Discover.SearchPlaceholder}"
                       Foreground="{StaticResource R23MutedBrush}" FontSize="13"
                       VerticalAlignment="Center" Margin="41,0,40,0" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=CatalogSearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="8,5" Margin="0,0,5,0"
                    Click="DiscoverClearSearch_Click"
                    ToolTip="{DynamicResource R5.Discover.ClearSearch}"
                    AutomationProperties.Name="{DynamicResource R5.Discover.ClearSearch}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource R23ToolbarButton}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Addons.SearchText}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </Grid>
          <ComboBox x:Name="DiscoverTypeFilter" Grid.Row="0" Grid.Column="1"
                    MinHeight="44" Margin="0,0,9,0"
                    ItemsSource="{Binding Addons.Filters}"
                    SelectedItem="{Binding Addons.SelectedFilter, Mode=TwoWay}"
                    AutomationProperties.Name="{DynamicResource R5.Discover.FilterLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label, Converter={StaticResource LocalizedTextConverter}}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button x:Name="DiscoverRefreshButton" Grid.Row="0" Grid.Column="2"
                  Style="{StaticResource R23ToolbarButton}"
                  Command="{Binding Addons.RefreshCommand}"
                  Content="{DynamicResource Action.Refresh}" MinHeight="44" Padding="14,8"
                  AutomationProperties.Name="{DynamicResource Action.Refresh}"/>
        </Grid>
      </Border>

      <!-- P4.6: live counts are condensed into the catalog heading below. -->



      <!-- Bounded viewport: outer page scroll and internal poster paging stay independent. -->
      <Grid x:Name="DiscoverCatalogLayout" Height="685">
        <Border x:Name="DiscoverCatalogSurface"
                Style="{StaticResource R5DiscoverCatalogPanel}" Background="Transparent"
                BorderBrush="Transparent" BorderThickness="0" Padding="1,0,0,0">
          <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="3,0,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="1,0,10,0">
                <TextBlock Text="{DynamicResource R23.Discover.Featured}" Style="{StaticResource R23SectionHeading}"
                           FontSize="22" FontWeight="SemiBold" Foreground="#E7F7FF"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="{Binding Addons.Items.Count}" FontSize="12" FontWeight="SemiBold"
                             Margin="0,0,5,0" Foreground="{StaticResource R23CyanBrush}"/>
                  <TextBlock Text="{DynamicResource R5.Discover.ResultCount}" Style="{StaticResource R23SecondaryText}"/>
                </StackPanel>
                <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                  <StackPanel Orientation="Horizontal" Margin="0,0,13,0">
                    <TextBlock Text="{Binding Addons.MovieCount}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#B1D9ED" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource R23.Discover.Movies}" FontSize="11.5"
                               Foreground="{StaticResource R23MutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,13,0">
                    <TextBlock Text="{Binding Addons.SeriesCount}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#B1D9ED" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource R23.Discover.Series}" FontSize="11.5"
                               Foreground="{StaticResource R23MutedBrush}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Addons.AnimeCount}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#B1D9ED" Margin="0,0,4,0"/>
                    <TextBlock Text="{DynamicResource R5.Discover.Anime}" FontSize="11.5"
                               Foreground="{StaticResource R23MutedBrush}"/>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource R23ToolbarButton}"
                      Content="{DynamicResource Discover.Action.ManageAddons}"
                      Click="ManageAddons_Click" Padding="12,6" MinHeight="35"/>
            </Grid>
            <Grid>
              <ListBox x:Name="CatalogList"
                       ItemsSource="{Binding ElementName=DiscoverRoot, Path=VisibleItems}"
                       SelectedItem="{Binding Addons.SelectedItem, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.ScrollChanged="Catalog_OnScrollChanged"
                       PreviewMouseLeftButtonUp="Catalog_OnPreviewMouseLeftButtonUp"
                       KeyDown="Catalog_OnKeyDown">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="166"/>
                    <Setter Property="Margin" Value="0,0,8,14"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="ToolTip" Value="{Binding Title}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                    <Setter Property="AutomationProperties.HelpText"
                            Value="{DynamicResource R5.Discover.CardHint}"/>
                    <EventSetter Event="MouseEnter" Handler="CatalogCard_OnMouseEnter"/>
                    <EventSetter Event="MouseLeave" Handler="CatalogCard_OnMouseLeave"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Card" Background="Transparent"
                                  BorderBrush="Transparent" BorderThickness="1"
                                  CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="3"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Card" Property="Background" Value="#12273A"/>
                              <Setter TargetName="Card" Property="BorderBrush" Value="#477F9F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource R23CyanBrush}"/>
                              <Setter TargetName="Card" Property="Background" Value="#102A3F"/>
                              <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                              <Setter TargetName="Card" Property="Effect">
                                <Setter.Value>
                                  <DropShadowEffect Color="#25B9EB" BlurRadius="17" ShadowDepth="0" Opacity=".23"/>
                                </Setter.Value>
                              </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter TargetName="Card" Property="BorderBrush" Value="#E5F7FF"/>
                              <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <!-- No artwork match: render a branded fallback, never another film's poster. -->
                      <Border Width="152" Height="228" Background="#0F2232"
                              CornerRadius="9" ClipToBounds="True">
                        <Grid>
                          <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                     FontSize="40" Foreground="#4D7F98" Opacity=".55"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False"/>
                          <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"
                                 IsHitTestVisible="False"/>
                          <Border Height="35" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000B1825" Offset="0"/>
                                <GradientStop Color="#C80B1825" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <Border Background="#D10A1B2C" BorderBrush="#486C86"
                                  BorderThickness="1" CornerRadius="5" Padding="7,3"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="7" IsHitTestVisible="False">
                            <TextBlock Text="{Binding ContentType, Converter={StaticResource R5DiscoverMediaKind}}"
                                       Foreground="{StaticResource R23CyanBrush}"
                                       FontWeight="SemiBold" FontSize="10.5"/>
                          </Border>
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Title}" Width="152" Margin="1,8,0,0"
                                 TextTrimming="CharacterEllipsis" Foreground="{StaticResource R23TextBrush}"
                                 FontSize="13.5" FontWeight="SemiBold"/>
                      <StackPanel Orientation="Horizontal" Margin="1,3,0,0" Width="152">
                        <TextBlock Text="{Binding YearLabel}" Foreground="{StaticResource R23MutedBrush}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Width="152" Margin="1,2,0,3"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="#8AAAC0" FontSize="11">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource R5DiscoverGenreLocalizer}">
                            <Binding Path="GenreLabel"/>
                            <Binding ElementName="DiscoverRoot" Path="LanguageRevision"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                          MaxWidth="350" IsHitTestVisible="False">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Addons.IsBusy}" Value="True"/>
                          <Condition Binding="{Binding Addons.HasItems}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource R24EmptyIcon}" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                             Foreground="{StaticResource R23CyanBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource R5.Discover.Loading}" FontSize="15"
                           FontWeight="SemiBold" Margin="0,14,0,4" TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource R5.Discover.LoadingHelp}"
                           Style="{StaticResource R23SecondaryText}" TextAlignment="Center"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Addons.HasItems}" Value="False"/>
                          <Condition Binding="{Binding Addons.IsBusy}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource R24EmptyIcon}" HorizontalAlignment="Center">
                  <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                             Foreground="{StaticResource R23CyanBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource Discover.Empty}" Margin="0,14,0,5"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource R23TextBrush}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{DynamicResource R25.Discover.EmptyHelp}"
                           Style="{StaticResource R23SecondaryText}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Style="{StaticResource R23ToolbarButton}"
                        Content="{DynamicResource Discover.Action.ManageAddons}"
                        Click="ManageAddons_Click"
                        HorizontalAlignment="Center" Margin="0,13,0,0"/>
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>

      </Grid>
    </StackPanel>
  </ScrollViewer>

  <!-- R5/P4.7: Discover-local modal, fully independent from poster catalog layout. -->
  <Grid x:Name="DiscoverModalOverlay" Panel.ZIndex="50" Visibility="Collapsed"
        Background="#DE030913" PreviewKeyDown="DiscoverModal_PreviewKeyDown"
        MouseLeftButtonDown="DiscoverModalOverlay_MouseLeftButtonDown"
        AutomationProperties.Name="{DynamicResource R5.Discover.DetailsHeader}">
    <Border x:Name="DiscoverModalCard" Width="1040" Height="750"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#0A1522" BorderBrush="#426780" BorderThickness="1"
            CornerRadius="15" ClipToBounds="True"
            FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="DiscoverModalHero" Grid.Row="0" Height="250" ClipToBounds="True">
          <Image x:Name="DiscoverModalBackdrop" Source="{Binding Addons.SelectedItem.BackgroundUrl}"
                 Height="250" VerticalAlignment="Top" Stretch="UniformToFill" Opacity=".78"
                 IsHitTestVisible="False"/>
          <Border IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#FF07121F" Offset="0"/>
                <GradientStop Color="#E007121F" Offset=".40"/>
                <GradientStop Color="#69091625" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border VerticalAlignment="Bottom" Height="90" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#000A1522" Offset="0"/>
                <GradientStop Color="#FF0A1522" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="34,38,20,24" VerticalAlignment="Bottom"
                        HorizontalAlignment="Left" MaxWidth="660">
              <TextBlock Text="{DynamicResource R5.Discover.DetailsHeader}"
                         Foreground="{StaticResource R23CyanBrush}"
                         FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="{Binding Addons.SelectedItem.Title}" FontSize="36"
                         FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="100"
                         Foreground="#F2FAFF" Margin="0,0,0,9"/>
              <TextBlock FontSize="13" Foreground="#B8DCED" TextWrapping="Wrap">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource R5DiscoverGenreLocalizer}">
                    <Binding Path="Addons.SelectedItemMetadata"/>
                    <Binding ElementName="DiscoverRoot" Path="LanguageRevision"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
            <Border x:Name="DiscoverModalPoster" Grid.Column="1"
                    Width="142" Height="213" Margin="0,35,38,18"
                    VerticalAlignment="Bottom" Background="#142435"
                    CornerRadius="10" BorderBrush="#68859D"
                    BorderThickness="1" ClipToBounds="True">
              <Image Source="{Binding Addons.SelectedItem.PosterUrl}"
                     Stretch="UniformToFill" IsHitTestVisible="False"/>
            </Border>
          </Grid>
          <Button x:Name="DiscoverModalCloseButton"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                  Style="{StaticResource R23ToolbarButton}" Background="#C3182A40"
                  BorderBrush="#486E89" BorderThickness="1" Padding="10,7"
                  MinHeight="38" MinWidth="38" Margin="0,14,15,0"
                  Click="CloseDetails_Click"
                  ToolTip="{DynamicResource Action.Close}"
                  AutomationProperties.Name="{DynamicResource Action.Close}"/>
        </Grid>
        <ScrollViewer x:Name="DiscoverModalScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
          <!-- P4.7.1: full-width reading and controls, no fixed 338px side rail. -->
          <Grid x:Name="DiscoverModalContent" Margin="32,18,32,27">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="DiscoverModalSynopsisPane" Grid.Row="0" Margin="0,0,0,12">
              <TextBlock Text="{DynamicResource R5.Discover.Synopsis}"
                         Foreground="{StaticResource R23CyanBrush}" FontSize="12"
                         FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="{Binding Addons.SelectedItemOverview}"
                         Foreground="#D2E3F0" FontSize="15" LineHeight="23"
                         TextWrapping="Wrap" Margin="0,0,0,13"/>
              <Border Height="1" Background="#345168" Margin="0,5,0,12"/>
              <TextBlock Text="{DynamicResource R5.Discover.ModalSourceHint}"
                         Foreground="#8EAFC4" FontSize="12.5" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="DiscoverModalActionsPane" Grid.Row="1">
              <Grid x:Name="DiscoverModalPlaybackLayout">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition x:Name="DiscoverModalPlaySecondRow" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition x:Name="DiscoverModalPlayGap" Width="16"/>
                  <ColumnDefinition x:Name="DiscoverModalPlayColumn" Width="210"/>
                </Grid.ColumnDefinitions>
<Border Grid.Row="0" Grid.Column="0" Background="#0D1C2B" BorderBrush="#24415A"
                        BorderThickness="1" CornerRadius="10" Padding="12,11"
                        Margin="0,10,0,0">
                  <StackPanel>
                <TextBlock Text="{DynamicResource R23.Discover.Episodes}"
                           Margin="0,3,0,6">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource R23SectionHeading}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Addons.HasEpisodes}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <ComboBox ItemsSource="{Binding Addons.Episodes}"
                          SelectedItem="{Binding Addons.SelectedEpisode, Mode=TwoWay}"
                          DisplayMemberPath="DisplayLabel" Margin="0,0,0,12">
                  <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Addons.HasEpisodes}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ComboBox.Style>
                </ComboBox>
                <TextBlock Text="{DynamicResource R23.Discover.AvailableStreams}"
                           Style="{StaticResource R23SectionHeading}" Margin="0,0,0,6"/>
                <!-- R5/P4.11.2a: keep release size visible in the dropdown
                     and in the collapsed selection; never infer unknown sizes. -->
                <ComboBox x:Name="DiscoverModalStreamSelector"
                          ItemsSource="{Binding Addons.Streams}"
                          SelectedItem="{Binding Addons.SelectedStream, Mode=TwoWay}"
                          MinHeight="52" MaxDropDownHeight="440"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="{DynamicResource R23.Discover.AvailableStreams}">
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                  </ComboBox.ItemContainerStyle>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="38" Margin="3,5,3,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   VerticalAlignment="Center" Foreground="#E8F4FF"
                                   FontSize="13" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="44"/>
                        <StackPanel Grid.Column="1" MinWidth="84"
                                    Margin="13,0,1,0" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                          <TextBlock Text="{Binding SizeLabel}"
                                     Foreground="#64D8FF" FontWeight="SemiBold"
                                     HorizontalAlignment="Right" FontSize="13"/>
                          <TextBlock Text="{DynamicResource R5.Discover.SizeUnknown}"
                                     Foreground="#809CB1" FontSize="11"
                                     HorizontalAlignment="Right">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SizeLabel}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding SeedersLabel}" Foreground="#8CB1C5"
                                     FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding Addons.SelectedStream.DetailLabel}"
                           Foreground="#8EBCD5" FontSize="12"
                           Margin="3,7,0,1" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Addons.SelectedStreamTransportText}"
                           Foreground="#8ECFE8" FontSize="11.5"
                           Margin="3,5,0,3" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Addons.StatusText, Converter={StaticResource UserFacingTextConverter}}"
                           Style="{StaticResource R23SecondaryText}" Margin="0,9,0,0"/>
                <TextBlock Text="{Binding Addons.WarningsText, Converter={StaticResource UserFacingTextConverter}}"
                           Foreground="#FFCD96" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
<Button x:Name="DiscoverModalPlayButton" Grid.Row="0" Grid.Column="2"
                        Margin="0,10,0,0" MinHeight="50" VerticalAlignment="Top"
                        Style="{StaticResource R23PrimaryButton}"
                        Content="{DynamicResource Discover.Action.Play}"
                        Command="{Binding Addons.PlayStreamCommand}"
                        IsEnabled="{Binding Addons.HasStreams}"/>
              </Grid>
              <!-- Live torrent progress and qBittorrent handoff are available
                   when returning from the Player, without opening Torrent tab. -->
              <!-- Always expose the download/handoff state in Discover details.
                   A not-yet-started stream or missing session must be visible as
                   an idle state, never hidden by a fragile binding trigger. -->
              <Border x:Name="DiscoverTorrentHandoffPanel"
                      Background="#102437" BorderBrush="#29506A" BorderThickness="1"
                      CornerRadius="11" Padding="14,12" Margin="0,13,0,0"
                      Visibility="Visible">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource R5.Torrent.Auto.PanelTitle}"
                               Foreground="#E5F4FD" FontSize="13" FontWeight="SemiBold"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource R23ToolbarButton}"
                            Content="{DynamicResource R5.Torrent.Auto.GoToTorrent}"
                            Command="{Binding ShowTorrentCommand}"
                            Padding="10,3" MinHeight="29"/>
                  </Grid>
                  <TextBlock Text="{Binding Torrent.DiscoverSourceTitle}"
                             Foreground="#E5F4FD" FontSize="12" TextWrapping="Wrap"
                             Margin="0,6,0,2"/>
                  <TextBlock Text="{Binding Torrent.DiscoverSourceStatusText}"
                             Foreground="#8CC7E4" FontSize="11" TextWrapping="Wrap"
                             Margin="0,0,0,3"/>
                  <TextBlock Text="{Binding Torrent.SessionTitle}" TextTrimming="CharacterEllipsis"
                             Foreground="#AFC8D8" FontSize="12" Margin="0,6,0,5"/>
                  <ProgressBar Height="5" Minimum="0" Maximum="100"
                               Value="{Binding Torrent.HandoffDisplayPercent, Mode=OneWay}"
                               Foreground="#24BFE9" Background="#244359"/>
                  <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Torrent.AutomaticHandoffStatus}"
                               Foreground="#A9D8E9" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Torrent.HandoffDisplayPercent, StringFormat={}{0:0.0}%}"
                               Foreground="#66D4F5" FontSize="12" Margin="10,0,0,0"/>
                  </Grid>
                  <TextBlock Text="{Binding Torrent.QBittorrentStatus, Converter={StaticResource UserFacingTextConverter}}"
                             Foreground="#C5DDEA" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding Torrent.QBittorrentConnectionStatus}"
                             Foreground="#70D7B3" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <!-- ADB Cloud uses the entire dialog width, not the playback column. -->
<Border Style="{StaticResource R24InsetPanel}" Margin="0,17,0,10" Padding="17,15">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource Discover.Cloud.SaveTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource R23TextBrush}"/>
                        <TextBlock Text="{DynamicResource Discover.Cloud.SaveHelp}"
                                   Style="{StaticResource R23SecondaryText}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Style="{StaticResource R23ToolbarButton}"
                              Content="{DynamicResource Discover.Cloud.BackToLists}"
                              Command="{Binding ShowCloudListsCommand}"
                              Padding="10,4"
                              MinHeight="32"
                              VerticalAlignment="Top"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Button Grid.Column="0"
                              Style="{StaticResource R23ToolbarButton}"
                              Content="{Binding Addons.FavoriteActionText}"
                              Command="{Binding Addons.ToggleFavoriteCommand}"
                              MinHeight="38"/>
                      <Button Grid.Column="2"
                              Style="{StaticResource R23ToolbarButton}"
                              Content="{Binding Addons.WatchlistActionText}"
                              Command="{Binding Addons.ToggleWatchlistCommand}"
                              MinHeight="38"/>
                    </Grid>

                    <Border Margin="0,10,0,0" Padding="10,9"
                            Background="{StaticResource R23RaisedBrush}"
                            BorderBrush="{StaticResource R23StrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Addons.HasTargetCollections}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="8"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{DynamicResource Discover.Cloud.TargetTitle}"
                                     FontWeight="SemiBold"
                                     FontSize="12.5"/>
                          <TextBlock Text="{DynamicResource Discover.Cloud.TargetHelp}"
                                     Style="{StaticResource R23SecondaryText}"
                                     TextWrapping="Wrap"
                                     Margin="0,2,0,6"/>
                          <ComboBox ItemsSource="{Binding Addons.TargetCollections}"
                                    SelectedItem="{Binding Addons.SelectedTargetCollection, Mode=TwoWay}"
                                    DisplayMemberPath="Name"
                                    MinHeight="36"
                                    AutomationProperties.Name="{DynamicResource Discover.Cloud.TargetTitle}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource R23ToolbarPrimaryButton}"
                                Content="{Binding Addons.TargetCollectionActionText}"
                                Command="{Binding Addons.AddToTargetCollectionCommand}"
                                IsEnabled="{Binding Addons.HasTargetCollection}"
                                MinHeight="36"
                                MinWidth="112"
                                VerticalAlignment="Bottom"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Grid>
</UserControl>