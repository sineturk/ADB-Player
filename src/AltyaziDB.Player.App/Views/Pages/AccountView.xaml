<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AltyaziDB.Player.App.Converters"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="14"
             Loaded="AccountView_OnLoaded"
             Unloaded="AccountView_OnUnloaded"
             DataContextChanged="AccountView_OnDataContextChanged">
  <UserControl.Resources>
    <converters:LocalizedDateTimeConverter x:Key="LocalizedDateTimeConverter"/>
  </UserControl.Resources>
  <Grid Margin="22,20,24,24"
        DataContext="{Binding Account}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{DynamicResource Account.Page.Title}" Style="{StaticResource R23PageHeading}"/>
      <TextBlock Text="{DynamicResource Account.Page.Subtitle}" Style="{StaticResource R23SecondaryText}"
                 Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <!-- Signed-out state -->
      <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource R24WorkspacePanel}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Margin="8">
          <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                  Background="#112738" BorderBrush="#2B617D" BorderThickness="1">
            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="27"
                       Foreground="{StaticResource R23CyanBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Text="{DynamicResource Account.Card.Title}" FontSize="24" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="0,14,0,5"/>
          <TextBlock Text="{DynamicResource Account.Card.Help}" Style="{StaticResource R23SecondaryText}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="20,0,20,18"/>

          <Border Margin="0,0,0,14">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource R24InsetPanel}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="{DynamicResource Account.Cloud.NotConfiguredTitle}" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource Account.Cloud.NotConfiguredHelp}"
                         Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="IsEnabled" Value="True"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Opacity" Value=".55"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>

            <StackPanel Margin="0,0,0,10">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="{DynamicResource Account.Field.Name}" Style="{StaticResource R23SecondaryText}"/>
              <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                       MinHeight="42" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource Account.Field.Email}" Style="{StaticResource R23SecondaryText}"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="42" Margin="0,4,0,10"/>

            <TextBlock Text="{DynamicResource Account.Field.Password}" Style="{StaticResource R23SecondaryText}"/>
            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_OnPasswordChanged"
                         MinHeight="42" Margin="0,4,0,10"/>

            <CheckBox Content="{DynamicResource Account.RememberMe}" IsChecked="{Binding RememberMe}"
                      Margin="0,0,0,14"/>

            <Button Content="{DynamicResource Account.Action.SignIn}"
                    Command="{Binding SignInCommand}" MinHeight="42">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource R23ToolbarPrimaryButton}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <Button Content="{DynamicResource Account.Action.CreateAccount}"
                    Command="{Binding SignUpCommand}" MinHeight="42">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource R23ToolbarPrimaryButton}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <Button Style="{StaticResource R23ToolbarButton}" Command="{Binding ToggleModeCommand}"
                    Margin="0,8,0,0">
              <Button.Content>
                <TextBlock>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{DynamicResource Account.Action.NeedAccount}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                          <Setter Property="Text" Value="{DynamicResource Account.Action.HaveAccount}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Button.Content>
            </Button>
          </StackPanel>

          <TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Style="{StaticResource R23SecondaryText}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
          <ProgressBar Height="2" IsIndeterminate="True" Margin="0,9,0,0">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
        </StackPanel>
      </Border>

      <!-- Signed-in state -->
      <Grid MaxWidth="980" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource R24WorkspacePanel}">
          <StackPanel>
            <Border Width="78" Height="78" CornerRadius="39" HorizontalAlignment="Left"
                    Background="#123147" BorderBrush="#32718F" BorderThickness="1">
              <TextBlock Text="{Binding AvatarText}" FontSize="27" FontWeight="SemiBold"
                         Foreground="{StaticResource R23CyanBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding HeaderText}" FontSize="24" FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <TextBlock Text="{Binding CurrentUser.Email}" Style="{StaticResource R23SecondaryText}"/>
            <Border Style="{StaticResource R24StatusPill}" HorizontalAlignment="Left" Margin="0,13,0,0">
              <TextBlock Text="{DynamicResource Account.Status.CloudConnected}" FontSize="11.5"/>
            </Border>
            <Button Style="{StaticResource R23ToolbarButton}" Content="{DynamicResource Account.Action.SignOut}"
                    Command="{Binding SignOutCommand}" Margin="0,20,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource R24WorkspacePanel}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Account.Sync.Title}" Style="{StaticResource R23SectionHeading}"/>
                  <TextBlock Text="{DynamicResource Account.Sync.Help}" Style="{StaticResource R23SecondaryText}"
                             TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource R23ToolbarButton}"
                        Content="{DynamicResource Action.Refresh}"
                        Command="{Binding RefreshCloudCoreCommand}"
                        VerticalAlignment="Top" Margin="12,0,0,0"/>
              </Grid>

              <Border Margin="0,14,0,0">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource R24InsetPanel}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCloudCoreConfigured}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Account.CloudCore.NotConfiguredTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource Account.CloudCore.NotConfiguredHelp}"
                             Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <UniformGrid Columns="2" Margin="0,12,0,0">
                <Border Style="{StaticResource R24InsetPanel}" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Account.CloudLibrary.Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CloudLibraryCountText}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource R23CyanBrush}" Margin="0,5,0,1"/>
                    <TextBlock Text="{Binding LastCloudSyncText}" Style="{StaticResource R23SecondaryText}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource R24InsetPanel}" Margin="6,0,0,0">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Account.CloudLibrary.ContinueTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CloudContinueCountText}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource R23CyanBrush}" Margin="0,5,0,1"/>
                    <TextBlock Text="{DynamicResource Account.CloudLibrary.Privacy}" Style="{StaticResource R23SecondaryText}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <UniformGrid Columns="2" Margin="0,8,0,0">
                <Border Style="{StaticResource R24InsetPanel}" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Cloud.Collections.Favorites}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FavoriteCountText}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource R23CyanBrush}" Margin="0,5,0,1"/>
                    <TextBlock Text="{DynamicResource Account.CloudCollections.FavoritesHelp}"
                               Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource R24InsetPanel}" Margin="6,0,0,0">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Cloud.Collections.Watchlist}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding WatchlistCountText}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource R23CyanBrush}" Margin="0,5,0,1"/>
                    <TextBlock Text="{DynamicResource Account.CloudCollections.WatchlistHelp}"
                               Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border Style="{StaticResource R24InsetPanel}" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Account.CloudCollections.SectionTitle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Account.CloudCollections.SectionHelp}"
                               Style="{StaticResource R23SecondaryText}"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Style="{StaticResource R23ToolbarPrimaryButton}"
                          Content="{DynamicResource Account.CloudCollections.OpenLists}"
                          Command="{Binding DataContext.ShowCloudListsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource R24InsetPanel}" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Account.InternalApi.Title}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Account.InternalApi.Help}"
                               Style="{StaticResource R23SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,6"/>
                    <TextBlock Text="{Binding InternalApiStatusText}"
                               Style="{StaticResource R23SecondaryText}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Style="{StaticResource R23ToolbarButton}"
                          Content="{DynamicResource Account.InternalApi.Test}"
                          Command="{Binding TestInternalApiCommand}"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource R24InsetPanel}" Margin="0,14,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Account.Profile.Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource Account.Profile.Help}" Style="{StaticResource R23SecondaryText}"
                             TextWrapping="Wrap" Margin="0,3,0,9"/>
                  <TextBox Text="{Binding ProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                           MinHeight="38" MaxWidth="420" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource R23ToolbarPrimaryButton}"
                        Content="{DynamicResource Account.Profile.Save}"
                        Command="{Binding SaveProfileCommand}"
                        Margin="12,0,0,0" VerticalAlignment="Bottom"/>
              </Grid>
            </Border>

            <Grid Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Account.Devices.Title}" Style="{StaticResource R23SectionHeading}"/>
                  <TextBlock Text="{DynamicResource Account.Devices.Help}" Style="{StaticResource R23SecondaryText}"
                             TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource R24StatusPill}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DeviceCountText}" FontSize="11.5"/>
                </Border>
              </Grid>

              <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                       Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,7"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource R24InsetPanel}" Padding="12,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10"
                                Background="#112738" BorderBrush="#274D65" BorderThickness="1">
                          <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                     Foreground="{StaticResource R23CyanBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="8" Background="#153447">
                              <TextBlock Text="{DynamicResource Account.Devices.ThisDevice}" FontSize="10.5"
                                         Foreground="{StaticResource R23CyanBrush}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsCurrentDevice}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                          </StackPanel>
                          <TextBlock Style="{StaticResource R23SecondaryText}" Margin="0,3,0,0">
                            <Run Text="{Binding Platform}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding AppVersion, TargetNullValue=-}"/>
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                          <TextBlock Text="{DynamicResource Account.Devices.LastSeen}" Style="{StaticResource R23SecondaryText}"
                                     FontSize="10.5" HorizontalAlignment="Right"/>
                          <TextBlock FontSize="11.5" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource LocalizedDateTimeConverter}">
                                <Binding Path="LastSeenAt"/>
                                <Binding Path="DataContext.Account.CultureLanguageTag"
                                         RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}"/>
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Style="{StaticResource R23SecondaryText}"
                         TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="{DynamicResource Account.Devices.Remove}"
                      Command="{Binding RemoveDeviceCommand}"
                      Margin="12,0,0,0">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource R23ToolbarButton}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding SelectedDevice.IsCurrentDevice}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </Grid>
          </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
