<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.TelegramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="14">
  <Grid Margin="20,18,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,15">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{DynamicResource Tab.Telegram}" Style="{StaticResource R23PageHeading}"/>
        <TextBlock Text="{DynamicResource R23.Page.Telegram.Help}" Style="{StaticResource R23SecondaryText}" Margin="0,4,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Style="{StaticResource R24StatusPill}" VerticalAlignment="Center">
        <TextBlock Text="{Binding Telegram.AuthorizationLabel, Converter={StaticResource UserFacingTextConverter}}"
                   FontSize="11.5" Foreground="{StaticResource R23MutedBrush}"/>
      </Border>
    </Grid>

    <Grid Grid.Row="1" DataContext="{Binding Telegram}">
      <!-- Login / authorization -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" MaxHeight="590">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource R24WorkspacePanel}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLoginPanelVisible}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="&#xE122;" FontFamily="Segoe MDL2 Assets" FontSize="41"
                       Foreground="{StaticResource R23CyanBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource R23.Telegram.LoginTitle}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource R23TextBrush}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
            <TextBlock Text="{DynamicResource Panel.TelegramGuide}" Style="{StaticResource R23SecondaryText}"
                       TextAlignment="Center" Margin="0,9,0,12"/>
            <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource R23SecondaryText}"
                       TextAlignment="Center" Margin="0,0,0,8"/>

            <Button Content="{DynamicResource Settings.Api.Open}"
                    HorizontalAlignment="Center" Margin="0,0,0,8"
                    Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource R23ToolbarButton}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CredentialsConfigured}" Value="False">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>

            <Grid Margin="0,5">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPhoneEntryVisible}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" MinHeight="44"
                       ToolTip="{DynamicResource Tooltip.Phone}"/>
              <Button Grid.Column="1" Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.Connect}"
                      Command="{Binding StartCommand}" Margin="8,0,0,0"/>
            </Grid>

            <Grid Margin="0,5">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEmailEntryVisible}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.Email}"/>
              <Button Grid.Column="1" Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.Send}"
                      Command="{Binding SubmitAuthorizationCommand}"/>
            </Grid>

            <Grid Margin="0,5">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCodeEntryVisible}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.Code}"/>
              <Button Grid.Column="1" Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.Send}"
                      Command="{Binding SubmitAuthorizationCommand}"/>
            </Grid>

            <Grid Margin="0,5">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPasswordEntryVisible}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <PasswordBox PasswordChanged="TelegramPassword_OnChanged" MinHeight="43"
                           ToolTip="{DynamicResource Tooltip.TwoFactorPassword}"
                           AutomationProperties.Name="Telegram two-factor password"/>
              <Button Grid.Column="1" Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.Send}"
                      Command="{Binding SubmitAuthorizationCommand}"/>
            </Grid>

            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRegistrationEntryVisible}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.FirstName}"/>
              <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tooltip.LastName}" Margin="0,7"/>
              <Button Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.Send}" Command="{Binding SubmitAuthorizationCommand}"/>
            </StackPanel>

            <TextBlock Text="{Binding AuthorizationLabel, Converter={StaticResource UserFacingTextConverter}}"
                       Style="{StaticResource R23SecondaryText}" TextAlignment="Center" Margin="0,12"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Telegram explorer -->
      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsTelegramContentVisible}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" Height="2" Margin="0,0,0,7" IsIndeterminate="True">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Telegram chat folders -->
          <Border Grid.Column="0" Style="{StaticResource R24WorkspacePanel}" Padding="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource R23.Telegram.Folders}" Style="{StaticResource R23SectionHeading}"/>
              <ListBox Grid.Row="1" Margin="0,10,0,8"
                       ItemsSource="{Binding ChatFolders}"
                       SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                 Foreground="{StaticResource R23CyanBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="2" Style="{StaticResource R23ToolbarButton}"
                      Content="{DynamicResource Action.Logout}" Command="{Binding LogoutCommand}"
                      HorizontalAlignment="Stretch"/>
            </Grid>
          </Border>

          <!-- Chats + forum topics -->
          <Border Grid.Column="2" Style="{StaticResource R24WorkspacePanel}" Padding="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource R23.Telegram.Chats}" Style="{StaticResource R23SectionHeading}"/>
                <Button Grid.Column="1" Style="{StaticResource R23ToolbarButton}"
                        Content="↻" Command="{Binding LoadChatsCommand}"
                        ToolTip="{DynamicResource Action.Refresh}"/>
              </Grid>

              <Grid Grid.Row="1" Margin="0,9,0,8">
                <ListBox ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="2,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="42"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="#13283A" BorderBrush="#28506A" BorderThickness="1"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding AvatarText}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{StaticResource R23CyanBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{DynamicResource Telegram.Chat.Subtitle}" FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" MinWidth="24" Height="22" CornerRadius="11"
                                Background="#123247" Margin="6,0,0,0" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Visible"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding UnreadCount}" FontSize="10.5"
                                     Foreground="{StaticResource R23CyanBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="220">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Chats.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                             Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource Telegram.Empty.Chats}" Style="{StaticResource R23SecondaryText}"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>

              <Border Grid.Row="2" Margin="0,0,0,8">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource R24SectionRule}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasForumTopics}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>

              <Grid Grid.Row="3" MaxHeight="245">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasForumTopics}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource Telegram.Topics.Title}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding ForumTopics.Count}" FontSize="11"
                             Foreground="{StaticResource R23MutedBrush}" VerticalAlignment="Center"/>
                </Grid>

                <Button Grid.Row="1" Style="{StaticResource R23ToolbarButton}"
                        Content="{DynamicResource Telegram.Topics.All}"
                        Command="{Binding ShowAllTopicsCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding ForumTopics}"
                         SelectedItem="{Binding SelectedTopic, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="24"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Foreground="{StaticResource R23CyanBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding UnreadCount}" FontSize="10.5"
                                   Foreground="{StaticResource R23MutedBrush}" Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>
          </Border>

          <!-- Media workspace -->
          <Border Grid.Column="4" Style="{StaticResource R24WorkspacePanel}" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding CurrentContextTitle}" Style="{StaticResource R23SectionHeading}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding CurrentContextPath}" Style="{StaticResource R23SecondaryText}"
                             FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource R23ToolbarButton}"
                        Content="↻" Command="{Binding LoadMediaCommand}"
                        ToolTip="{DynamicResource Action.Refresh}" VerticalAlignment="Center"/>
              </Grid>

              <Border Grid.Row="1" Style="{StaticResource R23Toolbar}" Margin="0,12,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{DynamicResource R23.Telegram.Search}" MinHeight="38"/>
                  <Button Grid.Column="1" Style="{StaticResource R23ToolbarPrimaryButton}"
                          Content="{DynamicResource Telegram.Search.Current}"
                          Command="{Binding SearchCommand}" Margin="6,0,0,0"/>
                  <Button Grid.Column="2" Style="{StaticResource R23ToolbarButton}"
                          Content="{DynamicResource Telegram.Search.All}"
                          Command="{Binding GlobalSearchCommand}" Margin="4,0,0,0"/>
                </Grid>
              </Border>

              <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedia, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,7">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="38"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="#102332" BorderBrush="#24485E" BorderThickness="1"
                                VerticalAlignment="Top">
                          <TextBlock Text="▶" FontSize="11" Foreground="{StaticResource R23CyanBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                          <TextBlock Text="{Binding MetaLabel}" FontSize="11.5"
                                     Foreground="{StaticResource R23MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding DateLabel}" FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Media.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Border Style="{StaticResource R24EmptyIcon}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="{StaticResource R23CyanBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{DynamicResource Telegram.Empty.Media.Title}"
                             FontWeight="SemiBold" FontSize="15" TextAlignment="Center"
                             Margin="0,12,0,5"/>
                  <TextBlock Text="{DynamicResource Telegram.Empty.Media.Help}"
                             Style="{StaticResource R23SecondaryText}" TextAlignment="Center"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}"
                             Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis"/>
                  <ProgressBar Height="3" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource R24CommandDeck}" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource R23ToolbarPrimaryButton}"
                            Content="{Binding OpenActionText, Converter={StaticResource LocalizedTextConverter}}"
                            Command="{Binding DownloadAndOpenCommand}" Margin="0,0,5,0"/>
                    <Button Style="{StaticResource R23ToolbarButton}"
                            Content="{DynamicResource R23.Telegram.OpenFolder}"
                            Command="{Binding OpenTelegramFolderCommand}"/>
                    <Button Style="{StaticResource R23ToolbarButton}"
                            Content="{DynamicResource R23.Telegram.Repair}"
                            Command="{Binding RepairArchivePartsCommand}" Margin="4,0,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
