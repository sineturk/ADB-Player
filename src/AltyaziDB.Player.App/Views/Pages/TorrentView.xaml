<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.TorrentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource R23AppBrush}" Foreground="{StaticResource R23TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" Loaded="TorrentView_OnLoaded" Unloaded="TorrentView_OnUnloaded"><Grid Margin="20,18,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Tab.Torrent}" Style="{StaticResource R23PageHeading}"/><TextBlock Text="{DynamicResource R23.Page.Torrent.Help}" Style="{StaticResource R23SecondaryText}" Margin="0,4,0,0"/></StackPanel></Grid><Grid Grid.Row="1" DataContext="{Binding Torrent}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Style="{StaticResource R24WorkspacePanel}"><StackPanel><TextBlock Text="{DynamicResource R23.Torrent.Add}" Style="{StaticResource R23SectionHeading}"/><TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource R23SecondaryText}" Margin="0,5,0,11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding MagnetUri, UpdateSourceTrigger=PropertyChanged}" MinHeight="43" Margin="0,0,10,0" ToolTip="{DynamicResource Tooltip.Magnet}"/><Button Grid.Column="1" Style="{StaticResource R23ToolbarPrimaryButton}" Content="{DynamicResource Action.PrepareMagnet}" Command="{Binding PrepareMagnetCommand}" Margin="0,0,9,0"/><Button Grid.Column="2" Style="{StaticResource R23ToolbarButton}" Content="{DynamicResource Action.OpenTorrentFile}" Command="{Binding PrepareTorrentFileCommand}"/></Grid><CheckBox Content="{DynamicResource Panel.TorrentLegal}" IsChecked="{Binding LegalNoticeAccepted, Mode=TwoWay}" Margin="0,12,0,0"/>
<TextBlock Text="{Binding DiscoverSourceTitle}" Foreground="#D4ECF8" FontWeight="SemiBold"
           FontSize="12" TextWrapping="Wrap" Margin="3,10,3,3"/>
<TextBlock Text="{Binding DiscoverSourceStatusText}" Foreground="#9CD3E8"
           FontSize="12" TextWrapping="Wrap" Margin="3,0,3,4"/><Expander IsExpanded="False" Margin="0,14,0,0" Foreground="{StaticResource R23TextBrush}">
<Expander.Header>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{DynamicResource R5.Torrent.Qb.Header}" VerticalAlignment="Center"
               FontWeight="SemiBold"/>
    <Ellipse Width="8" Height="8" Margin="15,0,7,0" VerticalAlignment="Center">
      <Ellipse.Style>
        <Style TargetType="Ellipse">
          <Setter Property="Fill" Value="#8799AB"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="Connected">
              <Setter Property="Fill" Value="#2DCF9D"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="Checking">
              <Setter Property="Fill" Value="#F5BE59"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="Unavailable">
              <Setter Property="Fill" Value="#FF7676"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="PasswordMissing">
              <Setter Property="Fill" Value="#FF7676"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="Edited">
              <Setter Property="Fill" Value="#F5BE59"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Ellipse.Style>
    </Ellipse>
    <TextBlock Text="{Binding QBittorrentConnectionStatus}" VerticalAlignment="Center"
               FontSize="12" TextTrimming="CharacterEllipsis">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="#A9BCCD"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="Connected">
              <Setter Property="Foreground" Value="#70E4BF"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="Checking">
              <Setter Property="Foreground" Value="#FFD28A"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="Unavailable">
              <Setter Property="Foreground" Value="#FF9B9B"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding QBittorrentConnectionState}" Value="PasswordMissing">
              <Setter Property="Foreground" Value="#FF9B9B"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
</Expander.Header>
<Border Background="#0B1929" CornerRadius="10" Padding="14" Margin="0,8,0,0">
<StackPanel>
<TextBlock Text="{DynamicResource R5.Torrent.Qb.Help}" Style="{StaticResource R23SecondaryText}"
           TextWrapping="Wrap" Margin="0,0,0,12"/>
<TextBlock Text="{DynamicResource R5.Torrent.Qb.HandoffNote}" Style="{StaticResource R23SecondaryText}"
           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,10,0">
<TextBlock Text="{DynamicResource R5.Torrent.Qb.Url}" Style="{StaticResource R23SecondaryText}"/>
<TextBox Text="{Binding QBittorrentUrl, UpdateSourceTrigger=PropertyChanged}" MinHeight="39"
         Margin="0,4,0,0" AutomationProperties.Name="{DynamicResource R5.Torrent.Qb.Url}"/>
</StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,10,0">
<TextBlock Text="{DynamicResource R5.Torrent.Qb.Username}" Style="{StaticResource R23SecondaryText}"/>
<TextBox Text="{Binding QBittorrentUsername, UpdateSourceTrigger=PropertyChanged}" MinHeight="39"
         Margin="0,4,0,0" AutomationProperties.Name="{DynamicResource R5.Torrent.Qb.Username}"/>
</StackPanel>
<StackPanel Grid.Column="2">
<TextBlock Text="{DynamicResource R5.Torrent.Qb.Password}" Style="{StaticResource R23SecondaryText}"/>
<PasswordBox x:Name="QbPasswordBox" MinHeight="39" Margin="0,4,0,0"
             PasswordChanged="QbPasswordBox_PasswordChanged"
             AutomationProperties.Name="{DynamicResource R5.Torrent.Qb.Password}"/>
<TextBlock Text="{DynamicResource R5.Torrent.Qb.PasswordStored}"
           Margin="0,5,0,0" FontSize="11" Foreground="#87BCA9"
           TextWrapping="Wrap">
  <TextBlock.Style>
    <Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding QBittorrentHasSavedPassword}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </TextBlock.Style>
</TextBlock>
</StackPanel>
</Grid>
<CheckBox Content="{DynamicResource R5.Torrent.Qb.Auto}"
          IsChecked="{Binding QBittorrentAutoHandoff, Mode=TwoWay}" Margin="0,13,0,6"/>
<TextBlock Text="{DynamicResource R5.Torrent.Qb.AutoSharedFolderWarning}"
           Foreground="#FFD28A" FontSize="11" TextWrapping="Wrap"
           Margin="2,0,0,8">
  <TextBlock.Style>
    <Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding QBittorrentAutoHandoffRestricted}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </TextBlock.Style>
</TextBlock>
<StackPanel Orientation="Horizontal">
<Button Style="{StaticResource R23ToolbarPrimaryButton}"
        Content="{DynamicResource R5.Torrent.Qb.Save}"
        Command="{Binding SaveQBittorrentCommand}" MinHeight="38"/>
<Button Style="{StaticResource R23ToolbarButton}" Margin="10,0,0,0"
        Content="{DynamicResource R5.Torrent.Qb.Recheck}"
        Command="{Binding CheckQBittorrentCommand}" MinHeight="38"/>
</StackPanel>
</StackPanel></Border>
</Expander>
<TextBlock Text="{Binding AutomaticHandoffStatus}"
           Foreground="#A2D4E6" FontSize="12" TextWrapping="Wrap"
           Margin="8,7,0,0"/>
</StackPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource R24WorkspacePanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SessionTitle, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource R23SectionHeading}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" Foreground="{StaticResource R23CyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid><ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,13,0,17"/>
<ListBox Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Style="{StaticResource R23SecondaryText}" Margin="12,0,0,0"/></Grid><ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource R24WorkspacePanel}"><StackPanel><TextBlock Text="{DynamicResource R23.Torrent.Controls}" Style="{StaticResource R23SectionHeading}"/><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Style="{StaticResource R23SecondaryText}" Margin="0,9,0,21"/><Button Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.PlaySelected}" Command="{Binding StartSelectedCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Pause}" Command="{Binding PauseCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Resume}" Command="{Binding ResumeCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Close}" Command="{Binding RemoveCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}"
        Content="{DynamicResource R5.Torrent.Qb.Transfer}"
        Command="{Binding TransferToQBittorrentCommand}" Margin="0,6,0,6"/>
<Button Style="{StaticResource R23ToolbarPrimaryButton}"
        Content="{DynamicResource R5.Torrent.Smart.Button}"
        Command="{Binding SmartHandoffCommand}" Margin="0,2,0,9"
        ToolTip="{DynamicResource R5.Torrent.Smart.Hint}"/>
<TextBlock Text="{Binding QBittorrentStatus, Converter={StaticResource UserFacingTextConverter}}"
           Style="{StaticResource R23SecondaryText}" TextWrapping="Wrap" Margin="2,0,0,13"/>
<Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.OpenCache}" Command="{Binding OpenCacheCommand}" Margin="0,0,0,9"/></StackPanel></Border></Grid></Grid></Grid></Grid></UserControl>