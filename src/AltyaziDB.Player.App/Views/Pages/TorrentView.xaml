<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.TorrentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource R23AppBrush}" Foreground="{StaticResource R23TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"><Grid Margin="20,18,22,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Tab.Torrent}" Style="{StaticResource R23PageHeading}"/><TextBlock Text="{DynamicResource R23.Page.Torrent.Help}" Style="{StaticResource R23SecondaryText}" Margin="0,4,0,0"/></StackPanel></Grid><Grid Grid.Row="1" DataContext="{Binding Torrent}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Style="{StaticResource R24WorkspacePanel}"><StackPanel><TextBlock Text="{DynamicResource R23.Torrent.Add}" Style="{StaticResource R23SectionHeading}"/><TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource R23SecondaryText}" Margin="0,5,0,11"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding MagnetUri, UpdateSourceTrigger=PropertyChanged}" MinHeight="43" Margin="0,0,10,0" ToolTip="{DynamicResource Tooltip.Magnet}"/><Button Grid.Column="1" Style="{StaticResource R23ToolbarPrimaryButton}" Content="{DynamicResource Action.PrepareMagnet}" Command="{Binding PrepareMagnetCommand}" Margin="0,0,9,0"/><Button Grid.Column="2" Style="{StaticResource R23ToolbarButton}" Content="{DynamicResource Action.OpenTorrentFile}" Command="{Binding PrepareTorrentFileCommand}"/></Grid><CheckBox Content="{DynamicResource Panel.TorrentLegal}" IsChecked="{Binding LegalNoticeAccepted, Mode=TwoWay}" Margin="0,12,0,0"/></StackPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource R24WorkspacePanel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SessionTitle, Converter={StaticResource LocalizedTextConverter}}" Style="{StaticResource R23SectionHeading}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" Foreground="{StaticResource R23CyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid><ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,13,0,17"/>
<ListBox Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Style="{StaticResource R23SecondaryText}" Margin="12,0,0,0"/></Grid><ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
<Border Grid.Column="2" Style="{StaticResource R24WorkspacePanel}"><StackPanel><TextBlock Text="{DynamicResource R23.Torrent.Controls}" Style="{StaticResource R23SectionHeading}"/><TextBlock Text="{Binding StatusText, Converter={StaticResource UserFacingTextConverter}}" Style="{StaticResource R23SecondaryText}" Margin="0,9,0,21"/><Button Style="{StaticResource R23PrimaryButton}" Content="{DynamicResource Action.PlaySelected}" Command="{Binding StartSelectedCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Pause}" Command="{Binding PauseCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Resume}" Command="{Binding ResumeCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.Close}" Command="{Binding RemoveCommand}" Margin="0,0,0,9"/><Button Style="{StaticResource R23Button}" Content="{DynamicResource Action.OpenCache}" Command="{Binding OpenCacheCommand}" Margin="0,0,0,9"/></StackPanel></Border></Grid></Grid></Grid></Grid></UserControl>