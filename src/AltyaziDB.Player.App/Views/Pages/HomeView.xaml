<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.HomeView"
             x:Name="HomeRoot"
             xmlns:local="clr-namespace:AltyaziDB.Player.App.Views.Pages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             Loaded="HomeView_OnLoaded"
             DataContextChanged="HomeView_OnDataContextChanged"
             Unloaded="HomeView_OnUnloaded"
             SizeChanged="HomeView_OnSizeChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <local:HomeEpisodeLabelConverter x:Key="R5EpisodeLabel"/>
    <local:HomeSafeSourceNameConverter x:Key="R5SafeSourceName"/>
    <!-- P4.16: quiet cinematic controls, no stacked blue glow or shifting shadows. -->
    <Style x:Key="R516HeroButton" TargetType="{x:Type Button}">
      <Setter Property="Height" Value="42"/>
      <Setter Property="MinWidth" Value="132"/>
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F1F8FE"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="HeroButtonSurface" CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeroButtonSurface" Property="BorderBrush" Value="#91DAF4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HeroButtonSurface" Property="Opacity" Value=".85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="HeroButtonSurface" Property="Opacity" Value=".42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="R516HeroPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource R516HeroButton}">
      <Setter Property="Background" Value="#167FBB"/>
      <Setter Property="BorderBrush" Value="#449CC9"/>
    </Style>
    <Style x:Key="R516HeroSecondary" TargetType="{x:Type Button}" BasedOn="{StaticResource R516HeroButton}">
      <Setter Property="Background" Value="#142431"/>
      <Setter Property="BorderBrush" Value="#365368"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Margin="20,16,22,24" MaxWidth="1480" HorizontalAlignment="Stretch">
      <!-- R5/P0: featured media is bound to the existing resume collection, never a mock title. -->
      <Border x:Name="HomeHero" Height="252" Style="{StaticResource R5GlassHeroPanel}" ClipToBounds="True">
        <Grid>
          <Border Height="2" VerticalAlignment="Top" IsHitTestVisible="False"
                  Panel.ZIndex="2" Opacity=".65">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#9037D6FF" Offset="0"/>
                <GradientStop Color="#2937D6FF" Offset=".55"/>
                <GradientStop Color="#0037D6FF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <ContentControl Content="{Binding ContinueWatching[0]}" HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch">
            <ContentControl.Style>
              <Style TargetType="{x:Type ContentControl}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ContinueWatching.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <Grid ClipToBounds="True">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                  </Grid.ColumnDefinitions>
                  <Image Grid.ColumnSpan="2" Source="{Binding BackdropUrl}" Stretch="UniformToFill"
                         Opacity=".52" IsHitTestVisible="False"/>
                  <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#F5070C14" Offset="0"/>
                        <GradientStop Color="#E808111C" Offset=".48"/>
                        <GradientStop Color="#AF07121F" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="30,12,6,12">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource R5.Home.Featured}" FontSize="12"
                                 FontWeight="SemiBold" Foreground="{StaticResource R23CyanBrush}"/>
                      <TextBlock Text="{Binding SourceKindKey, Converter={StaticResource LocalizedTextConverter}}"
                                 FontSize="11" Foreground="#A2BED0" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="32"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="88" Margin="0,6,0,4"/>
                    <TextBlock Text="{Binding EpisodeLabel}"
                               FontSize="13" Foreground="{StaticResource R23MutedBrush}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="13"
                               Foreground="{StaticResource R23MutedBrush}" Margin="0,7,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBlock Text="{DynamicResource R5.Home.Remaining}"
                                 Foreground="{StaticResource R23MutedBrush}" FontSize="12" Margin="0,0,5,0"/>
                      <TextBlock Text="{Binding RemainingTimeText}"
                                 Foreground="{StaticResource R23MutedBrush}" FontSize="12" Margin="0,0,12,0"/>
                      <TextBlock Text="{Binding ProgressPercentText}"
                                 Foreground="{StaticResource R23CyanBrush}" FontSize="12"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                 Height="4" Background="#29445B"
                                 Foreground="{StaticResource R23CyanBrush}" BorderThickness="0"
                                 MaxWidth="360" HorizontalAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                      <Button Content="{DynamicResource R5.Home.Resume}"
                              Click="Resume_Click" Style="{StaticResource R516HeroPrimary}"
                              MinWidth="132" Margin="0,0,9,0"/>
                      <Button Content="{DynamicResource R23.Home.ViewHistory}"
                              Click="OpenHistory_Click" Style="{StaticResource R516HeroSecondary}"
                              MinWidth="118"/>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" Width="132" Height="191" VerticalAlignment="Center"
                          HorizontalAlignment="Center" CornerRadius="9"
                          Background="#172838" BorderBrush="#507CC1D6" BorderThickness="1">
                    <Grid ClipToBounds="True">
                      <!-- Shipped artwork remains visible when metadata is absent or an image URL fails. -->
                      <Image Source="/ADB.Player;component/Assets/app_icon.png"
                             Width="74" Height="74" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False" Opacity=".32"/>
                      <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"/>
                    </Grid>
                  </Border>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
          <!-- First-run state only: hidden completely as soon as a resumable title exists. -->
          <Grid>
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ContinueWatching.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Border IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="#FF081521" Offset="0"/>
                  <GradientStop Color="#FF091925" Offset=".58"/>
                  <GradientStop Color="#FF0B2332" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border x:Name="HomeEmptyHeroBrandCard" Width="206" Height="132"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,36,0" IsHitTestVisible="False"
                    Background="#102638" BorderBrush="#31556C" BorderThickness="1"
                    CornerRadius="16">
              <Image Source="/ADB.Player;component/Assets/logo.png"
                     Width="172" Height="86" Stretch="Uniform" Opacity=".92"/>
            </Border>
            <StackPanel x:Name="HomeEmptyHeroCopy" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Margin="30,8,245,8">
              <TextBlock Text="{DynamicResource R23.Home.Kicker}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{StaticResource R23CyanBrush}"/>
              <TextBlock Text="{DynamicResource R23.Home.Headline}" FontSize="30"
                         FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"
                         Foreground="White" TextWrapping="Wrap" Margin="0,6,0,8"/>
              <TextBlock Text="{DynamicResource R23.Home.Description}" FontSize="13"
                         Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Style="{StaticResource R516HeroPrimary}" MinWidth="132" Margin="0,0,9,0"
                        Command="{Binding OpenFileCommand}" Content="{DynamicResource Action.OpenFile}"/>
                <Button Style="{StaticResource R516HeroSecondary}" MinWidth="132"
                        Command="{Binding OpenUrlCommand}" Content="{DynamicResource Action.OpenUrl}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <TextBlock Style="{StaticResource R23SectionHeading}" Margin="0,12,0,8"
                 Text="{DynamicResource R23.Home.QuickActions}"/>
      <UniformGrid x:Name="HomeQuickActions" Columns="5">
        <Button Style="{StaticResource R5GlassQuickButton}" Width="Auto" Margin="0,0,8,8"
                Command="{Binding OpenFileCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource R5.Home.QuickFile}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R5GlassQuickButton}" Width="Auto" Margin="0,0,8,8"
                Click="OpenSources_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource R5.Home.QuickCloud}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R5GlassQuickButton}" Width="Auto" Margin="0,0,8,8"
                Click="ToggleWebLink_Click"
                ToolTip="{DynamicResource R23.Home.WebHint}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource R5.Home.QuickLink}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R5GlassQuickButton}" Width="Auto" Margin="0,0,8,8"
                Command="{Binding ShowTorrentCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Tab.Torrent}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R5GlassQuickButton}" Width="Auto" Margin="0,0,8,8"
                Command="{Binding ShowTelegramCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE122;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Tab.Telegram}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </UniformGrid>

      <Grid Margin="0,13,0,8">
        <TextBlock Style="{StaticResource R23SectionHeading}"
                   Text="{DynamicResource Home.ContinueWatching}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource R23RailNavButton}"
                  Margin="0,0,6,0"
                  Content="&#x2039;" Click="ResumePrevious_Click"
                  ToolTip="{DynamicResource R23.Home.Previous}"
                  AutomationProperties.Name="{DynamicResource R23.Home.Previous}"/>
          <Button Style="{StaticResource R23RailNavButton}"
                  Margin="0,0,10,0"
                  Content="&#x203A;" Click="ResumeNext_Click"
                  ToolTip="{DynamicResource R23.Home.Next}"
                  AutomationProperties.Name="{DynamicResource R23.Home.Next}"/>
          <Button Style="{StaticResource R23ToolbarButton}"
                  Content="{DynamicResource R23.Home.ViewHistory}"
                  Click="OpenHistory_Click" MinHeight="30" Padding="10,4"/>
        </StackPanel>
      </Grid>
      <Grid>
        <ScrollViewer x:Name="ResumeScroll" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Hidden" PanningMode="HorizontalOnly"
                      CanContentScroll="False" PreviewMouseWheel="ResumeScroll_OnPreviewMouseWheel">
          <ItemsControl ItemsSource="{Binding ResumeGroups, ElementName=HomeRoot}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="252" Margin="0,0,12,0">
                  <Button Width="252" Height="221" Padding="0"
                          Click="Resume_Click" Style="{StaticResource R5GlassMediaCardButton}"
                          MouseEnter="HomeCard_OnMouseEnter" MouseLeave="HomeCard_OnMouseLeave"
                          AutomationProperties.HelpText="{DynamicResource R5.Home.ResumeHint}"
                          ToolTip="{Binding Latest.Title}" AutomationProperties.Name="{Binding Latest.Title}">
                    <Border Width="248" Height="217" CornerRadius="12"
                            Background="{StaticResource R23CardBrush}"
                            BorderBrush="{StaticResource R23StrokeBrush}" BorderThickness="1">
                      <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="139"/>
                          <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ClipToBounds="True">
                          <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Color="#274158" Offset="0"/>
                              <GradientStop Color="#0A1520" Offset="1"/>
                            </LinearGradientBrush>
                          </Grid.Background>
                          <!-- Branded default: never leave Telegram, local or cloud cards blank. -->
                          <Image Source="/ADB.Player;component/Assets/app_icon.png"
                                 Width="64" Height="64" Stretch="Uniform"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsHitTestVisible="False" Opacity=".30"/>
                          <!-- Artwork belongs to the actual resume item, never a random match. -->
                          <Image Source="{Binding Latest.ArtworkUrl}" Stretch="UniformToFill"/>
                          <Image Source="{Binding Latest.BackdropUrl}" Stretch="UniformToFill"/>
                          <Border Background="#3002070D"/>
                          <Border Width="38" Height="38" CornerRadius="19"
                                  Background="#CF06111D" BorderBrush="#8052DFFF" BorderThickness="1"
                                  VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Border>
                          <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="9" Padding="7,3" CornerRadius="5"
                                  Background="#DF071826">
                            <TextBlock Text="{Binding Latest.SourceKindKey, Converter={StaticResource LocalizedTextConverter}}"
                                       FontSize="11" Foreground="{StaticResource R23CyanBrush}"
                                       FontWeight="SemiBold"/>
                          </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="11,6,11,6">
                          <TextBlock Text="{Binding Latest.DisplayTitle}"
                                     FontSize="13" FontWeight="SemiBold"
                                     Foreground="{StaticResource R23TextBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                          <DockPanel Margin="0,3,0,3" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Latest.EpisodeLabel}"
                                       FontSize="11" Foreground="{StaticResource R23CyanBrush}"
                                       Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding Latest.ProgressText}" FontSize="11"
                                       Foreground="{StaticResource R23MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                          </DockPanel>
                          <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Latest.ProgressPercentText}"
                                       FontSize="10.5" Foreground="{StaticResource R23CyanBrush}"/>
                            <TextBlock Text="{DynamicResource R5.Home.Remaining}" FontSize="10.5"
                                       Foreground="{StaticResource R23MutedBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Latest.RemainingTimeText}" FontSize="10.5"
                                       Foreground="{StaticResource R23MutedBrush}"/>
                          </DockPanel>
                          <ProgressBar Value="{Binding Latest.ProgressPercent, Mode=OneWay}" Maximum="100"
                                       Height="4" BorderThickness="0"
                                       Foreground="{StaticResource R23CyanBrush}"
                                       Background="#28516D"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Button>
                  <!-- Only groups with more than one resumable item show an episode picker. -->
                  <Button Margin="0,4,0,0" MinHeight="28" Click="ShowGroupEpisodes_Click"
                          ToolTip="{DynamicResource R5.Home.SelectEpisode}"
                          AutomationProperties.Name="{DynamicResource R5.Home.SelectEpisode}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource R23ToolbarButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasEpisodeChoices}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource R5.Home.Episodes}"/>
                      <TextBlock Text="{Binding ChoiceCountText}" Margin="6,0,0,0"
                                 Foreground="{StaticResource R23CyanBrush}"/>
                      <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                 Margin="9,0,0,0" Foreground="{StaticResource R23CyanBrush}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{DynamicResource Home.ContinueWatching.Empty}" Margin="9">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource R23SecondaryText}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ContinueWatching.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>



      <!-- P4.15.2 / P1: Telegram discoveries belong in Home, never
           inside the selected chat's media pane. Preview is session-scoped. -->
      <Grid Margin="0,17,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource R5.TelegramHub.HomeTitle}"
                     Style="{StaticResource R23SectionHeading}"/>
          <TextBlock Text="{DynamicResource R5.TelegramHub.HomeHelp}"
                     Style="{StaticResource R23SecondaryText}" Margin="0,4,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" HorizontalAlignment="Right"
                VerticalAlignment="Center" Margin="10,0,0,0"
                Style="{StaticResource R24MiniManageButton}"
                Content="{DynamicResource Telegram.Hub.OpenHub}"
                Command="{Binding ShowTelegramHubCommand}"/>
        <Button Grid.Column="2" HorizontalAlignment="Right"
                VerticalAlignment="Center" Margin="7,0,0,0"
                Style="{StaticResource R24MiniManageButton}"
                Content="{DynamicResource R5.TelegramHub.OpenTelegram}"
                Command="{Binding ShowTelegramCommand}"/>
      </Grid>
      <Grid x:Name="HomeTelegramLayout">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="HomeTelegramFirstColumn" Width="*"/>
          <ColumnDefinition x:Name="HomeTelegramGapColumn" Width="14"/>
          <ColumnDefinition x:Name="HomeTelegramSecondColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource R5GlassHomePanel}" MinHeight="170">
          <StackPanel>
            <TextBlock Text="{DynamicResource R5.TelegramHub.RecentTitle}"
                       Style="{StaticResource R23SectionHeading}"/>
            <ItemsControl ItemsSource="{Binding TelegramRecentPreview, ElementName=HomeRoot}"
                          Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource R5GlassSourceButton}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,5"
                          Click="OpenTelegramRecent_Click"
                          ToolTip="{Binding FileName}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="▶" Foreground="{StaticResource R23CyanBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                   FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ChatTitle}" FontSize="10.5"
                                   Foreground="{StaticResource R23MutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{DynamicResource R5.TelegramHub.RecentEmpty}"
                       Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"
                       Margin="2,10,0,2">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TelegramRecentPreview.Count, ElementName=HomeRoot}"
                                 Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
        <Border x:Name="HomeTelegramFavoritesPanel" Grid.Column="2"
                Style="{StaticResource R5GlassHomePanel}" MinHeight="170">
          <StackPanel>
            <TextBlock Text="{DynamicResource R5.TelegramHub.FavoritesTitle}"
                       Style="{StaticResource R23SectionHeading}"/>
            <ItemsControl ItemsSource="{Binding TelegramFavoritePreview, ElementName=HomeRoot}"
                          Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource R5GlassSourceButton}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,5"
                          Click="OpenTelegramFavorite_Click"
                          ToolTip="{Binding Title}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="★" Foreground="{StaticResource R23CyanBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                 FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{DynamicResource R5.TelegramHub.FavoritesEmpty}"
                       Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap"
                       Margin="2,10,0,2">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TelegramFavoritePreview.Count, ElementName=HomeRoot}"
                                 Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="WebLinkPanel"
              Style="{StaticResource R23Panel}"
              Margin="0,12,0,13"
              Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource Panel.WebLink}" Style="{StaticResource R23SectionHeading}"/>
              <TextBlock Text="{DynamicResource R23.Home.WebHint}"
                         Style="{StaticResource R23SecondaryText}" Margin="0,3,0,10"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource R23ToolbarButton}"
                    Content="✕"
                    Click="CloseWebLink_Click"
                    Padding="10,4"
                    MinHeight="30"
                    ToolTip="{DynamicResource Action.Close}"
                    AutomationProperties.Name="{DynamicResource Action.Close}"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="WebLinkUrlBox"
                     MinHeight="42"
                     Margin="0,0,10,0"
                     Text="{Binding Sources.PublicLinkUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Tooltip.PublicLink}"
                     AutomationProperties.Name="{DynamicResource Panel.WebLink}"/>
            <Button Grid.Column="1" MinWidth="160" Style="{StaticResource R23PrimaryButton}"
                    Content="{DynamicResource Action.ResolvePlay}"
                    Command="{Binding Sources.OpenPublicLinkCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource R23SectionHeading}" Margin="0,16,0,9"
                 Text="{DynamicResource R5.Home.MySources}"/>
      <!-- P2: small, privacy-safe shortcut summaries. Full records remain in SourcesView. -->
      <Grid x:Name="HomeSourcesLayout">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="HomeSourcesFirstColumn" Width="*"/>
          <ColumnDefinition x:Name="HomeSourcesGapColumn" Width="14"/>
          <ColumnDefinition x:Name="HomeSourcesSecondColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource R5GlassHomePanel}" MinHeight="184">
          <StackPanel>
            <Grid>
              <TextBlock Text="{DynamicResource R5.Home.CloudPreview}"
                         Style="{StaticResource R23SectionHeading}"/>
              <Button HorizontalAlignment="Right" Style="{StaticResource R24MiniManageButton}"
                      Content="{DynamicResource R5.Home.ViewAll}" Click="OpenSources_Click"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding CloudPreview, ElementName=HomeRoot}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource R5GlassSourceButton}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,5"
                          Click="OpenCloud_Click" ToolTip="{DynamicResource R5.Home.OpenCloud}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding ProviderGlyph}" FontFamily="Segoe MDL2 Assets"
                                 Foreground="{StaticResource R23CyanBrush}" FontSize="18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding ProviderLabel}" FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}"
                                     TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                          <TextBlock Text=" · " FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}"/>
                          <TextBlock Text="{Binding RuntimeStatus}" FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{DynamicResource Home.EmptyCloud}" Margin="2,10,0,4"
                       Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CloudPreview.Count, ElementName=HomeRoot}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
        <Border x:Name="HomeConnectionsPanel" Grid.Column="2" Style="{StaticResource R5GlassHomePanel}" MinHeight="184">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource R23SectionHeading}"
                         Text="{DynamicResource R5.Home.LinkPreview}"/>
              <Button HorizontalAlignment="Right" Style="{StaticResource R24MiniManageButton}"
                      Content="{DynamicResource R5.Home.ViewAll}" Click="OpenSources_Click"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding ConnectionPreview, ElementName=HomeRoot}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource R5GlassSourceButton}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,5"
                          Click="OpenConnection_Click" ToolTip="{DynamicResource R5.Home.OpenSaved}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding ProviderGlyph}" FontFamily="Segoe MDL2 Assets"
                                 FontSize="17" Foreground="{StaticResource R23CyanBrush}"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                   FontSize="12.5" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding ProviderLabel}" FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}" TextTrimming="CharacterEllipsis"
                                     MaxWidth="170"/>
                          <TextBlock Text=" · " FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}"/>
                          <TextBlock Text="{Binding StatusLabel}" FontSize="10.5"
                                     Foreground="{StaticResource R23MutedBrush}"/>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{DynamicResource Home.EmptyShares}" Margin="2,10,0,4"
                       Foreground="{StaticResource R23MutedBrush}" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ConnectionPreview.Count, ElementName=HomeRoot}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>