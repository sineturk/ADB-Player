<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             Unloaded="HomeView_OnUnloaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <StackPanel Margin="20,16,22,24" MaxWidth="1480" HorizontalAlignment="Stretch">
      <!-- Cinematic artwork is loaded from an optional text-free JPEG; WPF gradient remains fallback. -->
      <Border x:Name="HomeHero" Height="258" Style="{StaticResource R23HeroPanel}">
        <Grid>
          <!-- Local cinematic artwork, when present, is always darkened for readable UI copy. -->
          <Border IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#F205080D" Offset="0"/>
                <GradientStop Color="#D605080D" Offset="0.40"/>
                <GradientStop Color="#8A07101A" Offset="0.72"/>
                <GradientStop Color="#3305080D" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Grid HorizontalAlignment="Right" VerticalAlignment="Center"
                Width="410" Height="238" Margin="0,0,32,0"
                IsHitTestVisible="False">
            <Ellipse Style="{StaticResource R24HeroArtworkRing}" Width="220" Height="220"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Ellipse Style="{StaticResource R24HeroArtworkRing}" Width="316" Height="316"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-64,0"
                     Opacity=".20"/>
            <Image Source="/ADB.Player;component/Assets/app_icon.png"
                   Width="132" Height="132" Stretch="Uniform"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,62,0" Opacity=".55"/>
          </Grid>
          <Grid Margin="34,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.25*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" MaxWidth="610" HorizontalAlignment="Left">
              <TextBlock Text="{DynamicResource R23.Home.Kicker}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{StaticResource R23CyanBrush}"/>
              <TextBlock Text="{DynamicResource R23.Home.Headline}" FontSize="35"
                         FontFamily="Segoe UI Variable Display, Segoe UI"
                         FontWeight="SemiBold" LineHeight="39" MaxWidth="555"
                         Foreground="{StaticResource R23TextBrush}"
                         TextWrapping="Wrap" Margin="0,5,0,8"/>
              <TextBlock Text="{DynamicResource R23.Home.Description}" FontSize="14"
                         Foreground="{StaticResource R23MutedBrush}" MaxWidth="530" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Style="{StaticResource R23PrimaryButton}" MinWidth="150" Margin="0,0,10,0"
                        Command="{Binding OpenFileCommand}" Content="{DynamicResource Action.OpenFile}"/>
                <Button Style="{StaticResource R23Button}" MinWidth="150"
                        Command="{Binding OpenUrlCommand}" Content="{DynamicResource Action.OpenUrl}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid Margin="0,18,0,9">
        <TextBlock Style="{StaticResource R23SectionHeading}"
                   Text="{DynamicResource Home.ContinueWatching}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource R23RailNavButton}"
                  Margin="0,0,6,0"
                  Content="&#x2039;" Click="ResumePrevious_Click"
                  ToolTip="{DynamicResource R23.Home.Previous}"
                  AutomationProperties.Name="{DynamicResource R23.Home.Previous}"/>
          <Button Style="{StaticResource R23RailNavButton}"
                  Margin="0,0,10,0"
                  Content="&#x203A;" Click="ResumeNext_Click"
                  ToolTip="{DynamicResource R23.Home.Next}"
                  AutomationProperties.Name="{DynamicResource R23.Home.Next}"/>
          <Button Style="{StaticResource R23ToolbarButton}"
                  Content="{DynamicResource R23.Home.ViewHistory}"
                  Click="OpenHistory_Click" MinHeight="30" Padding="10,4"/>
        </StackPanel>
      </Grid>
      <Grid>
        <ScrollViewer x:Name="ResumeScroll" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Hidden" PanningMode="HorizontalOnly"
                      CanContentScroll="False" PreviewMouseWheel="ResumeScroll_OnPreviewMouseWheel">
          <ItemsControl ItemsSource="{Binding ContinueWatching}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="188" Height="260" Margin="0,0,11,0" Padding="0"
                        Click="Resume_Click" Style="{StaticResource R23MediaCardButton}"
                        ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                  <Border Width="184" Height="256"
                          Background="{StaticResource R23CardBrush}"
                          CornerRadius="14"
                          BorderBrush="{StaticResource R23StrokeBrush}"
                          BorderThickness="1">
                    <Grid ClipToBounds="True">
                      <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#1D344A" Offset="0"/>
                          <GradientStop Color="#09121D" Offset="1"/>
                        </LinearGradientBrush>
                      </Grid.Background>

                      <Image Source="{Binding ArtworkUrl}"
                             Stretch="UniformToFill"
                             SnapsToDevicePixels="True">
                        <Image.Style>
                          <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ArtworkUrl}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Image.Style>
                      </Image>

                      <TextBlock Text="&#xE768;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="52"
                                 Opacity=".25"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ArtworkUrl}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <Border Width="40" Height="40"
                              CornerRadius="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="#B008111A"
                              BorderBrush="#7047CFF4"
                              BorderThickness="1">
                        <TextBlock Text="&#xE768;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="19"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </Border>

                      <Border VerticalAlignment="Bottom"
                              Background="#EE070D14"
                              Padding="12,10,12,10">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}"
                                     TextTrimming="CharacterEllipsis"
                                     FontSize="13.5"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource R23TextBrush}"/>
                          <TextBlock Text="{Binding ProgressText}"
                                     Margin="0,3,0,6"
                                     FontSize="11.5"
                                     Foreground="{StaticResource R23MutedBrush}"/>
                          <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                       Maximum="100"
                                       Height="4"
                                       Margin="0,1,0,0"
                                       Foreground="{StaticResource R23CyanBrush}"
                                       Background="#28516D"
                                       BorderThickness="0"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{DynamicResource Home.ContinueWatching.Empty}" Margin="9">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource R23SecondaryText}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ContinueWatching.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <TextBlock Style="{StaticResource R23SectionHeading}" Margin="0,16,0,9"
                 Text="{DynamicResource R23.Home.QuickActions}"/>
      <UniformGrid Columns="5">
        <Button Style="{StaticResource R24QuickActionButton}" Width="Auto" Margin="0,0,8,8"
                Command="{Binding OpenFileCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource R23.Home.LocalFiles}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R24QuickActionButton}" Width="Auto" Margin="0,0,8,8"
                Click="OpenSources_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Home.CloudAccounts}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R24QuickActionButton}" Width="Auto" Margin="0,0,8,8"
                Click="ToggleWebLink_Click"
                ToolTip="{DynamicResource R23.Home.WebHint}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Panel.WebLink}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R24QuickActionButton}" Width="Auto" Margin="0,0,8,8"
                Command="{Binding ShowTorrentCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Tab.Torrent}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource R24QuickActionButton}" Width="Auto" Margin="0,0,8,8"
                Command="{Binding ShowTelegramCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE122;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{StaticResource R23CyanBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{DynamicResource Tab.Telegram}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </UniformGrid>

      <Border x:Name="WebLinkPanel"
              Style="{StaticResource R23Panel}"
              Margin="0,12,0,13"
              Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource Panel.WebLink}" Style="{StaticResource R23SectionHeading}"/>
              <TextBlock Text="{DynamicResource R23.Home.WebHint}"
                         Style="{StaticResource R23SecondaryText}" Margin="0,3,0,10"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource R23ToolbarButton}"
                    Content="✕"
                    Click="CloseWebLink_Click"
                    Padding="10,4"
                    MinHeight="30"
                    ToolTip="{DynamicResource Action.Close}"
                    AutomationProperties.Name="{DynamicResource Action.Close}"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="WebLinkUrlBox"
                     MinHeight="42"
                     Margin="0,0,10,0"
                     Text="{Binding Sources.PublicLinkUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Tooltip.PublicLink}"
                     AutomationProperties.Name="{DynamicResource Panel.WebLink}"/>
            <Button Grid.Column="1" MinWidth="160" Style="{StaticResource R23PrimaryButton}"
                    Content="{DynamicResource Action.ResolvePlay}"
                    Command="{Binding Sources.OpenPublicLinkCommand}"/>
          </Grid>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource R24HomeDataPanel}" MinHeight="163">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource R23SectionHeading}" Text="{DynamicResource Home.CloudAccounts}"/>
              <Button HorizontalAlignment="Right" Style="{StaticResource R24MiniManageButton}"
                      Content="{DynamicResource R23.Home.Manage}"
                      Click="OpenSources_Click"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Sources.CloudAccounts}" Margin="0,9,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource R24SourceTileButton}"
                          Margin="0,0,9,9" Click="OpenCloud_Click"
                          ToolTip="{Binding DisplayName}">
                    <StackPanel>
                      <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="19" Foreground="{StaticResource R23CyanBrush}"/>
                      <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" MaxWidth="153"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource R24HomeDataPanel}" MinHeight="163">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource R23SectionHeading}" Text="{DynamicResource Home.SharedLinks}"/>
              <Button HorizontalAlignment="Right" Style="{StaticResource R24MiniManageButton}"
                      Content="{DynamicResource R23.Home.Manage}"
                      Click="OpenSources_Click"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Sources.SavedPublicLinks}" Margin="0,9,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource R24LinkRowButton}" HorizontalAlignment="Stretch"
                          Margin="0,0,0,6" Click="OpenLink_Click"
                          ToolTip="{Binding Name}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Sources.WebDavProfiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource R24LinkRowButton}" HorizontalAlignment="Stretch"
                          Margin="0,0,0,6" Click="OpenWebDav_Click"
                          ToolTip="{Binding Name}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>