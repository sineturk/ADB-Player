<UserControl x:Class="AltyaziDB.Player.App.Views.Pages.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource R23AppBrush}"
             Foreground="{StaticResource R23TextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="14">
  <Grid Margin="20,18,22,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,17">
      <StackPanel>
        <TextBlock Text="{DynamicResource Tab.History}"
                   Style="{StaticResource R23PageHeading}"/>
        <TextBlock Text="{DynamicResource R23.Page.History.Help}"
                   Style="{StaticResource R23SecondaryText}"
                   Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Style="{StaticResource R23Panel}"
            MaxWidth="1170"
            HorizontalAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource R23.History.Recent}"
                     Style="{StaticResource R23SectionHeading}"/>
          <Border Grid.Column="1"
                  Style="{StaticResource R24StatusPill}"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding HistoryItems.Count}"
                       Foreground="{StaticResource R23CyanBrush}"
                       FontWeight="SemiBold"/>
          </Border>
        </Grid>

        <ListBox x:Name="HistoryList"
                 Grid.Row="1"
                 Margin="0,12,0,8"
                 ItemsSource="{Binding HistoryItems}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="History_OnDoubleClick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Margin" Value="0,0,0,9"/>
              <Setter Property="Padding" Value="0"/>
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border MinHeight="112"
                      Padding="8"
                      Background="{StaticResource R23RaisedBrush}"
                      BorderBrush="{StaticResource R23StrokeBrush}"
                      BorderThickness="1"
                      CornerRadius="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <Border Width="68"
                          Height="96"
                          CornerRadius="8"
                          Background="#132436"
                          ClipToBounds="True"
                          VerticalAlignment="Center">
                    <Grid>
                      <Image Source="{Binding ArtworkUrl}"
                             Stretch="UniformToFill"
                             SnapsToDevicePixels="True">
                        <Image.Style>
                          <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ArtworkUrl}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Image.Style>
                      </Image>

                      <TextBlock Text="&#xE81C;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="22"
                                 Foreground="{StaticResource R23CyanBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ArtworkUrl}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="2"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource R23TextBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding LastOpenedText}"
                               FontSize="12"
                               Foreground="{StaticResource R23MutedBrush}"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{DynamicResource R23.History.OpenHint}"
                               FontSize="12"
                               Foreground="{StaticResource R23MutedBrush}"
                               Margin="0,3,0,0"/>
                  </StackPanel>

                  <Border Grid.Column="3"
                          Width="38"
                          Height="38"
                          CornerRadius="19"
                          Background="#132436"
                          BorderBrush="#3049CFF5"
                          BorderThickness="1"
                          VerticalAlignment="Center"
                          Margin="14,0,4,0">
                    <TextBlock Text="&#xE768;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{StaticResource R23CyanBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                HorizontalAlignment="Right"
                Style="{StaticResource R23PrimaryButton}"
                Content="{DynamicResource Action.Play}"
                Click="History_PlayClick"
                MinWidth="156"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
