<Window x:Class="AltyaziDB.Player.App.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        MinWidth="440"
        MaxWidth="620"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Border Background="{StaticResource WindowBrush}"
          BorderBrush="#2B536B"
          BorderThickness="1"
          CornerRadius="18"
          Padding="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28"
                        ShadowDepth="8"
                        Opacity="0.42"
                        Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar"
            Height="58"
            Background="#0A1520"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Width="34"
                Height="34"
                Margin="16,0,10,0"
                CornerRadius="10"
                Background="#112A3A"
                BorderBrush="#285B73"
                BorderThickness="1"
                VerticalAlignment="Center">
          <TextBlock Text="▶"
                     Foreground="{StaticResource BrandBrush}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="ADB Player"
                     FontSize="11.5"
                     Foreground="{StaticResource MutedTextBrush}"/>
          <TextBlock x:Name="TitleText"
                     Margin="0,1,0,0"
                     FontSize="15.5"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Button Grid.Column="2"
                Width="38"
                Height="38"
                MinWidth="38"
                Margin="0,0,10,0"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                ToolTip="{DynamicResource Action.Close}"
                Click="CloseButton_OnClick">
          <TextBlock Text="&#xE711;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="13"
                     Foreground="{StaticResource MutedTextBrush}"/>
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="22,22,22,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="KindBadge"
                Width="50"
                Height="50"
                CornerRadius="15"
                Background="#26171A"
                BorderBrush="#70404A"
                BorderThickness="1"
                VerticalAlignment="Top">
          <TextBlock x:Name="KindIcon"
                     Text="!"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#FF9AA0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,1,0,0">
          <TextBlock x:Name="HeadingText"
                     FontSize="21"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="MessageText"
                     Margin="0,8,0,0"
                     Foreground="{StaticResource MutedTextBrush}"
                     FontSize="13.5"
                     LineHeight="21"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="22,14,22,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="HintText"
                   VerticalAlignment="Center"
                   Foreground="#6F8798"
                   FontSize="11.5"
                   Text="ADB Player"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button x:Name="CancelButton"
                  MinWidth="104"
                  Content="Vazgeç"
                  Visibility="Collapsed"
                  IsCancel="True"
                  Click="CancelButton_OnClick"/>
          <Button x:Name="PrimaryButton"
                  MinWidth="104"
                  Margin="8,3,3,3"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Content="Tamam"
                  IsDefault="True"
                  Click="PrimaryButton_OnClick"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
