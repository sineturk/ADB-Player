<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- R2.3 is a new visual system; legacy player templates remain isolated. -->
  <Color x:Key="R23AppColor">#05080D</Color>
  <Color x:Key="R23SidebarColor">#070D15</Color>
  <Color x:Key="R23SurfaceColor">#0A111B</Color>
  <Color x:Key="R23CardColor">#0E1723</Color>
  <Color x:Key="R23RaisedColor">#152131</Color>
  <Color x:Key="R23StrokeColor">#223044</Color>
  <Color x:Key="R23AccentColor">#19B8F4</Color>
  <Color x:Key="R23CyanColor">#37D6FF</Color>
  <Color x:Key="R23TextColor">#F7FAFC</Color>
  <Color x:Key="R23MutedColor">#91A2B6</Color>

  <SolidColorBrush x:Key="R23AppBrush" Color="{StaticResource R23AppColor}"/>
  <SolidColorBrush x:Key="R23SidebarBrush" Color="{StaticResource R23SidebarColor}"/>
  <SolidColorBrush x:Key="R23SurfaceBrush" Color="{StaticResource R23SurfaceColor}"/>
  <SolidColorBrush x:Key="R23CardBrush" Color="{StaticResource R23CardColor}"/>
  <SolidColorBrush x:Key="R23RaisedBrush" Color="{StaticResource R23RaisedColor}"/>
  <SolidColorBrush x:Key="R23StrokeBrush" Color="{StaticResource R23StrokeColor}"/>
  <SolidColorBrush x:Key="R23AccentBrush" Color="{StaticResource R23AccentColor}"/>
  <SolidColorBrush x:Key="R23CyanBrush" Color="{StaticResource R23CyanColor}"/>
  <SolidColorBrush x:Key="R23TextBrush" Color="{StaticResource R23TextColor}"/>
  <SolidColorBrush x:Key="R23MutedBrush" Color="{StaticResource R23MutedColor}"/>

  <LinearGradientBrush x:Key="R23NavSelectedBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#172636" Offset="0"/>
    <GradientStop Color="#101925" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="R23PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#19B8F4" Offset="0"/>
    <GradientStop Color="#0B78D0" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="R23HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0B1827" Offset="0"/>
    <GradientStop Color="#10263F" Offset="0.52"/>
    <GradientStop Color="#05080D" Offset="1"/>
  </LinearGradientBrush>

  <Style x:Key="R23PageHeading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource R23TextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="R23SectionHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource R23TextBrush}"/>
  </Style>
  <Style x:Key="R23SecondaryText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource R23MutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="R23Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource R23SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource R23StrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="18"/>
  </Style>
  <Style x:Key="R23Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource R23CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource R23StrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="12"/>
  </Style>

  <Style x:Key="R23Button" TargetType="Button">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="15,8"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource R23TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource R23CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource R23StrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{StaticResource R23RaisedBrush}"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#35465A"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="#3A6078"/>
              <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".46"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="R23PrimaryButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="Background" Value="{StaticResource R23PrimaryGradientBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource R23TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource R23CyanBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#159DD5"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#E3FAFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".44"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="R23NavButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="MinHeight" Value="46"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
            <Border x:Name="HoverAccent"
                    Width="2" Height="20" CornerRadius="1"
                    Background="{StaticResource R23CyanBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="1,0,0,0" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#111D2A"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#1C3245"/>
              <Setter TargetName="HoverAccent" Property="Opacity" Value=".68"/>
              <Setter Property="Foreground" Value="#EDF9FD"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource R23CyanBrush}"/>
              <Setter TargetName="HoverAccent" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="R23NavSelectedButton" TargetType="Button" BasedOn="{StaticResource R23NavButton}">
    <Setter Property="Background" Value="{StaticResource R23NavSelectedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource R23TextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderBrush" Value="#2A4A60"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="AccentBar" Width="3" Height="22" CornerRadius="2"
                    Background="{StaticResource R23CyanBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#182A3B"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#3A5970"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource R23CyanBrush}"/>
              <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Opt-in only inside the R2.3 shell: preserve legacy player control templates. -->
  <Style x:Key="R23ScrollbarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="ThumbSurface" Background="#243544" CornerRadius="3" Margin="1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbSurface" Property="Background" Value="#35627A"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbSurface" Property="Background" Value="{StaticResource R23CyanBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="R23ScrollbarPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="R23SlimScrollBar" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="5"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="PageDecrease" Focusable="False"
                              Style="{StaticResource R23ScrollbarPageButton}"
                              Command="{x:Static ScrollBar.PageUpCommand}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource R23ScrollbarThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="PageIncrease" Focusable="False"
                              Style="{StaticResource R23ScrollbarPageButton}"
                              Command="{x:Static ScrollBar.PageDownCommand}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
              <Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Width" Value="Auto"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- R2.4 Midnight Cinema: opt-in composition primitives. -->
  <SolidColorBrush x:Key="R24ToolbarBrush" Color="#EB080F18"/>
  <SolidColorBrush x:Key="R24ToolbarHoverBrush" Color="#162433"/>
  <SolidColorBrush x:Key="R24SoftStrokeBrush" Color="#22364A"/>

  <Style x:Key="R23Toolbar" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource R24ToolbarBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource R24SoftStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="3"/>
  </Style>

  <Style x:Key="R23ToolbarButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="11,6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <Style x:Key="R23ToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource R23PrimaryButton}">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>

  <Style x:Key="R23RailNavButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Background" Value="#101A27"/>
  </Style>

  <Style x:Key="R23HeroPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource R23HeroBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource R24SoftStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style x:Key="R23MediaCardButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <Style x:Key="R23QuietCard" TargetType="Border">
    <Setter Property="Background" Value="#B30E1723"/>
    <Setter Property="BorderBrush" Value="#1C2B3B"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="14"/>
  </Style>


  <!-- R2.4 Rev2: quieter utility-workspace surfaces. -->
  <Style x:Key="R24WorkspacePanel" TargetType="Border">
    <Setter Property="Background" Value="#A60A111B"/>
    <Setter Property="BorderBrush" Value="#19283A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="14"/>
  </Style>

  <Style x:Key="R24InsetPanel" TargetType="Border">
    <Setter Property="Background" Value="#0C141F"/>
    <Setter Property="BorderBrush" Value="#1A293A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="12"/>
  </Style>

  <Style x:Key="R24CommandDeck" TargetType="Border">
    <Setter Property="Background" Value="#D9070D15"/>
    <Setter Property="BorderBrush" Value="#223044"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="5"/>
  </Style>

  <Style x:Key="R24SectionRule" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="#1A293A"/>
    <Setter Property="Margin" Value="0,12,0,12"/>
  </Style>

  <Style x:Key="R24StatusPill" TargetType="Border">
    <Setter Property="Background" Value="#101B28"/>
    <Setter Property="BorderBrush" Value="#26384B"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="9,5"/>
  </Style>


  <!-- R2.4 Rev3: visual calibration after Windows runtime screenshots. -->
  <Style x:Key="R24QuickActionButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="Width" Value="168"/>
    <Setter Property="Height" Value="54"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Background" Value="#09131E"/>
    <Setter Property="BorderBrush" Value="#1C3043"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- R2.4 Rev10: final Home / Shell visual calibration. -->
  <Style x:Key="R24HomeDataPanel" TargetType="Border" BasedOn="{StaticResource R23Panel}">
    <Setter Property="Background" Value="#0A131D"/>
    <Setter Property="BorderBrush" Value="#1B3042"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style x:Key="R24MiniManageButton" TargetType="Button" BasedOn="{StaticResource R23ToolbarButton}">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Background" Value="#101A27"/>
    <Setter Property="BorderBrush" Value="#213447"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="R24SourceTileButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="Width" Value="175"/>
    <Setter Property="Height" Value="72"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="Background" Value="#0C1622"/>
    <Setter Property="BorderBrush" Value="#1C3044"/>
  </Style>

  <Style x:Key="R24LinkRowButton" TargetType="Button" BasedOn="{StaticResource R23Button}">
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Background" Value="#0B141F"/>
    <Setter Property="BorderBrush" Value="#1A2D40"/>
  </Style>

  <Style x:Key="R24EmptyIcon" TargetType="Border">
    <Setter Property="Width" Value="56"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="CornerRadius" Value="28"/>
    <Setter Property="Background" Value="#132132"/>
    <Setter Property="BorderBrush" Value="#20384D"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="R24HeroArtworkRing" TargetType="Ellipse">
    <Setter Property="Stroke" Value="#3A6A86"/>
    <Setter Property="StrokeThickness" Value="1"/>
    <Setter Property="Opacity" Value=".38"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>


  <Style x:Key="R5GlassWorkspacePanel" TargetType="Border" BasedOn="{StaticResource R24WorkspacePanel}">
    <Setter Property="Background" Value="#E30D1826"/>
    <Setter Property="BorderBrush" Value="#2C475E"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- R5/P3: scoped cinematic glass surfaces; legacy player/HUD styles stay unchanged. -->
  <Style x:Key="R5GlassHeroPanel" TargetType="Border" BasedOn="{StaticResource R23HeroPanel}">
    <Setter Property="BorderBrush" Value="#3C52718A"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="R5GlassHomePanel" TargetType="Border" BasedOn="{StaticResource R24HomeDataPanel}">
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#EE122134" Offset="0"/>
          <GradientStop Color="#F60A141F" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="#2E4960"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="R5GlassMediaCardButton" TargetType="Button" BasedOn="{StaticResource R23MediaCardButton}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="GlowFrame" Background="Transparent"
                    BorderBrush="#325577" BorderThickness="1" CornerRadius="13"/>
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="GlowFrame" Property="BorderBrush" Value="#8D37D6FF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="GlowFrame" Property="BorderBrush" Value="#F1E3FAFF"/>
              <Setter TargetName="GlowFrame" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".52"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Always stretch the Grid children: the legacy R23Button template centers content. -->
  <Style x:Key="R5GlassSourceButton" TargetType="Button" BasedOn="{StaticResource R24LinkRowButton}">
    <Setter Property="MinHeight" Value="53"/>
    <Setter Property="Padding" Value="11,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="BorderBrush" Value="#344A63"/>
    <Setter Property="Background" Value="#C10C1A2B"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="10"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#1A3043"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#578EB0"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="#E3FAFF"/>
              <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value=".5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="R5GlassQuickButton" TargetType="Button" BasedOn="{StaticResource R5GlassSourceButton}">
    <Setter Property="MinHeight" Value="49"/>
    <Setter Property="Height" Value="49"/>
    <Setter Property="Padding" Value="11,6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#B00E1B2B"/>
    <Setter Property="BorderBrush" Value="#2B455C"/>
  </Style>

  <!-- R5/P3.2: Android-inspired provider cards, scoped to Sources only. -->
  <Style x:Key="R5ProviderCard" TargetType="Button" BasedOn="{StaticResource R5GlassSourceButton}">
    <Setter Property="MinHeight" Value="115"/>
    <Setter Property="Padding" Value="15,12"/>
    <Setter Property="Margin" Value="5"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#142638"/>
    <Setter Property="BorderBrush" Value="#31536B"/>
  </Style>
  <!-- R5/P4.16.7: standalone rounded source segments.
       Native TabPanel intentionally overlaps the content seam by a few pixels;
       that clips the bottom strokes even with extra margins. A horizontal
       items-host StackPanel avoids overlap while preserving TabItem selection. -->
  <Style x:Key="R5SourcesTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource R23MutedBrush}"/>
    <Setter Property="Margin" Value="0,0,5,0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface"
                  Background="#13283E" BorderBrush="#31536B"
                  BorderThickness="1" CornerRadius="9"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="Background" Value="#164567"/>
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="#27C4F3"/>
              <Setter TargetName="TabSurface" Property="BorderThickness" Value="1.5"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="#6DB8D3"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="#E3FAFF"/>
              <Setter TargetName="TabSurface" Property="BorderThickness" Value="2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="R5SourcesTabControl" TargetType="TabControl">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource R5SourcesTabItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#0B1828" BorderBrush="#28465E" BorderThickness="1"
                    CornerRadius="12" Padding="5" Margin="2,2,0,7"
                    SnapsToDevicePixels="True">
              <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
            </Border>
            <Border Grid.Row="1" Background="Transparent" Padding="2,7,2,0">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

